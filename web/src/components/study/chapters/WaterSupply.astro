---
/**
 * Study §II — Water supply & consumptive use (the missing-impact-study epic, PR2). The
 * chapter-template setter: a narrative-first section over the SAME feeds the hydrology
 * annex renders (`hydrology-scenarios` + `facility`) — never a fork of its numbers.
 *
 * Register discipline, by verdict:
 *  - data     — the worst-case modeled draw against the cited 7Q10 (bullet), then each
 *               scenario's compact figure strip. Draw = [inference], floor = [verified].
 *  - partial  — an undisclosed cooling method renders the bracketed envelope AS the
 *               finding (#1057's discipline, on the surface built to carry it) — never a
 *               single fabricated headline.
 *  - gap      — the section still states what IS on the record (the facility's cooling
 *               posture: not disclosed [open], or an operator claim [reference] — "a claim
 *               is not an instrument"); the shell's gap panels carry the asks.
 *  - na       — delegated to the generic watch-state panel.
 *
 * Site-generic by construction: river names and figures come from the feed; the site's
 * narrative texture (e.g. Lima's off-stream reservoirs) belongs to the annex page and the
 * per-site MDX slot, not here.
 */
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import { buildCoolingReconciliation, RECONCILE_OUTCOME_META } from "@watermark/core/coolingReconciliation";
import type { CoolingModel, ProvenancedValue, ScenarioResult } from "@watermark/core/feeds";
import { fmtRanged } from "@watermark/core/format";
import { withSite } from "@watermark/core/site";
import {
  COOLING_MODEL_LABELS,
  resolveStudyFacility,
  type StudyChapterDef,
  type StudyChapterModel,
} from "@watermark/core/study";
import type { FigureStatData } from "@watermark/core/viz";
import EvidenceTag from "~/components/EvidenceTag.astro";
import FigureStat from "~/components/FigureStat.astro";
import BulletChart from "~/components/charts/BulletChart.astro";
import DefaultChapterSection from "./DefaultChapterSection.astro";

interface Props {
  def: StudyChapterDef;
  model: StudyChapterModel;
  slug: string;
}
const { def, model, slug } = Astro.props as Props;

const facility = resolveStudyFacility(slug);
const scenarios =
  model.status === "na" || !hasFeed("hydrology-scenarios", slug)
    ? []
    : loadFeed<ScenarioResult[]>("hydrology-scenarios", slug);

// Two decimals: a 0.2 cfs design low flow must never round to "0 cfs" in prose.
const fmt = (v: ProvenancedValue): string => fmtRanged(v, 2);
const grounded = (v: ProvenancedValue): boolean =>
  v.source === "document" || v.source === "connector" || v.source === "reference";
// The scenario strips render `size="sm"`, which carries no unit slot — `fmtRanged` folds the
// unit inline AND keeps the #760 uncertainty-band notation ("4.85 (3.1–6.2 MGD)") that a bare
// toLocaleString would silently drop.
const toStat = (label: string, v: ProvenancedValue): FigureStatData => ({
  label,
  value: fmtRanged(v, 2),
  evidence: grounded(v) ? "verified" : "inference",
  basis: grounded(v) ? "grounded" : "modeled",
  sub: v.citation ?? v.source ?? undefined,
});

const coolingOf = (s: ScenarioResult): CoolingModel | null =>
  s.cooling_model ?? s.scenario.cooling_model ?? null;
const bracketed = (s: ScenarioResult): boolean =>
  coolingOf(s) === "unknown" || s.scenario.basis?.is_bracketed === true;

// The headline screen: worst NON-bracketed scenario by modeled draw vs the cited 7Q10 —
// the same pick the hydrology annex makes, so the two surfaces can never disagree.
const candidates = scenarios.filter((s) => !bracketed(s));
const worst =
  candidates.length > 0
    ? candidates.reduce((a, b) => ((b.consumptive_loss.value ?? 0) > (a.consumptive_loss.value ?? 0) ? b : a))
    : null;
const drawV = worst?.consumptive_loss ?? null;
const lowV = worst?.receiving_7q10 ?? null;
const riverName = scenarios.map((s) => s.receiving_water_name).find(Boolean) ?? "the receiving water";
const showScreen = worst != null && (drawV?.value ?? 0) > 0 && (lowV?.value ?? 0) > 0;
const drawRatio = showScreen ? Math.round((drawV!.value as number) / (lowV!.value as number)) : 0;

// The facility's cooling posture — the one line this chapter always states when a project
// is on the record, whatever the verdict. The register tracks the SOURCE, never the claim:
// document/connector ⇒ [verified]; reference ⇒ an operator claim; assumption ⇒ [inference].
// The claim-vs-record reconciliation (#1805) — the site's own row(s) of the committed
// cooling-cycling account, shipped on the `cooling-reconciliation` feed. Null outside the
// cohort; the block simply doesn't render. The feed's caveats are the harness's discipline
// rules and MUST render with it.
const recon = buildCoolingReconciliation(slug);
// The claim's register tracks its SOURCE (the same mapping the cooling-posture line uses):
// document/connector ⇒ verified; reference ⇒ an operator claim; the rest ⇒ inference.
const claimTagOf = (source: string): "verified" | "reference" | "inference" =>
  source === "document" || source === "connector"
    ? "verified"
    : source === "reference"
      ? "reference"
      : "inference";

const cooling = facility?.cooling_model ?? null;
const coolingEvidence =
  cooling === "unknown"
    ? ("open" as const)
    : facility?.cooling_model_source === "document" || facility?.cooling_model_source === "connector"
      ? ("verified" as const)
      : facility?.cooling_model_source === "reference"
        ? ("reference" as const)
        : ("inference" as const);
const facilityName = facility?.name ?? "the proposed facility";
---

{
  model.status === "na" ? (
    <DefaultChapterSection def={def} model={model} slug={slug} />
  ) : (
    <>
      <p class="wsup-lead">
        A real impact study states how much water {facilityName} consumes at buildout and sets
        it against the {riverName}'s own cited design low flows — the drought floor discharge
        permits are written at. This chapter reports exactly as much of that as the record
        supports, and names what it cannot compute.
      </p>

      {cooling !== null && (
        <p class="wsup-cooling">
          <span class="wsup-cooling-label">Cooling method</span>
          <strong>{cooling === "unknown" ? "not disclosed" : COOLING_MODEL_LABELS[cooling]}</strong>
          <EvidenceTag kind={coolingEvidence} />
          {coolingEvidence === "reference" && (
            <span class="wsup-cooling-note">an operator claim — a claim is not an instrument</span>
          )}
          {cooling === "unknown" && (
            <span class="wsup-cooling-note">
              a facility is on the record here; no record says how it rejects heat
            </span>
          )}
        </p>
      )}

      {recon !== null && (
        <section class="wsrec">
          <p class="wsrec-kicker">Claim vs record · the cooling-cycling reconciliation</p>
          {recon.candidates.map((r) => {
            const meta = RECONCILE_OUTCOME_META[r.outcome];
            // The provenance slots render ONLY when their record exists, each under its own
            // register label — a renderer must keep them apart (the carried discipline).
            const slots = [
              { label: "Documented makeup · metered/record", v: r.account.documented_makeup },
              { label: "Documented blowdown · metered/record", v: r.account.documented_blowdown },
              { label: "Reservation ceiling · makeup — not an instrument", v: r.account.reserved_makeup },
              { label: "Reservation ceiling · blowdown — not an instrument", v: r.account.reserved_blowdown },
              { label: "Operator self-report · ongoing draw", v: r.account.disclosed_makeup },
              { label: "Self-disclosed permit ceiling", v: r.account.disclosed_ceiling },
              { label: "On record but NOT the cooling account", v: r.account.nonprocess_makeup },
              { label: "Supplying system's own withdrawal · the denominator", v: r.account.supplier_withdrawal },
              { label: "Self-disclosed cycles of concentration", v: r.account.disclosed_cycles },
              { label: "Back-solved cycles of concentration · bracket", v: r.account.backsolved_cycles },
            ].filter((s) => s.v != null);
            // The predicted account is refusable (#1686): the three figures move together, so
            // either all three render or the refusal reason does. Never a substituted zero.
            const predicted = [
              { label: "Predicted makeup", v: r.account.predicted_makeup },
              { label: "Predicted consumptive", v: r.account.predicted_consumptive },
              { label: "Predicted blowdown", v: r.account.predicted_blowdown },
            ].filter((s) => s.v != null);
            return (
              <article class="wsrec-row">
                <p class="wsrec-claim">
                  {r.facility} claims{" "}
                  <strong>{COOLING_MODEL_LABELS[r.claimed_archetype]}</strong>
                  <EvidenceTag kind={claimTagOf(r.claim_source)} />
                  <span class:list={["wsrec-outcome", `is-${r.outcome}`]} title={meta.gloss}>
                    {meta.label}
                  </span>
                  {r.kept_archetype && (
                    <span class="wsrec-kept">
                      pin kept: {COOLING_MODEL_LABELS[r.kept_archetype]}
                    </span>
                  )}
                </p>
                <p class="wsrec-finding">{r.finding}</p>
                {r.account.route && (
                  <p class="wsrec-route">
                    <span class="wsrec-route-label">Instrument reach</span>
                    <span class="wsrec-route-body">{r.account.route.citation}</span>
                  </p>
                )}
                {r.account.prediction_refused && (
                  <p class="wsrec-refused">
                    <span class="wsrec-refused-label">Prediction refused <EvidenceTag kind="open" /></span>
                    <span class="wsrec-refused-body">{r.account.prediction_refused}</span>
                  </p>
                )}
                <div class="wsrec-stats">
                  {predicted.map((s) => (
                    <FigureStat stat={toStat(s.label, s.v!)} size="sm" />
                  ))}
                  {slots.map((s) => (
                    <FigureStat stat={toStat(s.label, s.v!)} size="sm" />
                  ))}
                </div>
                {r.lead && (
                  <div class="wsrec-lead">
                    <p class="wsrec-lead-head">
                      The records that would test it <EvidenceTag kind="open" />
                    </p>
                    <ul class="wsrec-lead-list">
                      {r.lead.records_sought.map((rec) => (
                        <li>{rec}</li>
                      ))}
                    </ul>
                    <p class="wsrec-lead-holder">Holder: {r.lead.holder}</p>
                  </div>
                )}
                {r.corroborators && (
                  <p class="wsrec-corr">
                    <span class="wsrec-corr-label">Corroborators · secondary, never the outcome</span>
                    <span class="wsrec-corr-chips">
                      air permit · {r.corroborators.air_permit.stance} &middot; Tier II chemistry ·{" "}
                      {r.corroborators.tier2_chemistry.stance}
                    </span>
                    <span class="wsrec-corr-sum">{r.corroborators.summary}</span>
                  </p>
                )}
                <p class="wsrec-cite">{r.claim_citation}</p>
              </article>
            );
          })}
          <ul class="wsrec-caveats">
            {recon.caveats.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
          <p class="wsrec-src">
            {recon.source} · reconciled as of {recon.asof}
          </p>
        </section>
      )}

      {showScreen && drawV && lowV && worst && (
        <BulletChart
          kicker="The headline screen · draw vs design low flow"
          title={`At the 7Q10 design low flow, the ${worst.scenario.name} cooling draw is ~${drawRatio}× the ${riverName}`}
          scaleLabel="scale · cubic feet per second"
          unit="cfs"
          rows={[
            {
              label: `Consumptive draw · ${worst.scenario.name}`,
              value: drawV.value as number,
              fill: "#9a6a14",
              evidence: grounded(drawV) ? "verified" : "inference",
              evidenceNote: drawV.citation ?? drawV.source ?? undefined,
            },
            {
              label: `${riverName} 7Q10 design low flow`,
              value: lowV.value as number,
              evidence: grounded(lowV) ? "verified" : "inference",
              evidenceNote: lowV.citation ?? lowV.source ?? undefined,
            },
          ]}
          note={`The modeled ${worst.scenario.name} draw (${fmt(drawV)}) against the cited 7Q10 (${fmt(lowV)}) is a basin-scale worst-case bound, not a withdrawal claim — the full derivation, the site's supply arrangement, and the live gauge sit in the hydrology annex below.`}
        />
      )}

      {
        // An undisclosed cooling method renders the bracketed envelope AS the finding —
        // the study's whole reason to exist is carrying this honestly (#1057).
        scenarios.filter(bracketed).map((s) => {
          const basis = s.scenario.basis;
          return (
            <div class="wsup-bracket">
              <p class="wsup-bracket-title">The water figure is a bracket, and that is the finding</p>
              <p>
                No record discloses how {facilityName} rejects heat, so its consumptive water
                figure is a <strong>range across candidate cooling archetypes</strong>
                {basis
                  ? ` — ${fmt(basis.consumptive_low)} (closed-loop dry) to ${fmt(basis.consumptive_high)} (evaporative tower)`
                  : ""}
                — not an estimate. A single headline would fabricate the site's most
                load-bearing number; the bracket stands until the method is on the record.
              </p>
            </div>
          );
        })
      }

      {candidates.map((s) => {
        const river = s.receiving_water_name ?? riverName;
        const stats: FigureStatData[] = [
          toStat("Cooling demand", s.scenario.cooling_demand),
          toStat("Consumptive loss", s.consumptive_loss),
        ];
        if (s.receiving_7q10) stats.push(toStat(`${river} 7Q10`, s.receiving_7q10));
        return (
          <section class="wsup-scenario">
            <h2>{s.scenario.name}</h2>
            {s.scenario.description && <p class="wsup-scenario-dek">{s.scenario.description}</p>}
            <div class="wsup-stats">
              {stats.map((st) => (
                <FigureStat stat={st} size="sm" />
              ))}
            </div>
          </section>
        );
      })}

      {model.caveats.length > 0 && (
        <ul class="wsup-caveats">
          {model.caveats.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      )}

      {model.status === "gap" && scenarios.length === 0 && (
        <p class="wsup-gapline">
          No water-balance scenario exists for this site — the panels below name the records
          that would let this chapter compute one.{" "}
          <a href={withSite("/environment/hydrology")}>The hydrology annex</a> holds whatever
          partial record exists.
        </p>
      )}
    </>
  )
}

<style>
  .wsup-lead {
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 660px;
    margin: 0 0 1.1rem;
  }
  .wsup-cooling {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 10px;
    border: 1px solid var(--bosc-rule);
    background: #efece2;
    padding: 10px 14px;
    margin: 0 0 1.2rem;
    font-size: 0.92rem;
  }
  .wsup-cooling-label {
    font-family: var(--bosc-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--bosc-muted);
  }
  .wsup-cooling-note {
    font-size: 0.8rem;
    color: var(--bosc-muted);
  }
  .wsrec {
    border: 1px solid var(--bosc-rule);
    border-left: 3px solid var(--bosc-ink);
    padding: 16px 20px;
    margin: 0 0 1.4rem;
  }
  .wsrec-kicker {
    font-family: var(--bosc-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--bosc-muted);
    margin: 0 0 0.7rem;
  }
  .wsrec-row + .wsrec-row {
    border-top: 1px solid var(--bosc-rule);
    margin-top: 1rem;
    padding-top: 1rem;
  }
  .wsrec-claim {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 10px;
    font-size: 0.95rem;
    margin: 0;
  }
  /* The outcome chip speaks the facility-status color register (grey/forest/amber) —
     the evidence palette only ever encodes evidence. */
  .wsrec-outcome {
    font-family: var(--bosc-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border: 1px solid var(--bosc-rule);
    padding: 1px 7px;
    color: var(--bosc-muted);
  }
  .wsrec-outcome.is-corroborated {
    color: var(--bosc-forest);
    border-color: var(--bosc-forest);
  }
  .wsrec-outcome.is-discrepancy,
  .wsrec-outcome.is-reservation_conflict {
    color: #9a6a14;
    border-color: #9a6a14;
  }
  /* route_blind is not a finding about the facility, it is a finding about the instruments —
     so it stays in the neutral register rather than borrowing the amber "something is wrong
     here" one. It reads as a stated limit, which is what it is. */
  .wsrec-outcome.is-route_blind {
    color: var(--bosc-muted);
    border-color: var(--bosc-muted);
    border-style: dashed;
  }
  .wsrec-kept {
    font-size: 0.8rem;
    color: var(--bosc-muted);
  }
  .wsrec-finding {
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 660px;
    margin: 0.5rem 0 0;
  }
  /* The reach statement and the refusal must be visible next to the account, never dropped —
     they are the reason the numbers beside them are shaped the way they are. */
  .wsrec-route,
  .wsrec-refused {
    display: block;
    font-size: 0.82rem;
    line-height: 1.5;
    max-width: 660px;
    margin: 0.6rem 0 0;
    padding-left: 0.7rem;
    border-left: 2px solid var(--bosc-rule);
    color: var(--bosc-muted);
  }
  .wsrec-route-label,
  .wsrec-refused-label {
    display: block;
    font-family: var(--bosc-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .wsrec-stats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    margin-top: 0.8rem;
  }
  .wsrec-lead {
    margin-top: 0.9rem;
  }
  .wsrec-lead-head {
    font-weight: 700;
    font-size: 0.9rem;
    margin: 0 0 0.3rem;
  }
  .wsrec-lead-list {
    margin: 0;
    padding-left: 1.1rem;
  }
  .wsrec-lead-list li {
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 2px;
  }
  .wsrec-lead-holder {
    font-size: 0.8rem;
    color: var(--bosc-muted);
    margin: 0.35rem 0 0;
  }
  .wsrec-corr {
    display: block;
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
  }
  .wsrec-corr-label {
    display: block;
    font-family: var(--bosc-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--bosc-muted);
  }
  .wsrec-corr-chips {
    display: block;
    margin-top: 2px;
  }
  .wsrec-corr-sum {
    display: block;
    color: var(--bosc-muted);
    margin-top: 2px;
    max-width: 660px;
  }
  .wsrec-cite {
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--bosc-faint);
    max-width: 660px;
    margin: 0.8rem 0 0;
  }
  .wsrec-caveats {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    border-top: 1px solid var(--bosc-rule);
    padding-top: 0.7rem;
  }
  .wsrec-caveats li {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--bosc-muted);
    margin-bottom: 0.3rem;
  }
  .wsrec-src {
    font-family: var(--bosc-mono);
    font-size: 0.68rem;
    color: var(--bosc-faint);
    margin: 0.6rem 0 0;
  }
  .wsup-bracket {
    border: 1px solid var(--bosc-rule);
    border-left: 3px solid var(--bosc-ink);
    background: var(--bosc-bg);
    padding: 16px 20px;
    margin: 1.2rem 0;
    max-width: 660px;
  }
  .wsup-bracket-title {
    font-weight: 700;
    margin: 0 0 6px;
  }
  .wsup-bracket p {
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }
  .wsup-scenario {
    border-top: 1px solid var(--bosc-rule);
    padding-top: 0.9rem;
    margin-top: 1.4rem;
  }
  .wsup-scenario h2 {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.2px;
    margin: 0;
  }
  .wsup-scenario-dek {
    font-size: 0.85rem;
    color: var(--bosc-muted);
    margin: 0.3rem 0 0;
  }
  .wsup-stats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    margin-top: 0.8rem;
  }
  .wsup-caveats {
    margin: 1.2rem 0 0;
    padding-left: 1.1rem;
  }
  .wsup-caveats li {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--bosc-muted);
    margin-bottom: 0.4rem;
  }
  .wsup-gapline {
    font-size: 0.92rem;
    color: var(--bosc-muted);
    max-width: 660px;
  }
</style>
