---
/**
 * One row in the site switcher (design "Site Selector"). Two implementations of this row used
 * to ship in every document behind a `localStorage` flag; this is the one that won (#1893).
 *
 * A row carries TWO clocks, which is the whole point of it: `acc` is what opens on Watermark
 * (the build phase — a page you can read, a preview, or a request-access lock), and `fac` is the
 * campus's own lifecycle stage on the ground. They move independently — a site can be under
 * construction with nothing but a watch page here, or fully readable while the campus is still
 * an investigation — so the row never collapses them into one status.
 */
import {
  FACILITY_STATUS_META,
  type NetworkSite,
  type SiteStatus,
  facilityStatus,
  siteBadge,
} from "@watermark/core/sites";
import { withBase } from "@watermark/core/site";

interface Props {
  site: NetworkSite;
  activeSlug: string | null;
}
const { site: s, activeSlug } = Astro.props;
const isActive = activeSlug !== null && s.slug === activeSlug;
const locked = Boolean(s.locked);

const ACCESS_META: Record<SiteStatus, { label: string; cls: string }> = {
  live: { label: "Open", cls: "switcher-acc-open" },
  building: { label: "Draft", cls: "switcher-acc-draft" },
  queued: { label: "Queued", cls: "switcher-acc-queued" },
  tracking: { label: "Watching", cls: "switcher-acc-watching" },
};
const acc = ACCESS_META[s.status];

const fac = facilityStatus(s.slug);
const facMeta = FACILITY_STATUS_META[fac];
const FAC_SHORT: Record<string, string> = {
  investigation: "Investigating",
  confirmed: "Confirmed",
  construction: "Under construction",
  live: "Operational",
};
---

<a
  class:list={["switcher-row", { "is-active": isActive, "is-locked": locked }]}
  href={withBase(s.href)}
  aria-current={isActive ? "page" : undefined}
  title={locked ? `${s.place} — restricted` : `${s.place} — ${acc.label}`}
  data-place={s.place}
>
  <span class:list={["switcher-badge", { "has-codename": Boolean(s.codename) }]}>{siteBadge(s)}</span>
  <span class="switcher-body">
    <span class="switcher-place">
      {s.codename && <span class="switcher-codename">{s.codename}</span>}
      <span class="switcher-placename">{s.place}</span>
    </span>
    <span class="switcher-basin">{s.basin}</span>
  </span>
  <span class="switcher-meta">
    {locked ? (
      <span class="switcher-acc switcher-acc-locked">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="5" y="11" width="14" height="9" rx="1"/>
          <path d="M8 11 V7.5 A4 4 0 0 1 16 7.5 V11"/>
        </svg>
        Request access
      </span>
    ) : (
      <span class:list={["switcher-acc", acc.cls]}>
        {acc.label}<span aria-hidden="true" class="switcher-acc-arrow">→</span>
      </span>
    )}
    <span class="switcher-campus">
      <span class="switcher-facility" style={`color:${facMeta.color}`}>
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="4.5" width="16" height="6.5" rx="1.4"/>
          <rect x="4" y="13" width="16" height="6.5" rx="1.4"/>
          <line x1="7" y1="7.75" x2="7.2" y2="7.75"/>
          <line x1="7" y1="16.25" x2="7.2" y2="16.25"/>
        </svg>
        {FAC_SHORT[fac]}
      </span>
      {s.issue && <span class="switcher-issue">#{s.issue}</span>}
    </span>
  </span>
  {isActive && <span class="switcher-check" aria-hidden="true">✓</span>}
</a>
