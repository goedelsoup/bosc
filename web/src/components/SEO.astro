---
/**
 * Per-page head metadata: description, canonical, Open Graph, Twitter Card, and
 * a site-wide JSON-LD @graph (WebSite + Organization). Rendered once by `Base.astro`
 * from the page's `title`/`description`.
 *
 * Absolute URLs (canonical, og:url, the WebSite node) need the deploy origin,
 * which only exists in production builds — `SITE_URL` → astro `site` →
 * `Astro.site` (see astro.config.ts and .github/workflows/pages.yml). Locally
 * and in CI it's undefined, so those tags are omitted and the share image falls
 * back to a base-relative path; everything lights up once `SITE_URL` is wired.
 *
 * `breadcrumbs` emits a second BreadcrumbList block. Since #1889 it is the route-derived trail
 * `Base.astro` also renders visibly, so the structured data and the on-page wayfinding cannot
 * disagree. Hrefs arrive root-absolute and pre-deploy-base; this component applies the base and
 * the deploy origin.
 */
import type { Crumb } from "@watermark/core/trail";
import { SITE_NAME, SITE_TAGLINE, withBase } from "@watermark/core/site";

const GITHUB_URL = "https://github.com/watermark-directory/the-watermark-directory";

interface Props {
  title: string;
  description: string;
  /** Root-absolute path to the share image. */
  image?: string;
  /** og:type — "website" for hubs/most pages, "article" for docs essays. */
  type?: "website" | "article";
  /** Keep this route out of search indexes (internal galleries, previews, leftovers). */
  noindex?: boolean;
  /** Breadcrumb trail for this page — root-absolute, pre-deploy-base hrefs. */
  breadcrumbs?: Crumb[];
}
const {
  title,
  description,
  image = "/og-default.png",
  type = "website",
  noindex = false,
  breadcrumbs,
} = Astro.props;

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const imagePath = withBase(image);
const imageUrl = site ? new URL(imagePath, site).href : imagePath;
const imageAlt = `${SITE_NAME} — ${SITE_TAGLINE}`;

const jsonLd = site
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${site.href}#website`,
          name: SITE_NAME,
          url: site.href,
          description,
          inLanguage: "en-US",
        },
        {
          "@type": "Organization",
          "@id": `${site.href}#org`,
          name: "Watermark Directory",
          url: site.href,
          description: "Investigative platform decoding public-records documents about water infrastructure.",
          sameAs: [GITHUB_URL],
        },
      ],
    }
  : null;

// `item` is omitted where the crumb has no page — the current location (whose URL is the
// canonical above) and any namespace segment with no landing. schema.org allows a ListItem
// with only a `name`, and a fabricated URL there would be worse than an absent one.
const breadcrumbLd =
  site && breadcrumbs && breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((crumb, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: crumb.label,
          ...(crumb.href ? { item: new URL(withBase(crumb.href), site).href } : {}),
        })),
      }
    : null;
---

<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
{breadcrumbLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />}
