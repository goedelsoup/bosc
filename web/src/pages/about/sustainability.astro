---
// Sustainability page — Watermark's own compute footprint, published to the same
// standard as the sites we track: every figure labeled, every derivation disclosed.
// Design: Sustainability.dc.html (c897e79f-df78-4b0d-be58-7b43bae699c0)
import Base from "~/layouts/Base.astro";
import EvidenceTag from "~/components/EvidenceTag.astro";
import FigureStat from "~/components/FigureStat.astro";
import Icon from "~/components/Icon.astro";
import DonutChart from "~/components/charts/DonutChart.astro";
import GaugeBar from "~/components/charts/GaugeBar.astro";
import LineChart from "~/components/charts/LineChart.astro";
import RankedBarChart from "~/components/charts/RankedBarChart.astro";
import type { DonutSlice, LinePoint, RankedBarDatum } from "~/lib/charts";
import type { FigureStatData } from "~/lib/viz";

const greenops: { icon: string; title: string; body: string }[] = [
  {
    icon: "archive",
    title: "Read once, cite forever",
    body: "A record's structured read is computed once, at corroboration time — not re-derived every time a page is opened. Every later visit is a cache hit, not a new inference.",
  },
  {
    icon: "document",
    title: "Static-first serving",
    body: "Pages are mostly static HTML built from the corroborated record. No client bundles re-fetching and re-rendering state on every load.",
  },
  {
    icon: "concept",
    title: "Right-sized models",
    body: "Extraction and classification run on small, task-tuned models. Large frontier models are reserved for the handful of steps that need judgment.",
  },
  {
    icon: "timeline",
    title: "Batch, not on-demand",
    body: "Document ingestion runs on a schedule against off-peak grid windows, in batches — not triggered per visitor request.",
  },
  {
    icon: "locked",
    title: "No tracker sprawl",
    body: "No analytics scripts, ad pixels, or session replay. Less fetched and less run, on every single page view.",
  },
  {
    icon: "filter",
    title: "Cold storage for cold records",
    body: "Sites still in early tracking phases sit in cheaper, lower-power storage tiers until they're active investigations.",
  },
];

const aiUses: { tag: string; title: string; body: string; model: string }[] = [
  {
    tag: "extraction",
    title: "Structured extraction",
    body: "Turns a scanned permit or filing into typed fields — dates, parties, figures — the record can display and cite.",
    model: "small task-tuned model",
  },
  {
    tag: "corroboration",
    title: "Corroboration assist",
    body: "Surfaces candidate sources that might confirm or contradict an open lead. Never confirms one on its own.",
    model: "small task-tuned model",
  },
  {
    tag: "search & ask",
    title: "Search & Ask",
    body: "Answers a question against the corpus and returns it with citations back to source pages.",
    model: "mid-size model, retrieval-grounded",
  },
  {
    tag: "drafting",
    title: "Drafting",
    body: "Turns dense source excerpts into a readable summary for a profile or timeline entry, held for editorial review.",
    model: "frontier model, reviewed before publish",
  },
];

const headline: FigureStatData[] = [
  {
    label: "Compute",
    value: "14,220",
    unit: "vCPU-hrs",
    evidence: "inference",
    basis: "modeled",
    sub: "hosting, ingestion, search, AI",
    source: "cloud billing export",
  },
  {
    label: "AI inferences run",
    value: "2.34M",
    unit: "calls",
    evidence: "inference",
    basis: "modeled",
    sub: "extraction, ask, corroboration, drafting",
    source: "model-provider usage logs",
  },
  {
    label: "Electricity drawn",
    value: "37.4",
    unit: "MWh",
    evidence: "inference",
    basis: "modeled",
    sub: "compute + cooling, all regions",
    source: "eGRID RFCW factors",
  },
  {
    label: "Water drawn",
    value: "37,500",
    unit: "gal",
    evidence: "inference",
    basis: "modeled",
    sub: "direct cooling + generation upstream",
    source: "EPRI / Uptime WUE benchmarks",
  },
];

const computeData: RankedBarDatum[] = [
  { label: "Hosting", value: 6200 },
  { label: "Ingestion", value: 3400 },
  { label: "AI inference", value: 3050 },
  { label: "Search index", value: 980 },
  { label: "Corroboration", value: 590 },
];

const aiSlices: DonutSlice[] = [
  { label: "Structured extraction", value: 1220000 },
  { label: "Search & Ask", value: 725000 },
  { label: "Corroboration assist", value: 255000 },
  { label: "Drafting summaries", value: 140000 },
];

const elecLine: LinePoint[] = [
  { label: "Jul", value: 2.8 },
  { label: "Aug", value: 3.1 },
  { label: "Sep", value: 3.3 },
  { label: "Oct", value: 3.0 },
  { label: "Nov", value: 2.9 },
  { label: "Dec", value: 3.2 },
  { label: "Jan", value: 3.6 },
  { label: "Feb", value: 3.3 },
  { label: "Mar", value: 3.0 },
  { label: "Apr", value: 2.9 },
  { label: "May", value: 3.1 },
  { label: "Jun", value: 3.2 },
];

// Electricity source mix: grid 23.2 MWh / matched renewable 14.2 MWh
const elecTotal = 23.2 + 14.2;
const elecGridPct = ((23.2 / elecTotal) * 100).toFixed(1);
const elecRenewPct = ((14.2 / elecTotal) * 100).toFixed(1);

// Water draw breakdown: direct 15,800 gal / indirect 21,700 gal
const waterTotal = 15800 + 21700;
const waterDirectPct = ((15800 / waterTotal) * 100).toFixed(1);
const waterIndirectPct = ((21700 / waterTotal) * 100).toFixed(1);

const methodology: { title: string; body: string }[] = [
  {
    title: "Compute",
    body: "Read from cloud vendor billing exports, split by service tag (hosting, ingestion, search, model inference).",
  },
  {
    title: "Electricity",
    body: "vCPU- and GPU-hours converted with vendor power-draw specs, then apportioned by EPA eGRID subregion carbon-intensity factors for where each workload runs.",
  },
  {
    title: "Water",
    body: "Modeled from the electricity figure using published Water Usage Effectiveness (WUE) benchmarks for the relevant facility types — direct on-site cooling plus the water withdrawn upstream to generate the power we draw.",
  },
];
---

<Base
  title="Sustainability"
  section="about"
  description="Watermark's own compute footprint — servers, storage, AI models, electricity and water — published as a lead with every figure labeled and its derivation disclosed."
>
  <article class="sust">

    <a href="/about" class="sust-back">← Back to About</a>
    <div class="sust-eyebrow">About · Sustainability</div>
    <h1 class="sust-h1">The build-out has a footprint too. Here's ours.</h1>
    <p class="sust-lead">
      Watermark exists to put a compute build-out on the public record. Running the platform is
      itself compute — servers, storage, and a working set of AI models that read documents so you
      don't have to. We hold ourselves to the same standard we ask of the sites we track: the
      numbers below are published as a lead, not a verdict, and every one is labeled with how it
      was derived.
    </p>

    <!-- ── GreenOps ──────────────────────────────────────────────────── -->
    <section class="sust-section">
      <div class="sust-eyebrow-sm">GreenOps</div>
      <h2 class="sust-h2">Built to do less, by default</h2>
      <p class="sust-section-lead">
        Most of what cuts our footprint isn't a program — it's an architecture decision made once
        and inherited by every page after. In order of how much they save:
      </p>
      <div class="sust-greenops-grid">
        {
          greenops.map((g) => (
            <div class="sust-gop-card">
              <div class="sust-gop-head">
                <span class="sust-gop-icon">
                  <Icon name={g.icon} size={16} />
                </span>
                <span class="sust-gop-title">{g.title}</span>
              </div>
              <p class="sust-gop-body">{g.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── AI uses ───────────────────────────────────────────────────── -->
    <section class="sust-section">
      <div class="sust-eyebrow-sm">Artificial intelligence</div>
      <h2 class="sust-h2">Where models touch the record</h2>
      <p class="sust-section-lead">
        Models are scoped narrowly — to reading, not to deciding. We don't run recommendation
        engines, engagement scoring, or ad targeting. Four jobs, each sized to the smallest model
        that does it well:
      </p>
      <div class="sust-ai-grid">
        {
          aiUses.map((u) => (
            <div class="sust-ai-card">
              <div class="sust-ai-tag">{u.tag}</div>
              <div class="sust-ai-title">{u.title}</div>
              <p class="sust-ai-body">{u.body}</p>
              <div class="sust-ai-model">{u.model}</div>
            </div>
          ))
        }
      </div>
      <div class="sust-ai-banner">
        <EvidenceTag kind="inference" />
        <p class="sust-ai-banner-text">
          Everything a model outputs is stamped <strong>inference</strong> until a human
          corroborates it against a source. A draft never ships as a finding on its own.
        </p>
      </div>
    </section>

    <!-- ── Usage report ──────────────────────────────────────────────── -->
    <section class="sust-section">
      <div class="sust-eyebrow-sm">The usage report</div>
      <h2 class="sust-h2">Compute, AI, electricity &amp; water</h2>
      <div class="sust-report-meta">
        <span class="sust-report-period">Trailing 12 months · Jul 2025–Jun 2026</span>
        <span class="sust-report-note">figures are inferred, not metered — see methodology below</span>
      </div>

      <div class="sust-headline-grid">
        {headline.map((s) => <FigureStat stat={s} size="lg" />)}
      </div>

      <div class="sust-charts-grid">

        <!-- Compute by function -->
        <div class="sust-chart-panel">
          <div class="sust-panel-head">
            <span class="sust-panel-icon"><Icon name="measure" size={18} /></span>
            <span class="sust-panel-label">
              Compute · by function <span class="sust-panel-unit">(vCPU-hrs)</span>
            </span>
          </div>
          <RankedBarChart
            data={computeData}
            kicker="Bar · horizontal"
            title="Compute by function (vCPU-hrs)"
            unit="vCPU-hrs"
          />
          <p class="sust-panel-note">
            Hosting &amp; serving the record still costs more than reading it with a model — the
            site is mostly static pages, not live inference.
          </p>
        </div>

        <!-- AI by task type -->
        <div class="sust-chart-panel">
          <div class="sust-panel-head">
            <span class="sust-panel-icon"><Icon name="concept" size={18} /></span>
            <span class="sust-panel-label">AI · by task type</span>
          </div>
          <DonutChart
            slices={aiSlices}
            kicker="Donut · composition"
            title="AI inferences by task type"
            centerLabel="inferences"
          />
          <p class="sust-panel-note">
            Structured extraction — turning a filing into typed fields — is most of the volume;
            drafting is the smallest and most closely reviewed.
          </p>
        </div>

        <!-- Electricity monthly draw + source mix -->
        <div class="sust-chart-panel">
          <div class="sust-panel-head">
            <span class="sust-panel-icon"><Icon name="power" size={18} /></span>
            <span class="sust-panel-label">Electricity · monthly draw</span>
          </div>
          <LineChart
            data={elecLine}
            kicker="Line · monthly (MWh)"
            title="Electricity drawn by month"
            endLabel="3.2 MWh"
          />
          <hr class="sust-divider" />
          <div class="sust-stack-label">Source mix</div>
          <div class="sust-stack-track" role="img" aria-label={`Grid ${elecGridPct}%, renewable ${elecRenewPct}%`}>
            <div class="sust-stack-seg sust-stack-seg--1" style={`width:${elecGridPct}%`}></div>
            <div class="sust-stack-seg sust-stack-seg--2" style={`width:${elecRenewPct}%`}></div>
          </div>
          <ul class="sust-stack-legend">
            <li class="sust-stack-item">
              <span class="sust-stack-dot sust-stack-dot--1" aria-hidden="true"></span>
              Grid (regional mix) · 23.2 MWh · {elecGridPct}%
            </li>
            <li class="sust-stack-item">
              <span class="sust-stack-dot sust-stack-dot--2" aria-hidden="true"></span>
              Matched renewable (RECs) · 14.2 MWh · {elecRenewPct}%
            </li>
          </ul>
        </div>

        <!-- Water vs budget + draw breakdown -->
        <div class="sust-chart-panel">
          <div class="sust-panel-head">
            <span class="sust-panel-icon"><Icon name="discharge" size={18} /></span>
            <span class="sust-panel-label">Water · against internal budget</span>
          </div>
          <GaugeBar
            value={37500}
            cap={45000}
            unit="gal"
            label="of the internal annual water budget"
            kicker="Gauge · against the cap"
            title="Water drawn vs budget"
          />
          <hr class="sust-divider" />
          <div class="sust-stack-label">Draw breakdown</div>
          <div class="sust-stack-track" role="img" aria-label={`Direct ${waterDirectPct}%, indirect ${waterIndirectPct}%`}>
            <div class="sust-stack-seg sust-stack-seg--1" style={`width:${waterDirectPct}%`}></div>
            <div class="sust-stack-seg sust-stack-seg--2" style={`width:${waterIndirectPct}%`}></div>
          </div>
          <ul class="sust-stack-legend">
            <li class="sust-stack-item">
              <span class="sust-stack-dot sust-stack-dot--1" aria-hidden="true"></span>
              Direct — on-site cooling · 15,800 gal · {waterDirectPct}%
            </li>
            <li class="sust-stack-item">
              <span class="sust-stack-dot sust-stack-dot--2" aria-hidden="true"></span>
              Indirect — grid generation upstream · 21,700 gal · {waterIndirectPct}%
            </li>
          </ul>
        </div>

      </div>
    </section>

    <!-- ── Methodology ───────────────────────────────────────────────── -->
    <div class="sust-method">
      <div class="sust-method-head">
        <EvidenceTag kind="inference" label="how these are derived" />
      </div>
      <div class="sust-method-grid">
        {
          methodology.map((m) => (
            <div class="sust-method-item">
              <div class="sust-method-title">{m.title}</div>
              <p class="sust-method-body">{m.body}</p>
            </div>
          ))
        }
      </div>
      <p class="sust-method-sources">
        sources · cloud billing export FY26 · EPA eGRID subregion RFCW factors 2025 · EPRI /
        Uptime Institute WUE benchmarks 2024
      </p>
    </div>

    <!-- ── CTA ───────────────────────────────────────────────────────── -->
    <div class="sust-cta">
      <div class="sust-cta-body">
        <div class="sust-cta-eyebrow">These are estimates, not meter reads</div>
        <div class="sust-cta-heading">Have real numbers, or found an error?</div>
        <p class="sust-cta-sub">
          Same rule as everywhere else on Watermark: every figure links to a correction.
        </p>
      </div>
      <a href="/submit" class="sust-cta-btn">Submit a correction →</a>
    </div>

    <p class="sust-foot">
      maintained by the record team · <a href="/about/data">data catalog</a> · <a href="/about"
        >about</a
      >
    </p>

  </article>
</Base>

<style>
  .sust {
    max-width: 1080px;
    margin: 0 auto;
    padding: 44px 36px 100px;
  }

  /* ── Header ─────────────────────────────────────────────────────────── */

  .sust-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--bosc-forest);
    text-decoration: none;
    margin-bottom: 14px;
  }
  .sust-back:hover { text-decoration: underline; }

  .sust-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bosc-forest);
    font-weight: 700;
    font-family: var(--bosc-mono);
  }

  .sust-h1 {
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 8px 0 16px;
    line-height: 1.06;
    max-width: 820px;
  }

  .sust-lead {
    font-size: 1.09rem;
    line-height: 1.62;
    color: var(--bosc-muted);
    margin: 0;
    max-width: 740px;
  }

  /* ── Section scaffolding ─────────────────────────────────────────────── */

  .sust-section { margin-top: 56px; }

  .sust-eyebrow-sm {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bosc-forest);
    font-weight: 700;
    font-family: var(--bosc-mono);
  }

  .sust-h2 {
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 8px 0 10px;
  }

  .sust-section-lead {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--bosc-muted);
    margin: 0 0 20px;
    max-width: 760px;
  }

  /* ── GreenOps grid ───────────────────────────────────────────────────── */

  .sust-greenops-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2px;
    background: var(--bosc-rule);
    border: 1px solid var(--bosc-rule);
  }

  .sust-gop-card {
    background: var(--bosc-surface);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sust-gop-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sust-gop-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: var(--data-withheld);
    color: var(--bosc-forest);
    flex: 0 0 auto;
  }

  .sust-gop-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--bosc-ink);
  }

  .sust-gop-body {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--bosc-muted);
    margin: 0;
  }

  /* ── AI uses ─────────────────────────────────────────────────────────── */

  .sust-ai-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
    margin-bottom: 14px;
  }

  .sust-ai-card {
    background: var(--bosc-surface);
    border: 1px solid var(--bosc-rule);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .sust-ai-tag {
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--bosc-faint);
    font-weight: 700;
    font-family: var(--bosc-mono);
  }

  .sust-ai-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--bosc-ink);
  }

  .sust-ai-body {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--bosc-muted);
    margin: 0;
    flex: 1 1 auto;
  }

  .sust-ai-model {
    font-size: 0.75rem;
    color: var(--bosc-faint);
    font-family: var(--bosc-mono);
  }

  .sust-ai-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    background: var(--bosc-ink);
    padding: 18px 22px;
  }

  .sust-ai-banner-text {
    font-size: 0.875rem;
    color: var(--data-axis);
    line-height: 1.5;
    flex: 1 1 320px;
    margin: 0;
  }
  .sust-ai-banner-text strong { color: var(--bosc-surface); }

  /* ── Usage report ────────────────────────────────────────────────────── */

  .sust-report-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .sust-report-period {
    font-size: 0.78rem;
    font-family: var(--bosc-mono);
    color: var(--bosc-muted);
  }

  .sust-report-note {
    font-size: 0.78rem;
    color: var(--bosc-faint);
  }

  .sust-headline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2px;
    background: var(--bosc-rule);
    border: 1px solid var(--bosc-rule);
    margin-bottom: 16px;
  }

  /* ── Chart panels ────────────────────────────────────────────────────── */

  .sust-charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 14px;
  }

  .sust-chart-panel {
    background: var(--bosc-surface);
    border: 1px solid var(--bosc-rule);
    padding: 20px 22px;
  }

  .sust-panel-head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 14px;
    color: var(--bosc-forest);
  }

  .sust-panel-icon { display: flex; }

  .sust-panel-label {
    font-size: 0.69rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--bosc-faint);
    font-weight: 700;
  }

  .sust-panel-unit {
    text-transform: none;
    letter-spacing: 0;
    color: var(--bosc-faint);
  }

  .sust-panel-note {
    font-size: 0.78rem;
    color: var(--bosc-faint);
    margin-top: 10px;
    line-height: 1.5;
    margin-bottom: 0;
  }

  .sust-divider {
    height: 1px;
    background: var(--bosc-rule);
    border: none;
    margin: 14px 0;
  }

  /* ── Proportion strips (data categories, not evidence) ───────────────── */

  .sust-stack-label {
    font-size: 0.69rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--bosc-faint);
    font-weight: 600;
    margin-bottom: 6px;
  }

  .sust-stack-track {
    display: flex;
    height: 14px;
    overflow: hidden;
  }

  .sust-stack-seg { height: 100%; }
  .sust-stack-seg--1 { background: var(--data-1); }
  .sust-stack-seg--2 { background: var(--data-4); }

  .sust-stack-legend {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sust-stack-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    color: var(--bosc-muted);
    font-family: var(--bosc-mono);
  }

  .sust-stack-dot {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    display: inline-block;
  }
  .sust-stack-dot--1 { background: var(--data-1); }
  .sust-stack-dot--2 { background: var(--data-4); }

  /* ── Methodology ─────────────────────────────────────────────────────── */

  .sust-method {
    margin-top: 36px;
    padding: 22px 24px;
    background: var(--bosc-surface);
    border: 1px solid var(--bosc-rule);
  }

  .sust-method-head { margin-bottom: 12px; }

  .sust-method-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }

  .sust-method-item {}

  .sust-method-title {
    font-size: 0.84rem;
