---
import Base from "~/layouts/Base.astro";
import HubLede from "~/components/HubLede.astro";
import { hasFeed, loadFeed, loadManifest } from "@watermark/core/bundle";
import { slugify, type EntityNode, type OpenQuestionItem } from "@watermark/core/feeds";
import { roleTotal, topEntities } from "@watermark/core/hubLede";
import { withBase } from "@watermark/core/site";

const manifest = loadManifest();
const byName = new Map(manifest.feeds.map((f) => [f.name, f]));
const count = (n: string): number => byName.get(n)?.count ?? 0;
const num = (n: number): string => n.toLocaleString("en-US");

// The lede (#1891): four category tiles told a reader the wiki has entities and concepts, which
// they could already guess from the tab. What they can't guess is WHO the record keeps returning
// to, and what it still can't answer — so those lead, and the tiles follow. Both come from the
// feeds the hub already reads for its counts; an empty graph reads as the absence.
const entities = hasFeed("entities") ? loadFeed<EntityNode[]>("entities") : [];
const mostLinked = topEntities(entities, 6);
const questions = hasFeed("open-questions") ? loadFeed<OpenQuestionItem[]>("open-questions") : [];
const openTop = questions.slice(0, 3);

interface Door {
  id: string;
  kind: string;
  href: string;
  count: string;
  title: string;
  desc: string;
  note: string;
}
// Every door is network-global — the wiki hub's contract (#1892). People are deliberately NOT a
// door: a person's profile is per-site (curated from ONE site's record, `taxonomy.ts`), so the
// hub doesn't pretend to own the category — individuals with a site-curated profile are reached
// from their entity page's backlinks, and from each site's own record hub.
const doors: Door[] = [
  {
    id: "entities",
    kind: "Directory",
    href: "/wiki/entities/",
    count: num(count("entities")),
    title: "Entities",
    desc: "Resolved parties — variants, parcels, identifiers, graph neighborhood, and sources. Individuals with a site-curated profile link from their entity page.",
    note: "who appears",
  },
  {
    id: "graph",
    kind: "Visualization",
    href: "/wiki/graph",
    count: num(count("relationships")),
    title: "Entity graph",
    desc: "The interactive force-directed graph of entities and the relationships between them.",
    note: "interactive",
  },
  {
    id: "concepts",
    kind: "Glossary",
    href: "/wiki/concepts/",
    count: num(count("concepts")),
    title: "Concepts",
    desc: "Glossary entries cross-linked via [[wiki links]] — the method, defined.",
    note: "the glossary",
  },
];
if (hasFeed("hypotheses")) {
  doors.push({
    id: "hypotheses",
    kind: "Readings",
    href: "/wiki/hypotheses/",
    count: num(count("hypotheses")),
    title: "Hypotheses",
    desc: "The boom-origin readings of the build-out as cross-linked nodes — each lens, its evidence matrix, and the concepts and entities it bears on.",
    note: "how to read the network",
  });
}
if (hasFeed("open-questions")) {
  doors.push({
    id: "open-questions",
    kind: "Open threads",
    href: "/wiki/open-questions/",
    count: num(count("open-questions")),
    title: "Open questions",
    desc: "Every unanswered thread in the record — open leads and hypothesis cells, linked from the nodes that raise them.",
    note: "what's unresolved",
  });
}
if (hasFeed("corpus-index")) {
  doors.push({
    id: "corpus-index",
    kind: "Node map",
    href: "/wiki/corpus/",
    count: num(count("corpus-index")),
    title: "Corpus map",
    desc: "The at-a-glance index of every node in the record — entities, concepts, relationships, leads, and open threads, with degree and freshness.",
    note: "the whole corpus",
  });
}
const curated: string[] = [];
if (hasFeed("candidates")) curated.push("candidates");
if (hasFeed("defense-contractors")) curated.push("defense-contractors");
if (hasFeed("lei")) curated.push("LEIs");
if (curated.length) {
  const href = hasFeed("candidates")
    ? "/wiki/candidates"
    : hasFeed("lei")
      ? "/wiki/lei"
      : "/wiki/defense-contractors";
  doors.push({
    id: "curated",
    kind: "Curated lists",
    href,
    count: String(curated.length),
    title: "Curated inventories",
    desc: "Hand-curated lists alongside the corpus graph — leads to verify, not classifications.",
    note: curated.join(" · "),
  });
}
---

<Base title="Wiki" section="wiki" rail={false}>
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">Section · wiki</div>
        <h1>Who and what</h1>
        <p class="hub-lead">
          The cross-linked index of the parties and concepts in the record —
          entity and concept pages with backlinks and a graph neighborhood.
        </p>
      </div>
      <span class="hub-count"><span class="dot" aria-hidden="true"></span>{num(count("entities"))} entities · {num(count("relationships"))} edges</span>
    </div>

    <HubLede
      label="Who the record keeps returning to"
      absent={mostLinked.length === 0
        ? "No entity graph has been resolved for this build yet, so there is no one to lead with. The graph is a projection of the record — it fills in as documents are read, and it stays empty rather than showing another build's parties."
        : null}
      cite="Ranked by how many roles each party holds across the record — the same order the entity index uses. Open questions are the [open]-tagged leads and hypothesis cells, aggregated."
      href={withBase("/wiki/entities/")}
      cta="All entities"
    >
      <p class="hublede-say">
        <span class="num">{num(count("entities"))}</span> resolved parties, tied by
        <span class="num"> {num(count("relationships"))}</span> documented relationships. These are
        the ones the record names most often:
      </p>
      <div class="hublede-chips">
        {
          mostLinked.map((e) => (
            <a class="hublede-chip" href={`${withBase("/wiki/entities/")}${slugify(e.key)}/`}>
              {e.display} <span class="hublede-chip-n">{roleTotal(e)}</span>
            </a>
          ))
        }
      </div>
      {
        openTop.length > 0 && (
          <ul class="hublede-list">
            {openTop.map((q) => (
              <li class="hublede-item">
                <span class="hublede-item-k">[open]</span>
                <span class="hublede-item-b">
                  <a class="hublede-item-t" href={withBase("/wiki/open-questions/")}>
                    {q.question}
                  </a>
                  <span class="hublede-item-m">{q.source}</span>
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </HubLede>

    <div class="hub-grid">
      {
        doors.map((d) => (
          <a class="hub-door" id={d.id} href={withBase(d.href)}>
            <div class="hub-door-top">
              <span class="hub-door-kind">{d.kind}</span>
              <span class="hub-door-count">{d.count}</span>
            </div>
            <div class="hub-door-title">{d.title}</div>
            <div class="hub-door-desc">{d.desc}</div>
            <div class="hub-door-foot">
              <span class="hub-door-browse">Browse</span>
              <span class="hub-door-note">{d.note}</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
