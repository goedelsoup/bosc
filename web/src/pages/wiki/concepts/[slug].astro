---
import type { GetStaticPaths } from "astro";
import Base from "~/layouts/Base.astro";
import ConceptAsk from "~/components/ConceptAsk.astro";
import ProfileHeader from "~/components/ProfileHeader.astro";
import type { NeighborNode } from "~/lib/conceptAsk";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import { neighborhoodFor } from "@watermark/core/corpusNeighbors";
import type { ConceptItem, CorpusRetrievalNodeItem } from "@watermark/core/feeds";
import type { ProfileHeaderData, ProfileRel } from "@watermark/core/profile";
import { withBase } from "@watermark/core/site";
import {
  conceptBacklinks,
  hypothesisBacklinks,
  norm,
  openQuestionBacklinks,
  renderBody,
  wikiIndex,
} from "@watermark/core/wiki";

export const getStaticPaths: GetStaticPaths = () => {
  const concepts = hasFeed("concepts") ? loadFeed<ConceptItem[]>("concepts") : [];
  // The corpus-scoped "ask this concept" substrate (#1575). Computed here (not in the body) so it
  // matches the scoped page, and links resolve pre-base to each concept's global wiki page.
  const nodes = hasFeed("corpus-nodes") ? loadFeed<CorpusRetrievalNodeItem[]>("corpus-nodes") : [];
  return concepts.map((concept) => {
    const neighborNodes: NeighborNode[] = neighborhoodFor(concept, nodes).map((n) => ({
      ...n,
      href: n.kind === "concept" && n.ref ? withBase(`/wiki/concepts/${n.ref}/`) : null,
    }));
    return { params: { slug: concept.slug }, props: { concept, neighborNodes } };
  });
};

interface Props {
  concept: ConceptItem;
  neighborNodes: NeighborNode[];
}
const { concept, neighborNodes } = Astro.props;
const index = wikiIndex();
const bodyHtml = renderBody(concept.body, index);
const related = concept.related
  .map((r) => index.get(norm(r)))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
const backlinks = conceptBacklinks(concept.slug);
// Open questions that raise this concept — the backlink peer of `[[wiki links]]` over the
// prose-only `open-questions` feed (#1569).
const openQuestions = openQuestionBacklinks([concept.title, ...concept.aliases]);
// The boom-origin hypotheses this concept bears on — the reverse of the hypothesis node's
// "Concepts it bears on" rail (#1570).
const hypotheses = hypothesisBacklinks([concept.title, ...concept.aliases]);

const rels: ProfileRel[] = related.map((t) => ({ kind: t.kind, label: t.label, href: t.url }));

const header: ProfileHeaderData = {
  kindLabel: `Concept${concept.kind && concept.kind !== "concept" ? ` · ${concept.kind}` : ""}`,
  name: concept.title,
  variants: concept.aliases,
  descriptor: concept.summary || undefined,
  evidence: "verified",
  relLabel: "Related",
  relationships: rels.length ? rels : undefined,
  correctHref: withBase(
    `/submit?ref_kind=concept&ref_id=${encodeURIComponent(concept.slug)}&ref_label=${encodeURIComponent(concept.title)}`,
  ),
};

const sections = [
  { anchor: "overview", label: "Identity" },
  ...(backlinks.length ? [{ anchor: "backlinks", label: "Backlinks" }] : []),
  ...(hypotheses.length ? [{ anchor: "hypotheses", label: "Hypotheses" }] : []),
  ...(openQuestions.length ? [{ anchor: "open-questions", label: "Open questions" }] : []),
  ...(neighborNodes.length ? [{ anchor: "ask-concept-heading", label: "Ask this concept" }] : []),
];
const profileToc = sections.length >= 2 ? sections : [];
---

<Base title={concept.title} section="wiki" description={concept.summary} toc={profileToc}>
  <p class="prose"><a href={withBase("/wiki/concepts/")}>← Concepts</a></p>
  <div id="overview"><ProfileHeader profile={header} /></div>

  <article class="prose">
    {
      concept.tags.length > 0 && (
        <ul class="chips">
          {concept.tags.map((t) => (
            <li class="chip">{t}</li>
          ))}
        </ul>
      )
    }

    <Fragment set:html={bodyHtml} />

    {
      backlinks.length > 0 && (
        <div class="backlinks">
          <h2 id="backlinks">Backlinks</h2>
          <ul class="neighborhood">
            {backlinks.map((b) => (
              <li>
                <a href={b.url}>{b.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      hypotheses.length > 0 && (
        <div class="backlinks">
          <h2 id="hypotheses">Hypotheses</h2>
          <p class="card-meta">The boom-origin readings this concept bears on.</p>
          <ul class="neighborhood">
            {hypotheses.map((h) => (
              <li>
                <a href={h.url}>
                  {h.number} · {h.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      openQuestions.length > 0 && (
        <div class="backlinks">
          <h2 id="open-questions">Open questions</h2>
          <p class="card-meta">Unanswered threads in the record that raise this concept.</p>
          <ul class="neighborhood">
            {openQuestions.map((q) => (
              <li>
                <a href={q.url}>{q.question}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <ConceptAsk conceptTitle={concept.title} nodes={neighborNodes} />
  </article>
</Base>
