---
import type { GetStaticPaths } from "astro";
import Base from "~/layouts/Base.astro";
import ProfileHeader from "~/components/ProfileHeader.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import { slugify, type EntityNode, type PersonItem, type RelationshipEdge } from "@watermark/core/feeds";
import type { ProfileAttr, ProfileHeaderData, ProfileRel } from "@watermark/core/profile";
import type { FigureStatData } from "@watermark/core/viz";
import { entityHref } from "@watermark/core/entityLinks";
import { withBase, withSite } from "@watermark/core/site";
import { hypothesisBacklinks, openQuestionBacklinks, relatedConcepts } from "@watermark/core/wiki";
import { entityDegree, entityLei, leiAddress, leiParent } from "@watermark/core/entityEnrich";

export const getStaticPaths = (() => {
  const entities = hasFeed("entities") ? loadFeed<EntityNode[]>("entities") : [];
  const rels = hasFeed("relationships") ? loadFeed<RelationshipEdge[]>("relationships") : [];
  const people = hasFeed("people") ? loadFeed<PersonItem[]>("people") : [];
  const display: Record<string, string> = Object.fromEntries(entities.map((e) => [e.key, e.display]));
  return entities.map((entity) => ({
    params: { key: slugify(entity.key) },
    props: {
      entity,
      outgoing: rels.filter((r) => r.src === entity.key),
      incoming: rels.filter((r) => r.dst === entity.key),
      profiles: people.filter((p) => p.entity_key === entity.key),
      display,
    },
  }));
}) satisfies GetStaticPaths;

const { entity, outgoing, incoming, profiles, display } = Astro.props;
const label = (key: string): string => display[key] ?? key;

const roleTotal = Object.values(entity.roles ?? {}).reduce((a, b) => a + b, 0);
const topRole = Object.entries(entity.roles ?? {}).sort((a, b) => b[1] - a[1])[0];

// Graph degree — the same count a yidam `corpus-index` reports for this node, read off the
// `relationships` edge set the page already partitioned into outgoing/incoming (#1572).
const degree = entityDegree(entity.key, outgoing, incoming);

const stats: FigureStatData[] = [];
if (degree.total)
  stats.push({
    label: "Graph degree",
    value: String(degree.total),
    evidence: "verified",
    sub: `${degree.out} out · ${degree.in} in · ${degree.neighbors} neighbor${degree.neighbors === 1 ? "" : "s"}`,
  });
if (entity.parcels.length)
  stats.push({ label: "Parcels", value: String(entity.parcels.length), evidence: "verified" });
if (roleTotal)
  stats.push({
    label: "Record roles",
    value: String(roleTotal),
    evidence: "verified",
    sub: topRole ? `${topRole[0].replace(/_/g, " ")}` : undefined,
  });
if (entity.addresses.length)
  stats.push({ label: "Addresses", value: String(entity.addresses.length), evidence: "verified" });
if (entity.federal_obligations != null)
  stats.push({
    label: "Federal obligations",
    value: `$${entity.federal_obligations.toLocaleString("en-US")}`,
    evidence: "verified",
  });

const attrs: ProfileAttr[] = [];
if (entity.classification)
  attrs.push({ label: "Classification", value: entity.classification, tag: "verified" });
if (entity.signals?.length)
  attrs.push({ label: "Signals", value: entity.signals.join(", "), tag: "inference" });
if (entity.lei) attrs.push({ label: "LEI", value: entity.lei, tag: "verified" });
if (entity.uei) attrs.push({ label: "UEI", value: entity.uei, tag: "verified" });

const rels: ProfileRel[] = outgoing
  .slice(0, 5)
  .map((r) => ({ kind: r.rel, label: label(r.dst), href: entityHref(r.dst) }));

const header: ProfileHeaderData = {
  kindLabel: `Entity · ${entity.kind}`,
  name: entity.display,
  variants: entity.variants.filter((v) => v.toLowerCase() !== entity.display.toLowerCase()).slice(0, 3),
  evidence: entity.signals?.length ? "inference" : "verified",
  graphHref: withBase(`/wiki/graph#${slugify(entity.key)}`),
  stats: stats.length ? stats : undefined,
  attrs: attrs.length ? attrs : undefined,
  relLabel: "Graph neighborhood",
  relationships: rels.length ? rels : undefined,
  correctHref: withBase(
    `/submit?ref_kind=entity&ref_id=${encodeURIComponent(entity.key)}&ref_label=${encodeURIComponent(entity.display)}`,
  ),
};

// GLEIF registry join — the full LEI record behind the bare `entity.lei` code, joined by exact
// ID against the `lei` feed, with its parent chain resolved to entity pages where the parent is
// itself a node (#1572). Null when the entity has no LEI or the code isn't in the inventory.
const gleif = entityLei(entity);
const directParent = leiParent(gleif?.direct_parent);
const ultimateParent = leiParent(gleif?.ultimate_parent);
const gleifAddress = leiAddress(gleif?.legal_address);

// Concepts that name this entity in their prose — the glossary terms it cross-links to (#1572).
const concepts = relatedConcepts([entity.display, ...entity.variants]);

// Open questions that raise this entity — the backlink peer of `[[wiki links]]` over the
// prose-only `open-questions` feed (#1569).
const openQuestions = openQuestionBacklinks([entity.display, ...entity.variants]);
// The boom-origin hypotheses this entity bears on — the reverse of the hypothesis node's
// "Entities it bears on" rail (#1570).
const hypotheses = hypothesisBacklinks([entity.display, ...entity.variants]);

const profileToc = [
  { anchor: "overview", label: "Identity" },
  ...(gleif ? [{ anchor: "registry", label: "Registry" }] : []),
  { anchor: "neighborhood", label: "Relationships" },
  ...(concepts.length ? [{ anchor: "related-concepts", label: "Related concepts" }] : []),
  ...(entity.sources.length ? [{ anchor: "sources", label: "Sources" }] : []),
  ...(profiles.length ? [{ anchor: "backlinks", label: "Backlinks" }] : []),
  ...(hypotheses.length ? [{ anchor: "hypotheses", label: "Hypotheses" }] : []),
  ...(openQuestions.length ? [{ anchor: "open-questions", label: "Open questions" }] : []),
];
---

<Base title={entity.display} section="wiki" toc={profileToc}>
  <p class="prose"><a href={withBase("/wiki/entities/")}>← Entities</a></p>
  <div id="overview"><ProfileHeader profile={header} /></div>

  <article class="prose">
    {
      gleif && (
        <section id="registry">
          <h2>Corporate registry</h2>
          <p class="card-meta">
            GLEIF legal entity identifier — resolved by exact ID (no fuzzy name match), so the
            legal name and parent chain are authoritative.
          </p>
          <dl class="reg-grid">
            <dt>Legal name</dt>
            <dd>{gleif.legal_name}</dd>
            {gleif.jurisdiction && (
              <>
                <dt>Jurisdiction</dt>
                <dd>{gleif.jurisdiction}</dd>
              </>
            )}
            {gleif.legal_form && (
              <>
                <dt>Legal form</dt>
                <dd>{gleif.legal_form}</dd>
              </>
            )}
            {(gleif.entity_status || gleif.registration_status) && (
              <>
                <dt>Status</dt>
                <dd>{[gleif.entity_status, gleif.registration_status].filter(Boolean).join(" / ")}</dd>
              </>
            )}
            {gleifAddress && (
              <>
                <dt>Registered address</dt>
                <dd>{gleifAddress}</dd>
              </>
            )}
            {directParent && (
              <>
                <dt>Direct parent</dt>
                <dd>
                  {directParent.href ? <a href={directParent.href}>{directParent.name}</a> : directParent.name}
                  <span class="card-meta"><code>{directParent.lei}</code></span>
                </dd>
              </>
            )}
            {ultimateParent && (
              <>
                <dt>Ultimate parent</dt>
                <dd>
                  {ultimateParent.href ? (
                    <a href={ultimateParent.href}>{ultimateParent.name}</a>
                  ) : (
                    ultimateParent.name
                  )}
                  <span class="card-meta"><code>{ultimateParent.lei}</code></span>
                </dd>
              </>
            )}
            {gleif.last_update && (
              <>
                <dt>Last updated</dt>
                <dd>{gleif.last_update.slice(0, 10)}</dd>
              </>
            )}
          </dl>
          {gleif.note && <p class="card-meta">{gleif.note}</p>}
          <p>
            <a href={withBase("/wiki/lei/")}>See the full GLEIF inventory →</a>
          </p>
        </section>
      )
    }

    <h2 id="neighborhood">Graph neighborhood</h2>
    {
      outgoing.length === 0 && incoming.length === 0 ? (
        <p class="stub-note">No recorded relationships for this entity.</p>
      ) : (
        <ul class="neighborhood">
          {outgoing.map((r) => {
            const h = entityHref(r.dst);
            return (
              <li>
                <span class="rel-arrow">{r.rel} →</span>{" "}
                {h ? <a href={h}>{label(r.dst)}</a> : <span>{label(r.dst)}</span>}
                {r.source && <span class="card-meta"> ({r.source})</span>}
              </li>
            );
          })}
          {incoming.map((r) => {
            const h = entityHref(r.src);
            return (
              <li>
                {h ? <a href={h}>{label(r.src)}</a> : <span>{label(r.src)}</span>}{" "}
                <span class="rel-arrow">→ {r.rel}</span>
                {r.source && <span class="card-meta"> ({r.source})</span>}
              </li>
            );
          })}
        </ul>
      )
    }
    <p>
      <a href={`${withBase("/wiki/graph")}#${slugify(entity.key)}`}>
        View this neighborhood in the interactive graph →
      </a>
    </p>

    {
      concepts.length > 0 && (
        <>
          <h2 id="related-concepts">Related concepts</h2>
          <p class="card-meta">Glossary terms whose entries name this entity.</p>
          <ul class="neighborhood">
            {concepts.map((c) => (
              <li>
                <a href={c.url}>{c.title}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      entity.sources.length > 0 && (
        <>
          <h2 id="sources">Sources</h2>
          <ul>
            {entity.sources.map((s) => (
              <li><code>{s}</code></li>
            ))}
          </ul>
        </>
      )
    }

    {
      profiles.length > 0 && (
        <div class="backlinks">
          <h2 id="backlinks">Backlinks</h2>
          <ul class="neighborhood">
            {profiles.map((p) => (
              <li>
                {/* The per-site canonical view of this person (#1892) — this entity is the spine. */}
                Profile (site record): <a href={`${withSite("/site/people/")}${p.slug}/`}>{p.name}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      hypotheses.length > 0 && (
        <div class="backlinks">
          <h2 id="hypotheses">Hypotheses</h2>
          <p class="card-meta">The boom-origin readings this entity bears on.</p>
          <ul class="neighborhood">
            {hypotheses.map((h) => (
              <li>
                <a href={h.url}>
                  {h.number} · {h.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      openQuestions.length > 0 && (
        <div class="backlinks">
          <h2 id="open-questions">Open questions</h2>
          <p class="card-meta">Unanswered threads in the record that raise this entity.</p>
          <ul class="neighborhood">
            {openQuestions.map((q) => (
              <li>
                <a href={q.url}>{q.question}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
</Base>
