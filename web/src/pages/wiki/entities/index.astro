---
import Base from "~/layouts/Base.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import { slugify, type EntityNode } from "@watermark/core/feeds";
import { topEntities } from "@watermark/core/hubLede";
import { withBase } from "@watermark/core/site";

const entities = hasFeed("entities") ? loadFeed<EntityNode[]>("entities") : [];
// Same ranking the wiki hub's lede leads with — one owner, so the hub's "most named" and this
// index's first rows can never drift apart (#1891).
const sorted = topEntities(entities, entities.length);
---

<Base title="Entities" section="wiki">
  <article class="prose">
    <p><a href={withBase("/wiki/")}>← Wiki</a></p>
    <h1>Entities</h1>
    <p class="section-lead">
      {entities.length} resolved parties in the entity graph, keyed by canonical
      name. Each page carries its graph neighborhood, sources, and backlinks.
    </p>
    <div class="cards">
      {
        sorted.map((e) => (
          <a class="card" href={`${withBase("/wiki/entities/")}${slugify(e.key)}/`}>
            <span class="card-title">{e.display}</span>
            <span class="card-meta">{e.kind}{e.classification ? ` · ${e.classification}` : ""}</span>
          </a>
        ))
      }
    </div>
  </article>
</Base>
