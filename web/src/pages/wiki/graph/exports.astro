---
/**
 * Graph exports (`/wiki/graph/exports`, issue #1574, epic #1560 workstream D1) — the download
 * board for the corpus mirror serialized as interchange artifacts. The Python data tier projects
 * the committed corpus into yidam nodes (`watermark corpus-mirror`, #1561) and, at every canonical
 * `watermark export`, renders that graph into `exports/` as RDF (Turtle + JSON-LD) and GraphML;
 * the manifest's `exports[]` block advertises them and the `/exports/<file>` endpoints serve them.
 *
 * The wiki is network-global and reads the active (reference) build, so this is Lima's mirror. It
 * degrades honestly: a build whose bundle carries no `exports[]` (a redirected/test export, a thin
 * peer, a pre-1.28 fixture) shows the "generated at build" note rather than dead links.
 */
import Base from "~/layouts/Base.astro";
import Icon from "~/components/Icon.astro";
import { type ExportRef, getExports, loadManifest } from "@watermark/core/bundle";
import { withBase } from "@watermark/core/site";

const exports = getExports();
const manifest = loadManifest();
const basename = (p: string): string => p.split("/").pop() ?? p;

// Per-format copy — what the artifact is and what to open it with.
const FORMAT_META: Record<string, { label: string; blurb: string; tool: string }> = {
  turtle: {
    label: "RDF · Turtle",
    blurb:
      "The graph as RDF triples in Turtle syntax, on the yidam ontology (owl / rdfs / skos / prov). Load into any triplestore and query with SPARQL.",
    tool: "SPARQL · RDFLib · Apache Jena",
  },
  jsonld: {
    label: "RDF · JSON-LD",
    blurb:
      "The same RDF graph as a JSON-LD @graph document — the JSON-native serialization, identical vocabulary to the Turtle.",
    tool: "JSON-LD processors · RDFLib",
  },
  graphml: {
    label: "GraphML",
    blurb:
      "The directed link graph as GraphML — every mirror node a vertex, every resolved link a typed edge. Open it for visual network analysis.",
    tool: "Gephi · Cytoscape · yEd",
  },
};

const nodeCount = exports[0]?.node_count ?? 0;
const edgeCount = exports[0]?.edge_count ?? 0;
const meta = (e: ExportRef) => FORMAT_META[e.format] ?? { label: e.format, blurb: "", tool: "" };
---

<Base
  title="Graph exports"
  section="wiki"
  description="Download the entity graph — the corpus mirror serialized as RDF (Turtle + JSON-LD) and GraphML for external graph tools, generated at every export."
>
  <article class="gx">
    <p class="prose"><a href={withBase("/wiki/graph/")}>← Entity graph</a></p>
    <div class="gx-head">
      <div class="gx-kicker">Wiki · graph exports</div>
      <h1>Download the entity graph</h1>
      <p class="section-lead">
        The corpus — resolved entities and their relationships, the wiki concepts, profiled people,
        the leads board, the boom-origin hypotheses, and the <a href={withBase("/wiki/open-questions/")}>open
        questions</a> — is projected into one connected knowledge graph and serialized here as
        standard interchange formats, so you can query it, visualize it, or fold it into your own
        research outside this site. {exports.length > 0 && (
          <span>{nodeCount.toLocaleString()} nodes · {edgeCount.toLocaleString()} edges.</span>
        )}
      </p>
    </div>

    {
      exports.length === 0 ? (
        <p class="gx-empty">
          Graph exports are generated by <code>watermark export</code> and travel with the live
          build — this offline build carries none. The reference deploy links the RDF and GraphML
          downloads here.
        </p>
      ) : (
        <>
          <ul class="gx-list">
            {exports.map((e) => {
              const m = meta(e);
              return (
                <li class="gx-item">
                  <div class="gx-item-main">
                    <div class="gx-item-head">
                      <span class="gx-fmt">{m.label}</span>
                      <code class="gx-file">{basename(e.path)}</code>
                    </div>
                    <p class="gx-blurb">{m.blurb}</p>
                    {m.tool && <p class="gx-tool">Opens in {m.tool}</p>}
                  </div>
                  <a
                    class="gx-dl"
                    href={withBase(`/exports/${basename(e.path)}`)}
                    download={basename(e.path)}
                  >
                    <Icon name="download" size={13} /> Download
                  </a>
                </li>
              );
            })}
          </ul>

          <section class="gx-about">
            <h2><Icon name="corpus" size={15} /> How it's built</h2>
            <p>
              Each file is regenerated at every <code>watermark export</code> from the committed
              corpus — a standing artifact, never hand-edited. Nodes carry their evidence
              provenance; a relationship becomes a typed edge (RDF property / GraphML
              <code>type</code>). The projection is BOSC's realization of
              <a href="https://github.com/goedelsoup/yidam" rel="noopener noreferrer">yidam</a>'s
              <code>export rdf|graphml</code>.
            </p>
            <dl class="gx-prov">
              <div><dt>Generated</dt><dd>{manifest.generated_at}</dd></div>
              <div><dt>Contract</dt><dd>v{manifest.contract_version}</dd></div>
              <div><dt>Graph</dt><dd>{nodeCount.toLocaleString()} nodes / {edgeCount.toLocaleString()} edges</dd></div>
            </dl>
          </section>
        </>
      )
    }
  </article>
</Base>

<style>
  .gx-head { margin-bottom: var(--sp-5); }
  .gx-kicker {
    font-family: var(--bosc-mono);
    font-size: var(--fs-nano);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bosc-faint);
    margin-bottom: 0.4rem;
  }
  .gx-head h1 { margin: 0 0 0.5rem; }

  .gx-empty {
    border: 1px solid var(--bosc-rule);
    border-left: 3px solid var(--bosc-faint);
    background: var(--bosc-surface);
    padding: var(--sp-3) var(--sp-4);
    color: var(--bosc-muted);
    font-size: var(--fs-meta);
  }

  .gx-list { list-style: none; margin: var(--sp-5) 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-3); }
  .gx-item {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    border: 1px solid var(--bosc-rule);
    border-left: 3px solid var(--bosc-forest);
    background: var(--bosc-surface);
    padding: var(--sp-3) var(--sp-4);
  }
  .gx-item-main { flex: 1; min-width: 0; }
  .gx-item-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0.35rem; }
  .gx-fmt {
    font-family: var(--bosc-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bosc-ink-green);
  }
  .gx-file { font-family: var(--bosc-mono); font-size: var(--fs-nano); color: var(--bosc-faint); }
  .gx-blurb { margin: 0; color: var(--bosc-muted); font-size: var(--fs-meta); line-height: 1.55; max-width: 44rem; }
  .gx-tool { margin: 0.35rem 0 0; font-family: var(--bosc-mono); font-size: var(--fs-nano); color: var(--bosc-faint); }

  .gx-dl {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--bosc-mono);
    font-size: var(--fs-meta);
    color: var(--bosc-link);
    text-decoration: none;
    border: 1px solid var(--bosc-rule);
    padding: 0.45em 0.9em;
    background: var(--bosc-paper);
  }
  .gx-dl:hover { border-color: var(--bosc-forest); color: var(--bosc-forest); }

  .gx-about { margin-top: var(--sp-6); border-top: 1px solid var(--bosc-rule); padding-top: var(--sp-4); }
  .gx-about h2 { display: flex; align-items: center; gap: 0.4em; font-size: var(--fs-h3); margin: 0 0 0.6rem; }
  .gx-about p { color: var(--bosc-muted); font-size: var(--fs-meta); line-height: 1.6; max-width: 52rem; }
  .gx-about a { color: var(--bosc-link); }

  .gx-prov { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin: var(--sp-3) 0 0; }
  .gx-prov div { display: flex; flex-direction: column; gap: 0.15rem; }
  .gx-prov dt {
    font-family: var(--bosc-mono);
    font-size: var(--fs-nano);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bosc-faint);
  }
  .gx-prov dd { margin: 0; font-family: var(--bosc-mono); font-size: var(--fs-nano); color: var(--bosc-muted); }
</style>
