---
import { selectableSitePaths, siteForSlug } from "~/lib/sites";
export const getStaticPaths = selectableSitePaths;
import Base from "~/layouts/Base.astro";
import { hasFeed, loadManifest } from "~/lib/bundle";
import { isReferenceSite } from "~/lib/readiness";
import { withSite } from "~/lib/site";

// The section-lead + hub-count are Lima's real hydrology (the 7Q10 design low flow), so they're
// gated to the reference build; a peer site reads its own place + receiving water from the
// profile rather than inheriting Lima's numbers (#1217).
const { slug } = Astro.props as { slug: string };
const site = siteForSlug(slug);
const isRef = isReferenceSite(slug);

const manifest = loadManifest();
const byName = new Map(manifest.feeds.map((f) => [f.name, f]));
const count = (n: string): number => byName.get(n)?.count ?? 0;
const num = (n: number): string => n.toLocaleString("en-US");
const geoMapLayers = manifest.feeds.filter(
  (f) => f.name.startsWith("geo/") && f.name !== "geo/imagery",
).length;

interface Door {
  id: string;
  kind: string;
  href: string;
  count: string;
  title: string;
  desc: string;
  note: string;
}
const doors: Door[] = [
  {
    id: "hydrology",
    kind: "Analysis",
    href: withSite("/watershed/hydrology"),
    count: num(count("hydrology-scenarios")),
    title: "Hydrology",
    desc: "Water-balance / low-flow dilution screen — live flow vs the 7Q10 design low flow, and the headroom that remains.",
    note: "dashboard",
  },
  {
    id: "map",
    kind: "Interactive map",
    href: withSite("/watershed/map"),
    count: num(geoMapLayers),
    title: "Watershed map",
    desc: "Typed GeoJSON layers on deck.gl + MapLibre — campus, corridor, floodway, WWTP, RSEI, watershed.",
    note: "interactive",
  },
  {
    id: "imagery",
    kind: "Aerial imagery",
    href: withSite("/watershed/imagery"),
    count: "—",
    title: "Imagery",
    desc: "Dated Esri Wayback aerials over the campus AOI — before / during / after the buildout.",
    note: "before / after",
  },
  {
    id: "rsei",
    kind: "External data",
    href: withSite("/watershed/rsei"),
    count: num(count("geo/rsei")),
    title: "RSEI / toxics",
    desc: "EPA RSEI toxic-release inventory on the same reaches the campus discharges to.",
    note: "release sites",
  },
];
if (hasFeed("air-dispersion-field")) {
  doors.push({
    id: "air",
    kind: "Interactive field",
    href: withSite("/watershed/air"),
    count: "—",
    title: "Air dispersion",
    desc: "A Tier-1 AERMOD screening field of criteria-pollutant concentrations over the campus grid — modeled, [inference].",
    note: "modeled screen",
  });
}
if (hasFeed("economics-baseline")) {
  doors.push({
    id: "economics",
    kind: "Baseline data",
    href: withSite("/watershed/economics-baseline"),
    count: "—",
    title: "Economics baseline",
    desc: "Localized BLS QCEW / Census employment baseline for the corridor.",
    note: "BLS · Census",
  });
}
---

<Base title="The Maumee watershed" section="watershed" rail={false}>
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">Section · the Maumee watershed</div>
        <h1>The water it sits in</h1>
        <p class="hub-lead">
          Stormwater and water-balance modeling of the {site?.place} municipal loop, the
          watershed map, dated imagery, and the RSEI toxic-release picture.
        </p>
      </div>
      <span class="hub-count">{isRef ? "Ottawa River · 7Q10 ≈ 0.2 cfs" : site?.basin}</span>
    </div>
    <div class="hub-grid">
      {
        doors.map((d) => (
          <a class="hub-door" id={d.id} href={d.href}>
            <div class="hub-door-top">
              <span class="hub-door-kind">{d.kind}</span>
              <span class="hub-door-count">{d.count}</span>
            </div>
            <div class="hub-door-title">{d.title}</div>
            <div class="hub-door-desc">{d.desc}</div>
            <div class="hub-door-foot">
              <span class="hub-door-browse">Browse</span>
              <span class="hub-door-note">{d.note}</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
