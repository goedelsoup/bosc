---
/**
 * The story chapter shell (#724/#732) — one dynamic route renders every chapter of every
 * selectable site's story from the `stories` MDX collection. The shell owns the chrome
 * (wayfinding, eyebrow, title, chapter nav); the MDX body is the prose, composed from the
 * provided story components (`STORY_COMPONENTS`).
 *
 * Incremental migration (#733): while a literal `<chapter>.astro` page still exists for a slug,
 * it serves the URL and `getStaticPaths` skips it here — so the two never collide. The
 * `existsSync` guard self-clears as each literal page is deleted; remove it once they're all gone.
 */
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { getEntry, render } from "astro:content";
import PathWayfinding from "~/components/PathWayfinding.astro";
import { STORY_COMPONENTS } from "~/components/story";
import Base from "~/layouts/Base.astro";
import { siteBase } from "@watermark/core/routes";
import { siteRegistersStory, storyComingSoon } from "@watermark/core/sites";
import {
  type Story,
  chapterHref,
  storyChapterByStep,
  storyContentsHref,
  storyFor,
  storyHomeHref,
} from "@watermark/core/walk";
import { getCollection } from "astro:content";
import { chapterNumber, STUDY_PARTS, studyChapter } from "@watermark/core/study";
import { withSite } from "@watermark/core/site";

export async function getStaticPaths() {
  const entries = await getCollection("stories");
  const paths = [];
  for (const entry of entries) {
    if (typeof (entry.data as { step?: unknown }).step !== "number") continue; // skip the home
    const [slug, codename, chapter] = String(entry.id).split("/");
    // Gate on story REGISTRATION, not switchability (#1466) — see `siteRegistersStory`. A held
    // (`comingSoon`) story emits its ROOT and nothing below it (#1894): the chapter route used to
    // emit anyway and serve the interstitial, on the reasoning that "links resolve, not 404" — but
    // measured against the build, no link, no menu and no search row pointed at any of them. What
    // the URL bought was a page nobody could arrive at. The prose is still never placed; now the
    // address isn't either, until the edit that makes the chapter readable.
    if (!slug || !codename || !siteRegistersStory(slug, codename)) continue;
    if (storyComingSoon(slug, codename)) continue;
    const siteId = siteBase(slug).replace("/network/", "");
    const literal = fileURLToPath(
      new URL(`../../../${siteId}/stories/${codename}/${chapter}.astro`, import.meta.url),
    );
    if (existsSync(literal)) continue; // a literal page still serves this URL
    paths.push({ params: { site: siteId, codename, chapter }, props: { slug, codename, chapter } });
  }
  return paths;
}

const { slug, codename, chapter } = Astro.props as { slug: string; codename: string; chapter: string };
// getStaticPaths only emits registered, present entries.
const story = storyFor(slug, codename) as Story;
const entry = await getEntry("stories", `${slug}/${codename}/${chapter}`);
if (!entry || !("step" in entry.data)) {
  throw new Error(`Story chapter not found: ${slug}/${codename}/${chapter}`);
}
const { Content } = await render(entry);

const fm = entry.data;
const ch = story.chapters.find((c) => c.slug === chapter) ?? {
  step: fm.step,
  slug: fm.slug,
  title: fm.title,
};
const step = ch.step;
const total = story.chapters.length;
const prev = storyChapterByStep(story, step - 1);
const next = storyChapterByStep(story, step + 1);
const prevHref = prev?.live ? chapterHref(story, prev.slug) : undefined;
const nextHref = next?.live ? chapterHref(story, next.slug) : undefined;
const pageTitle = fm.pageTitle ?? `${ch.title} — Chapter ${step}`;

// The walk↔study cross-link, walk side (the missing-impact-study epic): one hop to the study
// chapter this walk chapter teaches toward. `studyChapter` throws on a typo'd id — a build
// failure, not a silent dead link.
const studyTarget = "studySection" in fm && fm.studySection ? studyChapter(fm.studySection) : null;
const studyPart = studyTarget ? STUDY_PARTS.find((p) => p.id === studyTarget.part) : null;
// One prebuilt label — expression-boundary whitespace collapses in the template.
const studyLabel =
  studyTarget && studyPart
    ? `The impact study, §${studyPart.num}·${chapterNumber(studyTarget.id)} ${studyTarget.title}`
    : null;

// The codename segment is a URL key; the trail wants the story's name (#1889).
const trailLabels = { [codename]: story.title };

const articleLd = Astro.site
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: pageTitle,
      description: fm.description,
      author: { "@type": "Organization", "@id": `${Astro.site.href}#org`, name: "Watermark Directory" },
      publisher: { "@type": "Organization", "@id": `${Astro.site.href}#org`, name: "Watermark Directory" },
      isPartOf: { "@type": "WebSite", "@id": `${Astro.site.href}#website` },
    }
  : null;
---
<Base
  title={pageTitle}
  section="story"
  description={fm.description}
  prevHref={prevHref}
  nextHref={nextHref}
  trailLabels={trailLabels}
  trailLeaf={ch.title}
>
  {articleLd && <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />}
  <div class="walk-chapter-page">
    <PathWayfinding step={step} story={story} />

    <div class="walk-chapter-eyebrow">{fm.eyebrow ?? `Chapter ${step} of ${total} · the story`}</div>
    <h1 class="walk-chapter-h1">{ch.title}</h1>

    <Content components={STORY_COMPONENTS} />

    {studyTarget && studyPart && (
      <p class="walk-studylink">
        The finding this chapter teaches toward →{" "}
        <a href={withSite(`/study/${studyTarget.id}`)}>{studyLabel}</a>
      </p>
    )}

    <nav class="walk-nav" aria-label="Chapter navigation">
      {
        prev?.live ? (
          <a class="walk-nav-link walk-nav-prev" href={chapterHref(story, prev.slug)}>← {prev.step}. {prev.title}</a>
        ) : prev ? (
          <span class="walk-nav-link walk-nav-prev is-disabled" title="Drafting">← {prev.step}. {prev.title}</span>
        ) : (
          <a class="walk-nav-link walk-nav-prev" href={storyHomeHref(story)}>← Start here</a>
        )
      }
      <a class="walk-nav-leave" href={storyContentsHref(story)}>All chapters</a>
      {
        next?.live ? (
          <a class="walk-nav-link walk-nav-next" href={chapterHref(story, next.slug)}>{next.step}. {next.title} →</a>
        ) : next ? (
          <span class="walk-nav-link walk-nav-next is-disabled" title="Drafting">{next.step}. {next.title} →</span>
        ) : (
          <a class="walk-nav-link walk-nav-next" href={storyHomeHref(story)}>↺ Start the story over</a>
        )
      }
    </nav>
  </div>
</Base>

<style>
  .walk-studylink {
    font-size: 0.9rem;
    border-top: 1px solid var(--bosc-rule);
    padding-top: 0.9rem;
    margin-top: 1.8rem;
  }
  .walk-studylink a {
    font-weight: 700;
    color: var(--bosc-forest);
    text-decoration: none;
  }
  .walk-studylink a:hover {
    text-decoration: underline;
  }
</style>
