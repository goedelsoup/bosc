---
/**
 * The story home (on-ramp) shell (#724/#732) — renders a story's `_home.mdx` (the prose-heavy
 * intro) for every selectable site. The route owns the on-ramp wrapper + the kicker/h1 (from the
 * home frontmatter); the MDX body carries the lead, the promise, the corpus counts, the chapter
 * list (via the provided `StoryChapters`), and the orientation/disclaimer.
 */
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { getCollection, getEntry, render } from "astro:content";
import { STORY_COMPONENTS } from "~/components/story";
import StoryComingSoon from "~/components/story/StoryComingSoon.astro";
import Base from "~/layouts/Base.astro";
import { siteBase } from "@watermark/core/routes";
import { siteRegistersStory, storyComingSoon } from "@watermark/core/sites";
import { storyFor } from "@watermark/core/walk";

export async function getStaticPaths() {
  const entries = await getCollection("stories");
  const paths = [];
  for (const entry of entries) {
    if (!("kind" in entry.data) || entry.data.kind !== "home") continue;
    const [slug, codename] = String(entry.id).split("/");
    // Gate on story REGISTRATION, not switchability (#1466) — see `siteRegistersStory`. Unregistered
    // MDX under `src/content/stories/` still emits nothing, so a drafted story stays unrouted.
    if (!slug || !codename || !siteRegistersStory(slug, codename)) continue;
    const siteId = siteBase(slug).replace("/network/", "");
    const literal = fileURLToPath(
      new URL(`../../../${siteId}/stories/${codename}/index.astro`, import.meta.url),
    );
    if (existsSync(literal)) continue; // a literal index page still serves this URL
    paths.push({ params: { site: siteId, codename }, props: { entryId: entry.id } });
  }
  return paths;
}

const { entryId } = Astro.props as { entryId: string };
const [slug, codename] = String(entryId).split("/");
// A `comingSoon` story (#1526) holds its content: serve the interstitial, not the on-ramp. The gate
// is the boolean ALONE — decoupled from the metadata lookup, so a missing `storyFor` (a `comingSoon`
// registry entry with no chapters in the collection) can never fall through to rendering the on-ramp.
// Title/dek come from the retained registry entry, with a safe fallback. The `_home` MDX stays but is
// never rendered, so no on-ramp prose is reachable by direct URL (#1529).
const held = storyComingSoon(slug, codename);
const heldStory = held ? storyFor(slug, codename) : undefined;
const heldTitle = heldStory?.title ?? codename;
const heldDek = heldStory?.dek ?? "";

const entry = await getEntry("stories", entryId);
if (!entry || !("kind" in entry.data) || entry.data.kind !== "home") {
  throw new Error(`Story home not found: ${entryId}`);
}
const fm = entry.data;
const Content = held ? undefined : (await render(entry)).Content;
// The trail's leaf is the story itself; the codename segment is a URL key, not a name (#1889).
const trailLeaf = storyFor(slug, codename)?.title ?? heldTitle;
---

{
  held ? (
    <Base title={`${heldTitle} — coming soon`} section="story" description={heldDek} trailLeaf={trailLeaf}>
      <StoryComingSoon title={heldTitle} dek={heldDek} slug={slug} />
    </Base>
  ) : (
    <Base title={fm.pageTitle ?? fm.h1} section="story" description={fm.description} trailLeaf={trailLeaf}>
      <div class="walk-onramp">
        {fm.kicker && <div class="walk-kicker">{fm.kicker}</div>}
        <h1>{fm.h1}</h1>
        {Content && <Content components={STORY_COMPONENTS} />}
      </div>
    </Base>
  )
}
