---
/**
 * The Walk editor route (#1096) — hosts the `StoryEditor` client island (the block-by-block
 * authoring canvas). One route serves both new and edit: the island opens a stored Walk when the
 * URL carries `?id=<uuid>`, else starts fresh (seeded from the grab tray). `?preview` renders the
 * design sample with no auth/store.
 *
 * A distinct static filename beside the editorial `stories/[codename]/…` routes, so it never
 * contends with a story codename.
 */
import Base from "~/layouts/Base.astro";
import StoriesDisabled from "~/components/StoriesDisabled.astro";
import StoryEditor from "@watermark/viz/islands/stories/StoryEditor.tsx";
import { withSite } from "@watermark/core/site";
import { activeSite, siteForSlug } from "@watermark/core/sites";
import { storiesUiEnabled, storyToolPaths } from "@watermark/core/storiesFlag";

export const getStaticPaths = storyToolPaths;

const { slug } = Astro.props as { slug: string };
const site = siteForSlug(slug) ?? activeSite();
const enabled = storiesUiEnabled();
const atomsUrl = withSite("/stories-atoms.json");
const readHref = withSite("/stories/read");
---

<Base title={`Compose a story — ${site.place}`} section="stories" rail={false} noindex>
  <div class="story-editor-page">
    {
      enabled ? (
        <StoryEditor client:only="react" siteSlug={slug} atomsUrl={atomsUrl} readHref={readHref} />
      ) : (
        <StoriesDisabled message="The story editor is coming soon.">
          Preview it: <a href="?preview=1">open the editor with a sample story</a>
        </StoriesDisabled>
      )
    }
  </div>
</Base>

<style>
  .story-editor-page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 28px 32px 100px;
  }
</style>
