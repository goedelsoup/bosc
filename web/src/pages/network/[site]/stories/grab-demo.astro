---
/**
 * The grab-affordance demo route (#1096) — hosts the `StoryGrab` island: how a reader grabs an atom
 * (a record, a timeline event, a figure) into a Story-in-progress while reading ordinary site
 * content, and the persistent non-modal tray it drops into. This is the integration reference for
 * wiring grab pins onto real content pages; it renders sample content so the affordance and its
 * states are legible in one place. Always available (no live data), so it isn't gated.
 */
import Base from "~/layouts/Base.astro";
import StoryGrab from "@watermark/viz/islands/stories/StoryGrab.tsx";
import { withSite } from "@watermark/core/site";
import { activeSite, selectableSitePaths, siteForSlug } from "@watermark/core/sites";

export const getStaticPaths = selectableSitePaths;

const { slug } = Astro.props as { slug: string };
const site = siteForSlug(slug) ?? activeSite();
const composeHref = withSite("/stories/compose");
---

<Base title={`Grab an atom — ${site.place}`} section="stories" rail={false} noindex>
  <div class="story-grab-page">
    <StoryGrab client:only="react" composeHref={composeHref} />
  </div>
</Base>

<style>
  .story-grab-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 36px 32px 40px;
  }
</style>
