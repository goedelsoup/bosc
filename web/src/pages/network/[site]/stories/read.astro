---
/**
 * The Story reader route (#1097) — hosts the `StoryReader` client island, which renders a lowered
 * `StoryDocument` (owner-agnostic: a reader-authored or a site-authored Story lower to the same SDM
 * and render identically). The site is pure-static, so this is a single route shell + a client
 * island that reads its target at runtime:
 *   - `?id=<uuid>` — the owner's own Story (fetched from `/api/stories/:id`);
 *   - `?preview=reader|editorial` — a bundled fixture Story, so the design renders full-fidelity with
 *     no auth/store (public share links land in #1098).
 *
 * Sits beside the editorial `stories/[codename]/…` routes — a distinct static filename, so it never
 * contends with a story codename.
 */
import Base from "~/layouts/Base.astro";
import StoriesDisabled from "~/components/StoriesDisabled.astro";
import StoryReader from "@watermark/viz/islands/stories/StoryReader.tsx";
import { withSite } from "@watermark/core/site";
import { activeSite, selectableSitePaths, siteForSlug } from "@watermark/core/sites";
import { storiesUiEnabled } from "@watermark/core/storiesFlag";

export const getStaticPaths = selectableSitePaths;

const { slug } = Astro.props as { slug: string };
const site = siteForSlug(slug) ?? activeSite();
const enabled = storiesUiEnabled();
const atomsUrl = withSite("/stories-atoms.json");
---

<Base
  title={`Story — ${site.place}`}
  section="stories"
  rail={false}
  noindex
  description={`A reader-authored curated walkthrough of the ${site.place} record.`}
>
  <div class="story-page">
    <nav class="story-crumb" aria-label="Breadcrumb">
      <a href={withSite()}>The record</a>
      <span aria-hidden="true">/</span>
      <a href={withSite("/stories/mine")}>Stories</a>
    </nav>

    {
      enabled ? (
        <StoryReader client:only="react" atomsUrl={atomsUrl} />
      ) : (
        <StoriesDisabled message="Reader-authored stories are coming soon.">
          Preview the renderer: <a href="?preview=reader">a reader story</a> ·{" "}
          <a href="?preview=editorial">an editorial story</a>
        </StoriesDisabled>
      )
    }
  </div>
</Base>

<style>
  .story-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 36px 32px 120px;
  }
  .story-crumb {
    display: flex;
    gap: 8px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
    margin-bottom: 22px;
  }
  .story-crumb a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .story-crumb a:hover {
    color: var(--forest);
  }
  .story-crumb span {
    color: var(--ink-ghost);
  }
</style>
