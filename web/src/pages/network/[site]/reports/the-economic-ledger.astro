---
import { openSectionPaths } from "@watermark/core/readiness";
// Only where the section is open (#1894): a locked peer built this route to render the identical
// generic "Reports" lock, seven times over. Its index still builds and still carries that lock.
export function getStaticPaths() {
  return openSectionPaths("reports");
}
/**
 * The economic ledger — the interactive companion to the full report
 * (docs/the-economic-ledger.md, epic #271 flagship #269). The essay holds one
 * discipline: where a load-bearing figure is withheld or non-binding, it is neither
 * blanked nor guessed at a point — it is a band across explicit, sourced scenarios.
 * The simulator makes that band manipulable: turn the four withheld knobs, watch the
 * 15-year public give move, and watch it collapse as each record is produced.
 *
 * Island-over-SSR: the table below is the no-JS fallback (the essay's ledger in a band,
 * computed from the same model the island runs); the simulator is the client island.
 */
import EconLedgerSimulator from "@watermark/viz/islands/EconLedgerSimulator.tsx";
import ReportShell from "~/layouts/ReportShell.astro";
import {
  economicScenarios,
  ledgerConstants,
  priorsFromFeed,
  promisedJobs,
} from "@watermark/core/econScenarios";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { EconomicBaseline } from "@watermark/core/feeds";
import { fmtUsdM } from "@watermark/core/money";
import { withBase, withSite } from "@watermark/core/site";

// Per-site, and now instrument-gated rather than slug-gated (#1642 E4, sharpened by #1665 ME-F).
// The whole ledger prices ONE abatement agreement — its terms, its local effective mills, its
// county sales-and-use rate — so it is computed in Python from that committed instrument and read
// here off the `economics-scenarios` feed. A site with no such agreement on the record has no
// feed: everything below reads null and the page asks for that site's agreement rather than
// pricing its build off another county's mills.
const scenarios = economicScenarios();
const lines = scenarios?.lines ?? null;
const profiles = scenarios?.profiles ?? null;
const constants = ledgerConstants(scenarios);
const priors = priorsFromFeed(scenarios);
const net = lines?.find((l) => l.key === "net") ?? null;
// The site's own non-binding job commitment, read from the instrument's `stated_jobs` — null where
// none is on the record, which drops the whole jobs clause rather than asserting another site's
// promise (#1642, E4).
const jobs = promisedJobs(scenarios);

// The county employment baseline the promised jobs is read against — the `economics-baseline` feed's
// cited `total_employment` (QCEW, self-dating via `asof`), replacing a hand-copied constant that
// had gone a vintage stale (#1642, E2).
// ⚠️ `Astro.props` FIRST, and the slug passed EXPLICITLY (#2005). With an arrow-form
// `getStaticPaths` and no other `Astro` reference, Astro's compiler hoists this whole frontmatter
// to MODULE scope, where it evaluates ONCE for the entire build — outside the middleware's
// `runWithSite`, so ambient reads silently fall back to Lima and every site renders Lima's data.
// The function declaration above keeps it per-render; this destructure is also the tripwire (it
// throws at build if it is ever hoisted again) and the explicit slug makes the reads correct
// regardless of what the compiler decides to hoist.
const { slug } = Astro.props as { slug: string };
const eb = hasFeed("economics-baseline", slug)
  ? loadFeed<EconomicBaseline>("economics-baseline", slug)
  : null;
const countyJobs = eb?.latest.total_employment?.value ?? null;
const countyJobsAsof = eb?.latest.total_employment?.asof ?? null;
---

<ReportShell
  title="The economic ledger"
  description="The public extended a 15-year abatement, roadwork, and a sales-tax exemption to a ~$500M build for ~50 jobs. Four withheld numbers move the public give by tens of millions. Turn the knobs, price the opacity, and watch the band collapse as each record is produced."
  eyebrow="Extension narrative · #233 · the cost of opacity"
  h1="The ledger, as a band you can move"
  annexChapters={["balance"]}
>
  <Fragment slot="lead">
      <p class="section-lead">
        The whole assessment hinges on <strong>four withheld or non-binding inputs</strong>:
        the building share of the $500M, the real job count, whether the campus takes the
        sales-tax exemption, and the School District Compensation the county won't disclose.
        None is invented here; each is turned across its industry-reference band
        <em>(industry reference, not this campus)</em>. The simulator prices the opacity —
        and shows, record by record, exactly how much disclosure would narrow it.
      </p>

      <p class="section-lead unc-ssr-lead">
        Net 15-year public give:
        <strong>{net ? `${fmtUsdM(net.band.low)} – ${fmtUsdM(net.band.high)}` : "tens of millions"}</strong>
        {jobs !== null && (
          <Fragment> for ~{jobs} jobs{countyJobs !== null && (
            <Fragment> — about <strong>{((jobs / countyJobs) * 100).toFixed(1)}%</strong> of the
            county's {Math.round(countyJobs).toLocaleString("en-US")} covered jobs
            {countyJobsAsof && <Fragment> ({countyJobsAsof})</Fragment>}</Fragment>
          )}</Fragment>
        )}.
        Full essay: <a href={withBase("/docs/the-economic-ledger")}>the economic ledger →</a>
      </p>
  </Fragment>

    {profiles && constants && priors && countyJobs !== null ? (
      <EconLedgerSimulator
        client:only="react"
        profiles={profiles}
        constants={constants}
        priors={priors}
        countyJobs={countyJobs}
      />
    ) : null}

    {/* No-JS fallback: the essay's ledger in a band, computed from the same model. */}
    {lines && profiles ? (
    <noscript>
      <article class="prose">
        <h2>The fifteen-year ledger, in a band</h2>
        <table>
          <thead><tr><th>Line</th><th>15-year figure</th><th>Register</th></tr></thead>
          <tbody>
            {lines.map((l) => (
              <tr>
                <td>{l.label}</td>
                <td>{fmtUsdM(l.band.low)} – {fmtUsdM(l.band.high)}</td>
                <td><code>[{l.tag}]</code></td>
              </tr>
            ))}
          </tbody>
        </table>
        <h3>The four profiles</h3>
        <table>
          <thead><tr><th>Profile</th><th>Build share</th><th>Jobs</th><th>Abatement</th><th>Per job</th></tr></thead>
          <tbody>
            {profiles.map((p) => (
              <tr>
                <td>{p.label}</td>
                <td>{Math.round(p.building_share * 100)}%</td>
                <td>{p.jobs}</td>
                <td>{fmtUsdM(p.abatement_usd)}</td>
                <td>{fmtUsdM(p.abatement_per_job_usd)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>The record pins none of these. Enable JavaScript to turn the knobs and collapse the band.</p>
      </article>
    </noscript>
    ) : (
    /* No abatement instrument on this site's record (#1642 E4 / #1665): the `economics-scenarios`
       feed is instrument-gated, so its absence IS the statement — this site has no agreement whose
       terms and local mills could be priced. Lock the ledger and ask for it. */
    <div class="callout callout--open">
      <p class="callout-title">No abatement agreement on record for this site</p>
      <p>
        This ledger prices one specific instrument — a Community Reinvestment Area agreement,
        with its own abated percentage and term, its local effective mills, and its county
        sales-and-use rate. Those are one county's numbers, not a general model of an abatement,
        so the give for this site stays <code>[open]</code> rather than being computed off
        another county's terms.
        Have this site's agreement? <a href={withSite("/submit")}>Submit it →</a>
      </p>
    </div>
    )}</ReportShell>
