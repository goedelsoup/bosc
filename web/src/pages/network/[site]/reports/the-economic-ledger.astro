---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
/**
 * The economic ledger — the interactive companion to the full report
 * (docs/the-economic-ledger.md, epic #271 flagship #269). The essay holds one
 * discipline: where a load-bearing figure is withheld or non-binding, it is neither
 * blanked nor guessed at a point — it is a band across explicit, sourced scenarios.
 * The simulator makes that band manipulable: turn the four withheld knobs, watch the
 * 15-year public give move, and watch it collapse as each record is produced.
 *
 * Island-over-SSR: the table below is the no-JS fallback (the essay's ledger in a band,
 * computed from the same model the island runs); the simulator is the client island.
 */
import EconLedgerSimulator from "@watermark/viz/islands/EconLedgerSimulator.tsx";
import ReportShell from "~/layouts/ReportShell.astro";
import { ledgerLines, ledgerProfiles } from "@watermark/core/econLedger";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { EconomicBaseline } from "@watermark/core/feeds";
import { fmtUsdM } from "@watermark/core/money";
import { withBase, withSite } from "@watermark/core/site";

// Per-site (#1642, E4): the whole ledger is Allen County's CRA (Res #548-25's terms, ~63 local
// mills, the 7.25% county sales-and-use rate). `ledgerLines`/`ledgerProfiles` answer only for the
// site whose instrument it is — a peer reads null and this page asks for that site's agreement
// rather than pricing its build off another county's mills.
const site = Astro.locals.site;
const lines = ledgerLines(site);
const profiles = ledgerProfiles(site);
const net = lines?.find((l) => l.key === "net") ?? null;

// The county employment baseline the ~50 jobs is read against — the `economics-baseline` feed's
// cited `total_employment` (QCEW, self-dating via `asof`), replacing a hand-copied constant that
// had gone a vintage stale (#1642, E2).
const eb = hasFeed("economics-baseline") ? loadFeed<EconomicBaseline>("economics-baseline") : null;
const countyJobs = eb?.latest.total_employment?.value ?? null;
const countyJobsAsof = eb?.latest.total_employment?.asof ?? null;
---

<ReportShell
  title="The economic ledger"
  description="The public extended a 15-year abatement, roadwork, and a sales-tax exemption to a ~$500M build for ~50 jobs. Four withheld numbers move the public give by tens of millions. Turn the knobs, price the opacity, and watch the band collapse as each record is produced."
  eyebrow="Extension narrative · #233 · the cost of opacity"
  h1="The ledger, as a band you can move"
>
  <Fragment slot="lead">
      <p class="section-lead">
        The whole assessment hinges on <strong>four withheld or non-binding inputs</strong>:
        the building share of the $500M, the real job count, whether the campus takes the
        sales-tax exemption, and the School District Compensation the county won't disclose.
        None is invented here; each is turned across its industry-reference band
        <em>(industry reference, not this campus)</em>. The simulator prices the opacity —
        and shows, record by record, exactly how much disclosure would narrow it.
      </p>

      <p class="section-lead unc-ssr-lead">
        Net 15-year public give:
        <strong>{net ? `${fmtUsdM(net.band.low)} – ${fmtUsdM(net.band.high)}` : "tens of millions"}</strong>
        for ~50 jobs{countyJobs !== null && (
          <Fragment> — about <strong>{((50 / countyJobs) * 100).toFixed(1)}%</strong> of the county's
          {" "}{Math.round(countyJobs).toLocaleString("en-US")} covered jobs
          {countyJobsAsof && <Fragment> ({countyJobsAsof})</Fragment>}</Fragment>
        )}.
        Full essay: <a href={withBase("/docs/the-economic-ledger")}>the economic ledger →</a>
      </p>
  </Fragment>

    {profiles && countyJobs !== null ? (
      <EconLedgerSimulator client:only="react" profiles={profiles} countyJobs={countyJobs} />
    ) : null}

    {/* No-JS fallback: the essay's ledger in a band, computed from the same model. */}
    {lines && profiles ? (
    <noscript>
      <article class="prose">
        <h2>The fifteen-year ledger, in a band</h2>
        <table>
          <thead><tr><th>Line</th><th>15-year figure</th><th>Register</th></tr></thead>
          <tbody>
            {lines.map((l) => (
              <tr>
                <td>{l.label}</td>
                <td>{fmtUsdM(l.band.low)} – {fmtUsdM(l.band.high)}</td>
                <td><code>[{l.register}]</code></td>
              </tr>
            ))}
          </tbody>
        </table>
        <h3>The four profiles</h3>
        <table>
          <thead><tr><th>Profile</th><th>Build share</th><th>Jobs</th><th>Abatement</th><th>Per job</th></tr></thead>
          <tbody>
            {profiles.map((p) => (
              <tr>
                <td>{p.label}</td>
                <td>{Math.round(p.buildingShare * 100)}%</td>
                <td>{p.jobs}</td>
                <td>{fmtUsdM(p.abatementUsd)}</td>
                <td>{fmtUsdM(p.abatementPerJobUsd)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>The record pins none of these. Enable JavaScript to turn the knobs and collapse the band.</p>
      </article>
    </noscript>
    ) : (
    /* No abatement instrument on this site's record (#1642, E4): the ledger is Allen County's CRA
       — Res #548-25's terms and its local mills — so pricing this site's build off it would be
       fabrication. Lock the ledger and ask for the agreement. */
    <div class="callout callout--open">
      <p class="callout-title">No abatement agreement on record for this site</p>
      <p>
        This ledger prices one specific instrument: the Allen County CRA (Res #548-25) — its
        75%/15-year terms, its local effective mills, its county sales-and-use rate. Those are
        that county's numbers, not a general model of an abatement, so the give for this site
        stays <code>[open]</code> rather than being computed off another county's terms.
        Have this site's agreement? <a href={withSite("/submit")}>Submit it →</a>
      </p>
    </div>
    )}</ReportShell>
