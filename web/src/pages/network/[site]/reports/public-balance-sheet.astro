---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
/**
 * The public balance sheet (epic #271 Phase 4 capstone, #273) — the meta-view that
 * composes every narrative's band on one sheet and prices the opacity in aggregate. No
 * new data: it reads the existing consumer models through the shared UncertainOutcome
 * contract. Reads as a map of what isn't known, not a verdict.
 *
 * Island-over-SSR: the table is the no-JS fallback (the bands, precomputed from the same
 * models). The toxics band needs the feed's discharge constants (buildDilution) — passed
 * to the island so the balance sheet never forks the narratives.
 */
import BalanceSheet from "@watermark/viz/islands/BalanceSheet.tsx";
import ReportShell from "~/layouts/ReportShell.astro";
import { type BalanceUnit, type GridItLoad, buildBalanceSheet } from "@watermark/core/balanceSheet";
import { buildDilution } from "@watermark/core/dilution";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { FacilityItem } from "@watermark/core/feeds";
import { fmtUsdM } from "@watermark/core/money";
import { withSite } from "@watermark/core/site";

const dc = buildDilution().discharge;
const effluentCfs = dc.wwtpCfs + dc.campusFm2Cfs;

// #1632: source the grid row's IT-load from the facility feed so this sheet matches the load
// report and /basin. Null ⇒ buildBalanceSheet falls back to the Lima GRID_PRIORS default.
const facilities = hasFeed("facility") ? loadFeed<FacilityItem[]>("facility") : [];
const primary = facilities.find((f) => f.is_primary) ?? facilities[0];
const gridItLoad: GridItLoad | null =
  primary?.it_load_mw != null
    ? { central: primary.it_load_mw, low: primary.it_load_low_mw, high: primary.it_load_high_mw }
    : null;
const sheet = buildBalanceSheet(effluentCfs, dc.naturalCfs, Astro.locals.site, gridItLoad);

const fmt = (n: number, unit: BalanceUnit): string =>
  unit === "usd" ? fmtUsdM(n) : unit === "mw" ? `${Math.round(n)} MW` : `${n.toFixed(0)}%`;
// Null for a site with no abatement instrument on the record (#1642, E4) — the lead then states
// the withheld-record count instead of another county's dollar exposure.
const e = sheet.econExposure;
---

<ReportShell
  title="The public balance sheet"
  description="Every narrative's band on one register-encoded sheet — the economic give, the load, the river — and the cost of opacity in aggregate: the public's exposure rides on records the county won't produce, and disclosing them collapses the band."
  eyebrow="Extension narrative · #233 · the capstone"
  h1="The cost of opacity, on one sheet"
>
  <Fragment slot="lead">
      <p class="section-lead">
        Each report ends <code>[open]</code> for the same reason — a figure the record
        withholds. Set them side by side and the pattern becomes a quantity:
        {e ? (
          <Fragment> the public's monetized 15-year exposure runs
          <strong> {fmtUsdM(e.low)} – {fmtUsdM(e.high)}</strong>, and it rides on</Fragment>
        ) : (
          <Fragment> the bands below rest on</Fragment>
        )}
        <strong> {sheet.resolvingRecords.length} records the county has not produced</strong>.
        This page composes every band the narratives compute — it adds no new data, and it
        returns no verdict. It is a map of what isn't known, and what would close it.
      </p>
  </Fragment>

    <BalanceSheet client:only="react" toxicsEffluentCfs={effluentCfs} toxicsNaturalCfs={dc.naturalCfs} site={Astro.locals.site} gridItLoad={gridItLoad} />

    <noscript>
      <article class="prose">
        <h2>The bands</h2>
        <table>
          <thead><tr><th>Narrative</th><th>Band</th><th>Register</th><th>What would resolve it</th></tr></thead>
          <tbody>
            {sheet.rows.map((row) => (
              <tr>
                <td>{row.narrative}</td>
                <td>{fmt(row.outcome.low, row.unit)} – {fmt(row.outcome.high, row.unit)}</td>
                <td><code>[{row.outcome.register}]</code></td>
                <td>{row.outcome.resolvingRecord}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>
          {sheet.resolvingRecords.length} withheld records span the public's exposure. Enable JavaScript for
          the register-encoded bands; the <a href={withSite("/site/legal/corpus-completeness-audit")}>corpus
          audit</a> tracks what's missing.
        </p>
      </article>
    </noscript>
</ReportShell>
