---
/**
 * Redirect: the retired site-scoped methodology (#1132).
 *
 * Methodology is now the network-global `/methodology` hub (epic #1126), not a
 * per-site narrative doc — it was dropped from `lib/narrative.ts`, so the old
 * `/network/[site]/docs/methodology` route no longer generates from `[...slug].astro`.
 * This static catch page takes its place (a named segment out-prioritizes the rest
 * route) and redirects there. `Astro.redirect()` is SSR-only, so in the static build
 * this is an HTML meta-refresh + canonical, one page per selectable site.
 */
import { withBase } from "~/lib/base";
import { selectableSitePaths } from "~/lib/sites";

export function getStaticPaths() {
  return selectableSitePaths();
}

const target = withBase("/methodology");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Methodology moved</title>
  </head>
  <body>
    <p>The methodology now lives at <a href={target}>/methodology</a>. Redirecting…</p>
  </body>
</html>
