---
import { selectableSitePaths, siteForSlug } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
import Base from "~/layouts/Base.astro";
import FigureStat from "~/components/FigureStat.astro";
import HubLede from "~/components/HubLede.astro";
import { hasFeed, loadManifest } from "@watermark/core/bundle";
import { buildDilution, dilutionMultiple } from "@watermark/core/dilution";
import { fmtMult } from "@watermark/core/format";
import type { FigureStatData } from "@watermark/core/viz";
import { withSite } from "@watermark/core/site";

const { slug } = Astro.props as { slug: string };
const site = siteForSlug(slug);

// The lede (#1891). The 7Q10 used to be a decoration in the corner of the head — "Ottawa River ·
// 7Q10 ≈ 0.2 cfs", a string gated to the reference build because it was Lima's number written
// out. It's the whole thesis of the section, so it leads the page now, and every figure comes
// from THIS site's `hydrology-scenarios` feed via `buildDilution` — including the river's name
// (#1891 added `receivingWater`). A site whose feed carries no buildout scenario reads
// `fromFeed: false` and gets the honest absence; nothing here falls back to Lima's floors.
const dil = buildDilution();
const annual = dil.floors.find((f) => f.key === "annual") ?? null;
const river = dil.receivingWater;
// The multiple is only meaningful against a floor the feed actually cites — and `dilutionMultiple`
// returns Infinity on a zero floor (the river is gone), which is a real reading but not a figure.
const multiple = annual && annual.cfs > 0 ? dilutionMultiple(dil.drawAtBuildoutCfs, annual.cfs) : null;
const cfs = (n: number): string => (n >= 10 ? n.toFixed(0) : n.toFixed(n < 1 ? 2 : 1));

const ledeFigures: FigureStatData[] = [
  ...(dil.ottawaLiveCfs != null
    ? [
        {
          label: "Flow today",
          value: cfs(dil.ottawaLiveCfs),
          unit: "cfs",
          evidence: "verified" as const,
          sub: "USGS gage",
        },
      ]
    : []),
  ...(annual
    ? [
        {
          label: "Design low flow",
          value: cfs(annual.cfs),
          unit: "cfs",
          evidence: "verified" as const,
          sub: annual.label,
        },
      ]
    : []),
  ...(dil.drawAtBuildoutCfs > 0
    ? [
        {
          label: "Buildout draw",
          value: cfs(dil.drawAtBuildoutCfs),
          unit: "cfs",
          evidence: "inference" as const,
          basis: "modeled" as const,
          sub: `${dil.maxCoolingMgd} MGD cooling`,
        },
      ]
    : []),
  ...(dil.discharge.effluentPct > 0
    ? [
        {
          label: "Effluent share",
          value: String(dil.discharge.effluentPct),
          unit: "%",
          evidence: "verified" as const,
          sub: "at design low flow",
        },
      ]
    : []),
];

const manifest = loadManifest();
const byName = new Map(manifest.feeds.map((f) => [f.name, f]));
const count = (n: string): number => byName.get(n)?.count ?? 0;
const num = (n: number): string => n.toLocaleString("en-US");
const geoMapLayers = manifest.feeds.filter(
  (f) => f.name.startsWith("geo/") && f.name !== "geo/imagery",
).length;

interface Door {
  id: string;
  kind: string;
  href: string;
  count: string;
  title: string;
  desc: string;
  note: string;
}
const doors: Door[] = [
  {
    id: "hydrology",
    kind: "Analysis",
    href: withSite("/environment/hydrology"),
    count: num(count("hydrology-scenarios")),
    title: "Hydrology",
    desc: "Water-balance / low-flow dilution screen — live flow vs the 7Q10 design low flow, and the headroom that remains.",
    note: "dashboard",
  },
  {
    id: "map",
    kind: "Interactive map",
    href: withSite("/environment/map"),
    count: num(geoMapLayers),
    title: "Watershed map",
    desc: "Typed GeoJSON layers on deck.gl + MapLibre — campus, corridor, floodway, WWTP, RSEI, watershed.",
    note: "interactive",
  },
  {
    id: "imagery",
    kind: "Aerial imagery",
    href: withSite("/environment/imagery"),
    count: "—",
    title: "Imagery",
    desc: "Dated Esri Wayback aerials over the campus AOI — before / during / after the buildout.",
    note: "before / after",
  },
  {
    id: "rsei",
    kind: "External data",
    href: withSite("/environment/rsei"),
    count: num(count("geo/rsei")),
    title: "RSEI / toxics",
    desc: "EPA RSEI toxic-release inventory on the same reaches the campus discharges to.",
    note: "release sites",
  },
];
if (hasFeed("enclave")) {
  // #1664 — present only where the site's facility is a federal installation. It sits in the
  // environment hub because four of its five dimensions (land, water, wastewater, toxics) are,
  // and because the RSEI county-scope severance it states belongs beside the RSEI door above.
  doors.push({
    id: "enclave",
    kind: "Federal registers",
    href: withSite("/environment/enclave"),
    count: "—",
    title: "The federal enclave",
    desc: "The installation's own land, water systems, NPDES outfalls and toxics — assembled from the DoD and EPA registers that see a base the county instruments cannot.",
    note: "off the county rolls",
  });
}
if (hasFeed("air-dispersion-field")) {
  doors.push({
    id: "air",
    kind: "Interactive field",
    href: withSite("/environment/air"),
    count: "—",
    title: "Air dispersion",
    desc: "A Tier-1 AERMOD screening field of criteria-pollutant concentrations over the campus grid — modeled, [inference].",
    note: "modeled screen",
  });
}
if (hasFeed("water-seasonal-field")) {
  doors.push({
    id: "seasonal",
    kind: "Interactive field",
    href: withSite("/environment/seasonal"),
    count: "—",
    title: "Seasonal withdrawal",
    desc: "A month-by-month climograph of net atmospheric withdrawal (ET0 − precip) with the cooling draw read against the cited seasonal low flow.",
    note: "climograph",
  });
}
if (hasFeed("reach-network")) {
  doors.push({
    id: "flow",
    kind: "Interactive flow",
    href: withSite("/environment/flow"),
    count: "—",
    title: "Water flow",
    desc: "GPU particles advecting down the real reach-network river centerlines — density/speed encode the routed storm peak, deficit reaches oxblood. Modeled, [inference].",
    note: "animated flow",
  });
}
if (hasFeed("thermal")) {
  doors.push({
    id: "thermal",
    kind: "Analysis",
    href: withSite("/environment/thermal"),
    count: num(count("thermal")),
    title: "Thermal discharge",
    desc: "The receiving water's heat budget — the campus's modeled cooling heat load and the corridor's own reported effluent temperatures against Ohio's numeric temperature criterion, framed as CWA §316(a).",
    note: "§316(a) screen",
  });
}
if (hasFeed("drawdown") || hasFeed("dewatering")) {
  doors.push({
    id: "groundwater",
    kind: "Analysis",
    href: withSite("/environment/groundwater"),
    count: num(count("dewatering")),
    title: "Groundwater",
    desc: "The area well concerns — the hypothetical drawdown cone, the documented construction-dewatering wellfield and the domestic wells it drew down, and a river-record screen for where that pumped water went.",
    note: "well drawdown",
  });
}
// The economics baseline is economic ground, not environmental — its door lives on the economy
// hub (#1323), so it's intentionally absent here even though the feed is present.
---

<Base title="The environment" section="environment" rail={false}>
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">Section · the environment</div>
        <h1>The environment it sits in</h1>
        <p class="hub-lead">
          Stormwater and water-balance modeling of the {site?.place} municipal loop, the
          watershed map, dated imagery, and the RSEI toxic-release picture.
        </p>
      </div>
      <span class="hub-count">{river ? `${river} · ${site?.basin}` : site?.basin}</span>
    </div>

    <HubLede
      label="The reading right now"
      absent={dil.fromFeed
        ? null
        : `No buildout cooling scenario has been run for ${site?.place ?? "this site"} yet, so this hub has no dilution reading of its own — and it will not borrow the reference build's river. The doors below open what the site's bundle does carry; the water screen turns on when a cited design low flow and a disclosed cooling demand land.`}
      cite={`Every figure from this site's hydrology-scenarios feed — the cited design low flows${dil.ottawaLiveCfs != null ? ", the USGS gage" : ""}, and the modeled buildout draw. ${dil.discharge.cite}.`}
      href={withSite("/environment/hydrology")}
      cta="Open the water screen"
    >
      <p class="hublede-say">
        {river ?? "The receiving water"} runs at
        <span class="num">{annual ? ` ${cfs(annual.cfs)} cfs` : " a low flow the record has not cited"}</span>
        {annual && " when the drought design condition bites"} — and the campus's modeled buildout
        draw of <span class="num">{cfs(dil.drawAtBuildoutCfs)} cfs</span>
        {multiple !== null && (
          <Fragment> is <strong>{fmtMult(multiple)} the whole river</strong> at that floor</Fragment>
        )}. Downstream it is already
        <span class="num"> {dil.discharge.effluentPct}%</span> treated effluent.
      </p>
      <div class="hublede-figures">
        {ledeFigures.map((s) => <FigureStat stat={s} size="sm" />)}
      </div>
    </HubLede>

    <div class="hub-grid">
      {
        doors.map((d) => (
          <a class="hub-door" id={d.id} href={d.href}>
            <div class="hub-door-top">
              <span class="hub-door-kind">{d.kind}</span>
              <span class="hub-door-count">{d.count}</span>
            </div>
            <div class="hub-door-title">{d.title}</div>
            <div class="hub-door-desc">{d.desc}</div>
            <div class="hub-door-foot">
              <span class="hub-door-browse">Browse</span>
              <span class="hub-door-note">{d.note}</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
