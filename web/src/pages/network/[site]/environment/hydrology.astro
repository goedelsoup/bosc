---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
import Base from "~/layouts/Base.astro";
import FigureStat from "~/components/FigureStat.astro";
import AquiferSection from "~/components/charts/AquiferSection.astro";
import BulletChart from "~/components/charts/BulletChart.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type {
  AssimilativeCheck,
  CoolingModel,
  DewateringReport,
  DrawdownReport,
  FacilityItem,
  ProvenancedValue,
  ScenarioResult,
} from "@watermark/core/feeds";
import type { FigureStatData } from "@watermark/core/viz";
import { withSite } from "@watermark/core/site";
import { fmtRanged } from "@watermark/core/format";

const scenarios = hasFeed("hydrology-scenarios") ? loadFeed<ScenarioResult[]>("hydrology-scenarios") : [];

// The primary facility's disclosed IT-load range (#1632), for the load→water chain head. The
// range is the power-side uncertainty the consumptive bracket now reflects; it lives on the
// `facility` feed (the same figure the load report and /basin source).
const facilities = hasFeed("facility") ? loadFeed<FacilityItem[]>("facility") : [];
const primaryFacility = facilities.find((f) => f.is_primary) ?? facilities[0];
const itLoadRange =
  primaryFacility?.it_load_low_mw != null && primaryFacility?.it_load_high_mw != null
    ? `${primaryFacility.it_load_low_mw}–${primaryFacility.it_load_high_mw}`
    : null;

const numOf = (v: ProvenancedValue): string => (v.value == null ? "—" : v.value.toLocaleString("en-US"));
// document/connector-sourced values are grounded; assumption/derived are inferred.
const grounded = (v: ProvenancedValue): boolean =>
  v.source === "document" || v.source === "connector" || v.source === "reference";
// Renders the value with its uncertainty band when one is present (#760) — "226 ± ~45 ac"
// / "226 (181–271 ac)" — falling back to the bare value otherwise.
const fmt = (v: ProvenancedValue): string => fmtRanged(v);

/** Map a provenanced metric onto the unified figure/stat treatment. */
const toStat = (label: string, v: ProvenancedValue, neg?: boolean): FigureStatData => ({
  label,
  value: numOf(v),
  unit: v.unit ?? undefined,
  evidence: grounded(v) ? "verified" : "inference",
  basis: grounded(v) ? "grounded" : "modeled",
  sub: v.citation ?? v.source ?? undefined,
  warn: neg,
});

// The cooling archetype labels (epic #1060). The enum is keyed on mechanism; "open loop /
// closed loop" are the industry's ambiguous labels, shown only as parenthetical aliases.
const COOLING_LABELS: Record<CoolingModel, string> = {
  off: "no cooling-water load",
  evaporative_tower: "evaporative cooling tower (“open loop”)",
  once_through: "once-through surface water (“open once-through”)",
  closed_loop_dry: "closed-loop dry / air-cooled (“closed loop”)",
  hybrid_adiabatic: "hybrid dry + seasonal adiabatic assist",
  unknown: "undisclosed cooling method",
};
const coolingOf = (s: ScenarioResult): CoolingModel | null =>
  s.cooling_model ?? s.scenario.cooling_model ?? null;
// A bracketed basis (undisclosed method, #1057) must never render a single headline.
const bracketed = (s: ScenarioResult): boolean =>
  coolingOf(s) === "unknown" || s.scenario.basis?.is_bracketed === true;

// Headline screen (#306): the worst-case scenario by *modeled* consumptive draw — picked
// from the data, not by name — against the river's grounded 7Q10 design low flow. The
// bullet keeps each row's own evidence register: the draw is inferred (amber), the design
// low flow is document-grounded (verified). Drawn straight from the feed; no fork.
// A bracketed (undisclosed-method) scenario is excluded: its "draw" is an envelope, not
// an estimate — the range panel below carries it instead (#1057).
const candidates = scenarios.filter((s) => !bracketed(s));
const worst =
  candidates.length > 0
    ? candidates.reduce((a, b) => ((b.consumptive_loss.value ?? 0) > (a.consumptive_loss.value ?? 0) ? b : a))
    : null;
const drawV = worst?.consumptive_loss ?? null;
const lowV = worst?.receiving_7q10 ?? null;
const liveV = worst?.receiving_live ?? null;
// Per-site receiving water (#900); the fallback reads generically, never another site's river.
const riverName = scenarios.map((s) => s.receiving_water_name).find(Boolean) ?? "receiving water";
const showScreen = worst != null && (drawV?.value ?? 0) > 0 && (lowV?.value ?? 0) > 0;
const drawRatio = showScreen ? Math.round((drawV!.value as number) / (lowV!.value as number)) : 0;

// The groundwater peer of the reservoir-drawdown screen (#well-drawdown): a Theis cone of
// depression over the ODNR well-log census. All [inference], bracketed — its headline is the
// inverse finding, that a hyperscale groundwater stress dewaters the aquifer, corroborating
// the campus's reliance on municipal surface water. Gated on the feed (reference-only today).
const drawdown = hasFeed("drawdown") ? loadFeed<DrawdownReport>("drawdown") : null;
const ddFt = drawdown?.drawdown_at_well_ft.value ?? 0;
const ddRadius = drawdown?.radius_of_influence_ft.value ?? null;
const ddPumping = drawdown?.scenario.pumping_mgd.value ?? null;
const ddWellsN = drawdown?.affected_domestic_wells ?? null;
const ddLabel = drawdown == null ? "" : drawdown.dewaters ? `${ddFt} ft — dewaters` : `${ddFt} ft`;
// Illustrative domestic-well casings (a schematic cross-section, not a map); the real count
// is carried in the caption. Placed inside the cone to read as "wells near the pumping well".
const ddWells = [
  { x: 0.12, depthFrac: 0.35, label: "domestic wells" },
  { x: 0.34, depthFrac: 0.52 },
  { x: 0.72, depthFrac: 0.42 },
];
const ddCaption =
  drawdown == null
    ? ""
    : `${ddWellsN?.toLocaleString("en-US") ?? "—"} domestic census wells within the ${ddRadius?.toLocaleString("en-US") ?? "—"} ft radius of influence, for a hypothetical ${ddPumping ?? "—"} MGD groundwater stress. The campus draws municipal surface water; no groundwater withdrawal is on record.`;

// The DOCUMENTED peer of the drawdown screen (#well-drawdown): the construction-dewatering
// wellfield the developer installed to grade the site, as a superposition of Cooper-Jacob cones
// over the ODNR census. Where `drawdown` is hypothetical, this is on the record — the wells/rates/
// dates are [verified], every drawdown [inference]. Gated on the feed (reference-only today).
const dewatering = hasFeed("dewatering") ? loadFeed<DewateringReport>("dewatering") : null;
const dwOver5 = dewatering
  ? dewatering.impacted_wells.filter((w) => (w.composite_drawdown_ft.value ?? 0) > 5).length
  : 0;
const dwMiles = (ft: number): string => (ft / 5280).toFixed(2);
---

<Base title="Hydrology" section="environment">
  <article class="prose">
    <h1>Hydrology — water balance</h1>
    <p class="section-lead">
      Each scenario screens the {riverName}'s low-flow capacity against the
      campus's consumptive cooling draw: live flow minus consumptive loss against
      the 7Q10 design low flow, and the assimilative headroom that remains. Live
      gauge and permit figures are <strong>grounded</strong>; scenario draws are
      labelled assumptions.
    </p>
    <p class="card-meta">
      A written walk-through of this screen — including the newly document-sourced
      sanitary figures — is in the
      <a href={withSite("/site/legal/water-balance-screen")}>water-balance assimilative screen</a> memo.
    </p>

    {
      showScreen && drawV && lowV && worst && (
        <BulletChart
          kicker="Bullet · draw vs design low flow"
          title={`At the 7Q10 design low flow, the ${worst.scenario.name} cooling draw dwarfs the river`}
          scaleLabel="scale · cubic feet per second"
          unit="cfs"
          rows={[
            {
              label: `Consumptive draw · ${worst.scenario.name}`,
              value: drawV.value as number,
              fill: "#9a6a14",
              evidence: grounded(drawV) ? "verified" : "inference",
              evidenceNote: drawV.citation ?? drawV.source ?? undefined,
            },
            {
              label: `${riverName} 7Q10 design low flow`,
              value: lowV.value as number,
              evidence: grounded(lowV) ? "verified" : "inference",
              evidenceNote: lowV.citation ?? lowV.source ?? undefined,
            },
          ]}
          note={`The modeled ${worst.scenario.name} cooling draw (${fmt(drawV)}) is about ${drawRatio}× the ${riverName}'s 7Q10 design low flow (${fmt(lowV)}) — the drought flow Ohio writes discharge permits at. This is a basin-scale worst-case bound, not a river withdrawal: Lima draws treated water from five off-stream reservoirs (~15 BG) filled from the Auglaize and Ottawa at high flow, so the operating constraint is reservoir drawdown, not instantaneous river depletion.${liveV?.value != null ? ` Live flow today (${fmt(liveV)}) is far higher, but the screen is written for the dry floor.` : ""}`}
        />
      )
    }

    {
      drawdown && (
        <Fragment>
          <h2>Groundwater — the area well concerns</h2>
          <p class="card-meta">
            The screen above is the <em>surface-water</em> constraint. Its groundwater peer asks
            what a well field supplying the campus makeup would do to the aquifer the county's{" "}
            <strong>{drawdown.affected_domestic_wells?.toLocaleString("en-US") ?? "—"}</strong>{" "}
            nearby domestic wells tap — a Theis cone of depression over the ODNR well-log census.
          </p>
          <AquiferSection
            title={`Groundwater drawdown — ${drawdown.material} aquifer cone of depression`}
            drawdownFt={ddFt}
            drawdownLabel={ddLabel}
            wells={ddWells}
            evidence="inference"
            source={drawdown.scenario.pumping_mgd.citation ?? undefined}
            caption={ddCaption}
          />
          <p class="card-meta">
            {drawdown.dewaters
              ? `At the low-transmissivity end of the bracket the cone exceeds the ${drawdown.saturated_thickness_ft ?? "—"} ft saturated thickness — the aquifer cannot sustain this rate, which is exactly why the campus is on municipal surface water.`
              : "The cone stays within the saturated thickness at this stress."}{" "}
            Pumping is a hypothetical{" "}
            <strong>[inference]</strong> stress, bracketed by the aquifer's transmissivity
            uncertainty; it is not a documented groundwater withdrawal.
          </p>
        </Fragment>
      )
    }

    {
      dewatering && (
        <Fragment>
          <h2>Construction dewatering — the documented drawdown</h2>
          <p class="card-meta">
            The cone above is hypothetical. This one is on the record: to grade the campus the
            developer installed <strong>{dewatering.well_count}</strong> construction-dewatering
            wells (~{dewatering.total_capacity_mgd} MGD of combined yield-test capacity), pumped{" "}
            {dewatering.operating_window}. As a superposition of their Cooper-Jacob cones over the
            ODNR well-log census,{" "}
            <strong>{dewatering.impacted_wells.length}</strong> nearby domestic wells fall inside
            the composite cone with more than a foot of <strong>[inference]</strong> drawdown
            {dwOver5 > 0 ? ` (${dwOver5} with more than five feet)` : ""}. The wells, rates, and
            dates are <strong>[verified]</strong> ODNR well-log and sealing records; every drawdown
            is <strong>[inference]</strong>, bracketed by the aquifer's transmissivity uncertainty.
          </p>
          {dewatering.impacted_wells.length > 0 && (
            <table class="dewatering-table">
              <thead>
                <tr>
                  <th>Domestic well</th>
                  <th>Distance</th>
                  <th>Drawdown (ft) [inference]</th>
                  <th>Aquifer</th>
                </tr>
              </thead>
              <tbody>
                {dewatering.impacted_wells.map((w) => (
                  <tr>
                    <td>{w.object_id}</td>
                    <td>{dwMiles(w.distance_ft)} mi</td>
                    <td>{fmt(w.composite_drawdown_ft)}</td>
                    <td>{w.aquifer_type ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          <p class="card-meta">
            {dewatering.active_count > 0
              ? `${dewatering.active_count} of the ${dewatering.well_count} wells remained active as of the ${dewatering.as_of} records pull; the rest were sealed at the close of grading. `
              : ""}
            See the wellfield and the wells it draws down on the{" "}
            <a href={withSite("/environment/map")}>campus map →</a>. The yield-test rate is an upper
            bound on the sustained dewatering rate, and installs and sealings were staged, so a
            simultaneous-full-rate composite bounds concurrency rather than metering it.
          </p>
        </Fragment>
      )
    }

    {
      // Undisclosed cooling method (#1057): the honest render is the bracketed range —
      // never a single consumptive headline presented as if the method were on record.
      scenarios.filter(bracketed).map((s) => {
        const basis = s.scenario.basis;
        return (
          <div class="bracket-panel">
            <p class="bracket-title">Cooling method not on the record</p>
            <p class="card-meta">
              A facility is documented here, but no record discloses how it rejects heat. The
              consumptive water figure is therefore a <strong>range across candidate cooling
              archetypes</strong>
              {basis
                ? ` — ${fmt(basis.consumptive_low)} (closed-loop dry) to ${fmt(basis.consumptive_high)} (evaporative tower)`
                : ""}
              — not an estimate. A single headline would fabricate the site's most load-bearing
              number; the section stays locked until the method is disclosed.
            </p>
            <p class="card-meta">
              Have a water contract, wastewater permit, or cooling-plant spec?{" "}
              <a href={withSite("/submit")}>Submit the disclosure →</a>
            </p>
          </div>
        );
      })
    }

    {scenarios.length === 0 && <p class="stub-note">No hydrology scenarios have been modeled yet.</p>}

    {
      scenarios.filter((s) => !bracketed(s)).map((s) => {
        const river = s.receiving_water_name ?? riverName;
        // The IT load that physically links load → cooling → water (#1632). Carried in the
        // basis but never rendered before; surfaced here as the head of the derivation chain.
        const itLoad = s.scenario.basis?.it_load ?? null;
        // The genuinely-scalar provenanced metrics (low flows are per-site and nullable).
        const stats: FigureStatData[] = [toStat("Consumptive loss", s.consumptive_loss)];
        if (s.receiving_7q10) stats.push(toStat(`${river} 7Q10`, s.receiving_7q10));
        if (s.receiving_live) stats.push(toStat(`${river} live flow`, s.receiving_live));
        // `assimilative` is a per-discharger array, not a scalar: surface the binding
        // (worst-diluted) reach as the headline, carrying its own cited provenance.
        const assim = s.assimilative ?? [];
        const binding =
          assim.length > 0 ? assim.reduce((a, b) => (b.dilution_ratio < a.dilution_ratio ? b : a)) : null;
        if (binding) {
          stats.push({
            label: "Binding dilution",
            value: `${binding.dilution_ratio.toFixed(2)}:1`,
            evidence: grounded(binding.design_low_flow) ? "verified" : "inference",
            basis: grounded(binding.design_low_flow) ? "grounded" : "modeled",
            sub: `${binding.discharger} → ${binding.receiving_water}`,
            warn: binding.flag !== "ok",
          });
        }
        // Fail the band if EITHER design flow is a violation — chronic (7Q10) or acute (1Q10)
        // (WS-08); an acute-only violation still fails, matching the Python assimilative screen.
        const violations = assim.filter(
          (r) => r.flag === "violation" || r.acute_flag === "violation",
        ).length;
        return (
          <div class="scenario">
            <h2>{s.scenario.name}</h2>
            {s.scenario.description && <p class="card-meta">{s.scenario.description}</p>}
            {
              // Which cooling world these numbers assume (epic #1060) + its key assumptions.
              coolingOf(s) && (
                <p class="card-meta">
                  Cooling model: <strong>{COOLING_LABELS[coolingOf(s)!]}</strong>
                  {s.scenario.basis?.wue?.value != null && ` · WUE ${fmt(s.scenario.basis.wue)}`}
                  {s.scenario.basis?.cycles_of_concentration?.value != null &&
                    ` · ${s.scenario.basis.cycles_of_concentration.value} cycles of concentration`}
                  {(s.scenario.basis?.seasonal_months?.length ?? 0) > 0 &&
                    ` · evaporative assist ${s.scenario.basis!.seasonal_months![0]}–${s.scenario.basis!.seasonal_months!.at(-1)}`}
                </p>
              )
            }
            <p class="card-meta">
              Cooling demand: {fmt(s.scenario.cooling_demand)} · consumptive fraction{" "}
              {fmt(s.scenario.consumptive_fraction)}
            </p>
            {itLoad?.value != null && (
              <div class="derivation-chain">
                <span class="dc-caption">Load → cooling → water</span>
                <div class="dc-flow">
                  <span class="dc-step">
                    <strong>{numOf(itLoad)}&nbsp;{itLoad.unit ?? "MW"}</strong>
                    {itLoadRange && <span class="dc-range">(~{itLoadRange} MW)</span>}
                    <span class="dc-note">IT load <code>[inference]</code></span>
                  </span>
                  <span class="dc-arrow" aria-hidden="true">→</span>
                  <span class="dc-step">
                    <strong>{fmt(s.scenario.cooling_demand)}</strong>
                    <span class="dc-note">cooling makeup</span>
                  </span>
                  <span class="dc-arrow" aria-hidden="true">→</span>
                  <span class="dc-step">
                    <strong>{numOf(s.consumptive_loss)}&nbsp;{s.consumptive_loss.unit ?? "cfs"}</strong>
                    <span class="dc-note">net consumptive</span>
                  </span>
                </div>
                <p class="dc-basis">
                  The IT load is inferred from the facility's <strong>[verified]</strong> air-permit
                  backup capacity (N+1), then carried through the cooling archetype's water math — one
                  derivation, not two headlines. The disclosed MW range widens the consumptive bracket.
                  {" "}
                  <a href={withSite("/reports/the-load-and-the-grid")}>the load and the grid →</a>
                </p>
              </div>
            )}
            <div class="fs-grid">
              {stats.map((st) => (
                <FigureStat stat={st} size="lg" />
              ))}
            </div>
            {assim.length > 0 && (
              <p class="card-meta">
                Assimilative screen · {violations} of {assim.length} receiving reaches fail the dilution
                band at design low flow ({assim
                  .map((r: AssimilativeCheck) => {
                    // The chronic 7Q10 ratio, then — matching the design flow to the criterion type
                    // (WS-08) — the acute 1Q10 ratio where cited, and — where the plant shares its
                    // reach with other permitted dischargers — the effluent-credited ratio (WS-15).
                    const acute =
                      r.acute_dilution_ratio != null
                        ? `, acute ${r.acute_dilution_ratio.toFixed(2)}:1`
                        : "";
                    const credited =
                      r.effluent_credited_ratio != null
                        ? ` (${r.effluent_credited_ratio.toFixed(2)}:1 effluent-credited)`
                        : "";
                    return `${r.discharger} chronic ${r.dilution_ratio.toFixed(2)}:1${acute}${credited}`;
                  })
                  .join(" · ")}). The design flow is matched to the criterion type — chronic aquatic-life
                dilution at the 7Q10, acute at the sharper 1Q10; the effluent-credited ratio counts the
                permitted effluent already in the reach. A screening band, not a permit determination.
              </p>
            )}
            {s.balance.warnings.length > 0 && (
              <>
                <p class="card-meta">
                  Tier-0 water balance · {s.balance.nodes.length} nodes · modeling caveats:
                </p>
                <ul class="hydro-caveats">
                  {s.balance.warnings.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        );
      })
    }
  </article>
</Base>

<style>
  .hydro-caveats { margin: 6px 0 0; padding-left: 1.1rem; }
  .hydro-caveats li { font-size: 0.85rem; color: var(--bosc-muted); line-height: 1.5; margin-top: 4px; }
  .bracket-panel { border: 1px solid var(--bosc-rule); background: #efece2; padding: 16px 18px; margin: 14px 0; }
  .bracket-title { font-weight: 700; color: var(--bosc-ink); margin: 0 0 4px; }

  /* The load → cooling → water derivation chain (#1632): the head is the IT load that was
     carried in the basis but never rendered. Documentary: square corners, a thin rule, no shadow. */
  .derivation-chain { border: 1px solid var(--bosc-rule); background: #efece2; padding: 12px 14px; margin: 12px 0; }
  .dc-caption { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--bosc-muted); margin-bottom: 8px; }
  .dc-flow { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; }
  .dc-step { display: inline-flex; align-items: baseline; gap: 6px; }
  .dc-step strong { color: var(--bosc-ink); font-size: 1.05rem; }
  .dc-range, .dc-note { color: var(--bosc-muted); font-size: 0.82rem; }
  .dc-note code { font-size: 0.76rem; }
  .dc-arrow { color: var(--bosc-muted); font-weight: 700; }
  .dc-basis { font-size: 0.8rem; color: var(--bosc-muted); line-height: 1.5; margin: 8px 0 0; }

  /* The dewatering impacted-well table (#well-drawdown): mono figures (design "mono for numbers"),
     the drawdown column carries the inference amber to read the [inference] register at a glance. */
  .dewatering-table { font-size: 0.85rem; }
  .dewatering-table td:nth-child(2), .dewatering-table td:nth-child(3) { font-family: var(--font-mono); text-align: right; }
  .dewatering-table td:nth-child(3) { color: var(--ev-inference-fg); }
</style>
