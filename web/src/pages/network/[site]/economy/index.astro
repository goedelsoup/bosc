---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
/**
 * The economy section hub (design "Chrome", the 5-tab site bar). The economic ground the
 * data-center deal sits on — doored to the content that already exists: the localized labor
 * baseline (BLS QCEW), the end-use & workloads read, the cost-of-opacity narrative, and the
 * economics prose companion. A hub like the environment hub; doors point to real routes.
 */
import Base from "~/layouts/Base.astro";
import FigureStat from "~/components/FigureStat.astro";
import HubLede from "~/components/HubLede.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { EconomicBaseline } from "@watermark/core/feeds";
import { buildGridBackdrop } from "@watermark/core/gridBackdrop";
import { sectorEmployment, topSectors } from "@watermark/core/hubLede";
import { facilityLoadAvailable } from "@watermark/core/readiness";
import type { FigureStatData } from "@watermark/core/viz";
import { withBase, withSite } from "@watermark/core/site";
import { activeStory, chapterHref } from "@watermark/core/walk";

const { slug } = Astro.props as { slug: string };
// The campus load / end-use read is a FACILITY-domain door: it renders only where the facility is
// graded `live` — an instrument-grounded load (air permit / filed disclosure), not a screening
// [inference] or a [reference] announcement (#1630). A screening-only (`seeded`) or facility-less
// site withholds it rather than presenting a screening bracket as a settled campus load, so a
// `live → seeded` regression visibly drops the door. The labor baseline below stays on the floor.
const facilityLive = facilityLoadAvailable(slug);

// The cost-of-opacity door links THIS site's own "cost of opacity" chapter — resolved from the
// current site's surfaced story (#1256), never the Lima-pinned `storyUrl`. It's shown only when
// that story exists AND actually carries a `cost` chapter (Fort Wayne's Project Zodiac, e.g., has
// no cost chapter), so a site without one — or with its story hidden — surfaces no story link.
const story = activeStory();
const costChapter = story?.chapters.find((c) => c.slug === "cost");
const eb = hasFeed("economics-baseline") ? loadFeed<EconomicBaseline>("economics-baseline") : null;
const area = eb?.area_name ?? "the corridor";
const jobs = sectorEmployment(eb);
const sectorCount = eb?.latest.sectors?.length ?? 0;
const num = (n: number): string => n.toLocaleString("en-US");

// The lede (#1891): the section named its two baselines on cards and showed neither. Both are
// on the BACKDROP floor — the QCEW/Census labor baseline and the cited grid service chain are
// keyed to the place, not to a disclosed campus — so a facility-less peer still gets a real
// read here. A site missing BOTH feeds gets the honest absence; nothing is borrowed.
const grid = buildGridBackdrop(slug);
// Ranked by location quotient, not headcount: the LQ is what says the economy is *concentrated*
// in a sector rather than merely large. Sectors whose LQ the feed omits drop out.
const concentrated = topSectors(eb, 3);
const utilityGwh = grid?.denominators.find((d) => d.key === "utility") ?? null;
const ledeFigures: FigureStatData[] = [
  ...(jobs != null
    ? [
        {
          label: "Covered jobs",
          value: num(Math.round(jobs)),
          evidence: "verified" as const,
          sub: `${sectorCount} NAICS sectors · ${eb?.latest.year}`,
        },
      ]
    : []),
  ...(eb?.latest.avg_annual_pay?.value != null
    ? [
        {
          label: "Average annual pay",
          value: `$${num(Math.round(eb.latest.avg_annual_pay.value))}`,
          evidence: "verified" as const,
          sub: "BLS QCEW · all ownerships",
        },
      ]
    : []),
  ...(utilityGwh
    ? [
        {
          label: "Utility retail sales",
          value: num(Math.round(utilityGwh.gwh)),
          unit: "GWh/yr",
          evidence: "verified" as const,
          sub: grid?.utilityName ?? "EIA-861",
        },
      ]
    : []),
];

interface Door {
  id: string;
  kind: string;
  href: string;
  count: string;
  title: string;
  desc: string;
  note: string;
}
const doors: Door[] = [
  {
    id: "baseline",
    kind: "Baseline data",
    href: withSite("/economy/economics-baseline"),
    count: sectorCount ? String(sectorCount) : "—",
    title: "Localized labor baseline",
    desc: `What ${area}'s economy actually is — employment by NAICS sector with each sector's location quotient, and population. BLS QCEW + US Census, every figure connector-sourced.`,
    note: "BLS · Census",
  },
  // The grid backdrop (#1642, E1/E2) — a BACKDROP-floor door, not facility-gated: it names the
  // utility, balancing authority, and regulator for the *place*, so a facility-less peer opens it
  // too (its campus-share column is honestly empty). The page itself locks if the feed is absent.
  ...(hasFeed("grid")
    ? [
        {
          id: "grid",
          kind: "Baseline data",
          href: withSite("/economy/grid"),
          count: "—",
          title: "The grid backdrop",
          desc: `Whose grid this site sits on — the cited service chain (serving utility, balancing authority, wholesale market, rate regulator) and how much electricity each of those systems already moves in a year. The denominator under every megawatt figure.`,
          note: "EIA-861 · EIA-930",
        },
      ]
    : []),
  // Facility-gated (#1630): the campus-load read renders only where the facility is `live`
  // (instrument-grounded load), not for a screening-only or facility-less site — a `live → seeded`
  // regression drops this door rather than presenting a screening bracket as a settled load.
  ...(facilityLive
    ? [
        {
          id: "end-use",
          kind: "Load & workloads",
          href: withSite("/reports/end-use-and-workloads"),
          count: "—",
          title: "End-use & workloads",
          desc: "Where the campus load actually goes — the end-use mix and the workload profile behind the megawatts, against the grid backdrop the site sits on.",
          note: "interactive",
        },
      ]
    : []),
  // The cost-of-opacity door links this site's own `cost` chapter — present only when the current
  // site's surfaced story actually carries one (#1256), so it drops on a hidden/absent story or a
  // story without that chapter, never leaking into Lima's.
  ...(story && costChapter
    ? [
        {
          id: "cost",
          kind: "Narrative",
          href: chapterHref(story, costChapter.slug),
          count: "—",
          title: "The cost of opacity",
          desc: "The deal as the public can see it — incentives, abatement, and load-not-jobs — read against what stays sealed. A chapter of the story.",
          note: "story",
        },
      ]
    : []),
  {
    id: "demand",
    kind: "Reference",
    href: withBase("/docs/economics"),
    count: "—",
    title: "Demand & public benefits",
    desc: "The prose companion: how the demand pressure and the public-benefit case are built from the record — the method behind the figures.",
    note: "method",
  },
];
---

<Base title="The economy" section="economy" rail={false}>
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">Section · the economy</div>
        <h1>The ground the deal sits on</h1>
        <p class="hub-lead">
          The local economic base the data-center build-out lands on — the labor baseline,
          the grid and load backdrop, the end-use read, and the cost the public can and can't see.
        </p>
      </div>
      <span class="hub-count">
        {jobs ? `${area} · ${num(Math.round(jobs))} jobs` : area}
      </span>
    </div>

    <HubLede
      label="The ground, measured"
      absent={eb || grid
        ? null
        : `${area} has neither a labor baseline nor a grid profile in its bundle yet, so this hub can't state what the deal would land on — and it won't state another county's. Both are connector-pulled from public series (BLS QCEW, US Census, EIA-861); they land the first time this site is exported with its FIPS and its serving utility resolved.`}
      cite={[
        eb && `Employment, pay, and location quotients: BLS QCEW + US Census, ${eb.latest.year}.`,
        // The DENOMINATOR's own citation (EIA-861), not `chain[0].cite` — a chain row's citation is
        // the document that identifies the utility, which on Lima is a paragraph of testimony.
        utilityGwh && `Retail sales: ${utilityGwh.cite}.`,
      ]
        .filter(Boolean)
        .join(" ")}
      href={withSite("/economy/economics-baseline")}
      cta="Open the baseline"
    >
      <p class="hublede-say">
        {jobs != null ? (
          <Fragment><span class="num">{num(Math.round(jobs))}</span> covered jobs across <span class="num">{sectorCount}</span> sectors in {area}</Fragment>
        ) : (
          <Fragment>{area}'s labor baseline is not in the bundle yet</Fragment>
        )}{grid && (
          <Fragment>, on <strong>{grid.utilityName}</strong>'s wires inside {grid.baName}</Fragment>
        )}. That's the denominator every megawatt and every job claim gets read against.
      </p>
      {
        concentrated.length > 0 && (
          <div class="hublede-chips">
            {concentrated.map((s) => (
              <span class="hublede-chip">
                {s.sector_name} <span class="hublede-chip-n">{s.location_quotient?.value?.toFixed(1)}× LQ</span>
              </span>
            ))}
          </div>
        )
      }
      {
        ledeFigures.length > 0 && (
          <div class="hublede-figures">
            {ledeFigures.map((s) => (
              <FigureStat stat={s} size="sm" />
            ))}
          </div>
        )
      }
    </HubLede>

    <div class="hub-grid">
      {
        doors.map((d) => (
          <a class="hub-door" id={d.id} href={d.href}>
            <div class="hub-door-top">
              <span class="hub-door-kind">{d.kind}</span>
              <span class="hub-door-count">{d.count}</span>
            </div>
            <div class="hub-door-title">{d.title}</div>
            <div class="hub-door-desc">{d.desc}</div>
            <div class="hub-door-foot">
              <span class="hub-door-browse">Browse</span>
              <span class="hub-door-note">{d.note}</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
