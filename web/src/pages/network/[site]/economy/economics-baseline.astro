---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
import BackLink from "~/components/BackLink.astro";
import LineChart from "~/components/charts/LineChart.astro";
import Base from "~/layouts/Base.astro";
import StudyAnnexBanner from "~/components/study/StudyAnnexBanner.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { LinePoint } from "@watermark/charts/charts";
import type {
  ConsumerEnergyCosts,
  ConsumerEnergyPrice,
  EconomicBaseline,
  EnergyBurden,
  ProvenancedValue,
} from "@watermark/core/feeds";
import { withBase, withSite } from "@watermark/core/site";

const eb = hasFeed("economics-baseline") ? loadFeed<EconomicBaseline>("economics-baseline") : null;
// State-level EIA consumer energy costs (issue #1125) — guarded independently of the county
// baseline so a site can carry one without the other; degrades to nothing when the feed is absent.
const ce = hasFeed("consumer-energy") ? loadFeed<ConsumerEnergyCosts>("consumer-energy") : null;
// Household energy burden (issue #1110) — a fully derived consumer-impact metric; present only
// where the site's baseline carries median household income, absent (section hidden) otherwise.
const burden = hasFeed("energy-burden") ? loadFeed<EnergyBurden>("energy-burden") : null;
const num = (v?: ProvenancedValue | null): string =>
  v?.value == null ? "—" : Math.round(v.value).toLocaleString("en-US");
// QCEW pay figures (#1109) and household energy-burden dollars (#1110) — currency prefix.
const usd = (v?: ProvenancedValue | null): string =>
  v?.value == null ? "—" : `$${Math.round(v.value).toLocaleString("en-US")}`;
const pctStr = (v?: ProvenancedValue | null): string => (v?.value == null ? "—" : `${v.value.toFixed(2)}%`);
// The combined home-energy spend (electricity + gas) behind the combined burden % — the
// backend-derived value, not a re-sum, so the page and feed agree by construction (#1110).
const combinedEnergyCost = burden?.combined_annual_cost.value ?? 0;
const lq = (v?: ProvenancedValue | null): number | null => (v?.value == null ? null : v.value);
// A location quotient is the county's employment share over the national share:
// ≥ 1.25 means the county does much more of that work than the nation (it exports).
const orientation = (q: number | null): string =>
  q == null
    ? "—"
    : q >= 1.25
      ? `${q.toFixed(2)} · exports`
      : q >= 1.0
        ? `${q.toFixed(2)}`
        : `${q.toFixed(2)} · imports`;

const sectors = [...(eb?.latest.sectors ?? [])].sort(
  (a, b) => (b.annual_avg_employment.value ?? 0) - (a.annual_avg_employment.value ?? 0),
);
// Government ownership (QCEW own 1/2/3, #1661) — the federal/state/local slices the private-only
// sector mix cannot show. Their sum plus the private sectors reconciles the all-ownership total;
// the small residual is unclassified/suppressed private employment. Kept in own-code order so the
// federal row (the county's largest single employer at an enclave) leads.
const government = eb?.latest.government ?? [];
const federal = government.find((g) => g.ownership === "1") ?? null;
const sectorJobs = sectors.reduce((s, x) => s + (x.annual_avg_employment.value ?? 0), 0);
const govJobs = government.reduce((s, g) => s + (g.annual_avg_employment.value ?? 0), 0);
const totalJobs = eb?.latest.total_employment?.value ?? null;
const govResidual = totalJobs == null ? null : Math.round(totalJobs - sectorJobs - govJobs);
// The unit caveat is promoted from prose to a structured field (#1661); its text already opens
// with "Economic-unit caveat:" so strip that prefix — the callout title carries it instead.
const unitCaveat = eb?.unit_caveat?.replace(/^Economic-unit caveat:\s*/, "") ?? null;
const jobsNum = (n: number): string => Math.round(n).toLocaleString("en-US");
const trend = eb?.trend ?? [];
const pop = eb?.population?.points ?? [];
const first = trend[0];
const last = trend[trend.length - 1];
const delta = first && last ? (last.total_employment.value ?? 0) - (first.total_employment.value ?? 0) : 0;
const pct = first?.total_employment.value ? (delta / first.total_employment.value) * 100 : 0;

// --- trend charts (issue #1125) -----------------------------------------------------------
// Hand-rolled SVG line charts (indigo encodes data, per @watermark/charts). Thin the year
// axis so a multi-decade series stays legible: label the endpoints and every `stride`-th year,
// blank the rest (the dot still plots). `window` keeps the last N points so the long EIA series
// (natural gas runs from 1967) shares a readable ~quarter-century window with the shorter ones.
function yearLine(
  rows: { year: number; value: number }[],
  opts: { stride?: number; window?: number } = {},
): LinePoint[] {
  const stride = opts.stride ?? 5;
  const w = opts.window ? rows.slice(-opts.window) : rows;
  const firstYr = w[0]?.year;
  const lastYr = w[w.length - 1]?.year;
  return w.map((r) => ({
    label: r.year === firstYr || r.year === lastYr || r.year % stride === 0 ? String(r.year) : "",
    value: r.value,
  }));
}

const empLine = yearLine(
  trend.map((t) => ({ year: t.year, value: t.total_employment.value ?? 0 })),
  { stride: 2 },
);
const estabTrend = trend.filter((t) => t.establishments?.value != null);
const estabLine = yearLine(
  estabTrend.map((t) => ({ year: t.year, value: t.establishments?.value ?? 0 })),
  { stride: 2 },
);

// One EIA series → a windowed line + a units-carrying end label.
function energyLine(s: ConsumerEnergyPrice | undefined): LinePoint[] {
  return s
    ? yearLine(
        s.points.map((p) => ({ year: Number(p.period.slice(0, 4)), value: p.value })),
        { window: 25 },
      )
    : [];
}
const endLabel = (s?: ConsumerEnergyPrice): string | undefined =>
  s?.value.value == null
    ? undefined
    : `${s.value.value.toLocaleString("en-US")} ${s.value.unit ?? ""}`.trim();
const elecPrice = ce?.prices.find((p) => p.fuel === "electricity" && p.metric === "price");
const gasPrice = ce?.prices.find((p) => p.fuel === "natural_gas" && p.metric === "price");
const elecSales = ce?.prices.find((p) => p.fuel === "electricity" && p.metric === "sales");
const energyCharts = [
  { series: elecPrice, kicker: "Line · residential ¢/kWh", title: "Residential electricity price" },
  { series: gasPrice, kicker: "Line · residential $/Mcf", title: "Residential natural-gas price" },
  {
    series: elecSales,
    kicker: "Line · retail sales (million kWh)",
    title: "Electricity retail sales — all sectors",
  },
].filter((c): c is { series: ConsumerEnergyPrice; kicker: string; title: string } => c.series != null);
---

<Base title="Economics — localized baseline" section="economy">
  <article class="prose">
    <BackLink href={withSite("/economy/")} label="The economy" />
    <h1>Economics — localized baseline</h1>
    <StudyAnnexBanner chapters={["labor"]} />
    {
      eb === null ? (
        <p class="stub-note">No economic baseline is available yet for this site.</p>
      ) : (
        <>
          <p class="section-lead">
            What {eb.area_name}'s economy actually is, quantitatively — the ground the data-center deal sits
            on. Employment by industry for <strong>{eb.latest.year}</strong> (BLS QCEW) with each sector's
            <strong> location quotient</strong> (county share ÷ national share), and population (US Census
            ACS). The employment and population figures are connector-sourced <code>[verified]</code>, with each
            sector's location quotient <strong>derived</strong> from them; the prose companion is
            <a href={withBase("/docs/economics")}> Economics — demand &amp; public benefits</a>.
          </p>

          {unitCaveat && (
            <div class="callout callout--note">
              <p class="callout-title">Economic-unit caveat</p>
              <p>{unitCaveat}</p>
            </div>
          )}

          {pop.length > 0 && (
            <>
              <h2 id="population">Population</h2>
              <table>
                <thead><tr><th>Year</th><th>Population</th></tr></thead>
                <tbody>
                  {pop.map((p) => (
                    <tr><td>{p.year}</td><td>{num(p.population)}</td></tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          {trend.length > 0 && (
            <>
              <h2 id="employment">Employment trend</h2>
              {empLine.length >= 2 && (
                <div class="chart-grid">
                  <LineChart
                    data={empLine}
                    kicker="Line · covered employment"
                    title="Total covered employment"
                    endLabel={num(last?.total_employment)}
                    evidence="verified"
                    source="BLS QCEW annual averages"
                  />
                  {estabLine.length >= 2 && (
                    <LineChart
                      data={estabLine}
                      kicker="Line · establishments"
                      title="Establishments"
                      endLabel={num(estabTrend[estabTrend.length - 1]?.establishments)}
                      evidence="verified"
                      source="BLS QCEW annual averages"
                    />
                  )}
                </div>
              )}
              <table>
                <thead><tr><th>Year</th><th>Total covered employment</th></tr></thead>
                <tbody>
                  {trend.map((t) => (
                    <tr><td>{t.year}</td><td>{num(t.total_employment)}</td></tr>
                  ))}
                </tbody>
              </table>
              {trend.length >= 2 && (
                <p>
                  Total covered employment <strong>{delta > 0 ? "grew" : "shrank"} {Math.abs(pct).toFixed(1)}%</strong>{" "}
                  ({num(first.total_employment)} → {num(last.total_employment)}) between {first.year} and
                  {" "}{last.year} — the labor base the campus's ~50 promised jobs join.
                </p>
              )}
            </>
          )}

          <h2 id="industry">Industry mix &amp; export-orientation</h2>
          <p>
            Employment by NAICS sector, {eb.latest.year}, ranked by jobs.
            {eb.latest.avg_annual_pay?.value != null && (
              <>
                {" "}County-wide average annual pay is <strong>{usd(eb.latest.avg_annual_pay)}</strong>{" "}
                (BLS QCEW, all ownerships) — the prevailing-wage yardstick the campus's ~50 promised jobs
                are measured against.
              </>
            )}
          </p>
          <table>
            <thead>
              <tr><th>Sector</th><th>Jobs</th><th>Establishments</th><th>Avg annual pay</th><th>Location quotient</th></tr>
            </thead>
            <tbody>
              {sectors.map((s) => (
                <tr>
                  <td>{s.naics} · {s.sector_name}</td>
                  <td>{num(s.annual_avg_employment)}</td>
                  <td>{num(s.establishments)}</td>
                  <td>{usd(s.avg_annual_pay)}</td>
                  <td>{orientation(lq(s.location_quotient))}</td>
                </tr>
              ))}
            </tbody>
          </table>

          {government.length > 0 && (
            <>
              <h2 id="government">Government employment — outside the private sector mix</h2>
              <p>
                The industry table above is <strong>private-ownership</strong> employment (BLS QCEW). Federal,
                state and local government carry no NAICS sector of their own, so they appear in <em>no</em> row
                above — yet the county total counts them.
                {federal?.annual_avg_employment.value != null && (
                  <>
                    {" "}Federal civilian employment alone is <strong>{num(federal.annual_avg_employment)}</strong>{" "}
                    jobs{federal.avg_annual_pay?.value != null && <> at <strong>{usd(federal.avg_annual_pay)}</strong> average pay</>};
                    at a federal enclave it is the county's single largest employer with no page of its own.
                  </>
                )}
              </p>
              <table>
                <thead>
                  <tr><th>Ownership</th><th>Jobs</th><th>Establishments</th><th>Avg annual pay</th><th>Location quotient</th></tr>
                </thead>
                <tbody>
                  {government.map((g) => (
                    <tr>
                      <td>{g.ownership_name}</td>
                      <td>{num(g.annual_avg_employment)}</td>
                      <td>{num(g.establishments)}</td>
                      <td>{usd(g.avg_annual_pay)}</td>
                      <td>{orientation(lq(g.location_quotient))}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {totalJobs != null && (
                <p>
                  Private sectors (<strong>{jobsNum(sectorJobs)}</strong>) + government
                  (<strong>{jobsNum(govJobs)}</strong>) reconcile to the <strong>{jobsNum(totalJobs)}</strong>{" "}
                  all-ownership total{govResidual ? <> — the {jobsNum(Math.abs(govResidual))}-job residual is
                  unclassified or suppressed private employment</> : null}.
                </p>
              )}
            </>
          )}
          {eb.coverage_note && <p class="card-meta">{eb.coverage_note}</p>}
          {eb.note && <p class="card-meta">{eb.note}</p>}
        </>
      )
    }

    {
      ce && energyCharts.length > 0 && (
        <>
          <h2 id="consumer-energy">Consumer energy costs</h2>
          <p class="section-lead">
            What households in <strong>{ce.area_name}</strong> pay for electricity and heating fuel — the
            consumer-price half of the demand thread the data-center load presses on. State-level EIA
            residential prices and retail sales, each connector-sourced <code>[verified]</code>, charted over
            the last ~quarter-century (the natural-gas series reaches back to 1967, but the window is
            trimmed for legibility). Prices are in native units — electricity in cents/kWh, gas in $/Mcf,
            sales in million kWh.
          </p>
          <div class="chart-grid">
            {energyCharts.map((c) => (
              <LineChart
                data={energyLine(c.series)}
                kicker={c.kicker}
                title={c.title}
                endLabel={endLabel(c.series)}
                evidence="verified"
                source={`EIA API v2 · ${c.series.series_id}`}
              />
            ))}
          </div>
          {ce.note && <p class="card-meta">{ce.note}</p>}
        </>
      )
    }

    {
      burden && (
        <>
          <h2 id="energy-burden">Household energy burden</h2>
          <p class="section-lead">
            What that energy costs a typical household: the share of <strong>{burden.area_name}</strong>'s
            median household income (<strong>{usd(burden.median_household_income)}/yr</strong>, US Census
            B19013) spent on residential electricity and heating. A fully <code>[derived]</code> figure —
            annual spend = average household use × the EIA residential price — unlike the stylized
            demand→price band. The gas and combined rows assume a gas-heated home at average use.
          </p>
          <table>
            <thead>
              <tr><th>Fuel</th><th>Annual cost</th><th>Burden (% of income)</th></tr>
            </thead>
            <tbody>
              <tr>
                <td>Electricity</td>
                <td>{usd(burden.electricity_annual_cost)}</td>
                <td>{pctStr(burden.electricity_burden_pct)}</td>
              </tr>
              <tr>
                <td>Natural gas (heated home)</td>
                <td>{usd(burden.gas_annual_cost)}</td>
                <td>{pctStr(burden.gas_burden_pct)}</td>
              </tr>
              <tr>
                <td><strong>Combined</strong></td>
                <td><strong>${Math.round(combinedEnergyCost).toLocaleString("en-US")}</strong></td>
                <td><strong>{pctStr(burden.combined_burden_pct)}</strong></td>
              </tr>
            </tbody>
          </table>
          {burden.caveats && burden.caveats.length > 0 && (
            <ul class="card-meta">
              {burden.caveats.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          )}
        </>
      )
    }
  </article>
</Base>
