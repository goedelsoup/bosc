---
import { withSitePaths } from "@watermark/core/sites";
import { getCollection, render } from "astro:content";
import Base from "~/layouts/Base.astro";
import { isAvailable } from "@watermark/core/readiness";
import { refBySlug, scopedReference } from "@watermark/core/reference";
import { withSite } from "@watermark/core/site";

export async function getStaticPaths() {
  // Only the curated reference set (lib/reference.ts) is published.
  const entries = await getCollection("reference", (e) => refBySlug.has(e.id));
  // Per-site (#1260): emit a dataset route for a site only when it OWNS that dataset (catalog
  // `site_scope`, resolved in the callback's `runWithSite` bundle scope) and its `record` domain
  // is active — so a sibling site can't open Lima's zoning / parcels / WBD by URL.
  return withSitePaths((slug) => {
    if (!isAvailable(slug, "record")) return [];
    const scoped = new Set(scopedReference(slug).map((d) => d.slug));
    return entries
      .filter((entry) => scoped.has(entry.id))
      .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
  });
}

const { entry } = Astro.props;
const dataset = refBySlug.get(entry.id)!;
const { Content } = await render(entry);
---

<Base title={dataset.title} section="site" description={dataset.blurb}>
  <article class="prose">
    <p>
      <a href={withSite("/site/")}>← The record</a> ·
      <a href={withSite("/site/reference/")}>All reference data</a>
    </p>
    <Content />
  </article>
</Base>
