---
import { availableFacetPaths } from "@watermark/core/readiness";
// Reference is a facet of The Record: a site whose `record` domain is inactive never borrows the
// reference build's datasets (#1260). The gate is at the ROUTE since #1894, and it is now the FACET
// gate rather than the section's — which is what the record index's door has always used. The two
// could disagree: a site with an active `record` domain and no scoped datasets of its own dropped
// the door and built the page anyway, so what stood there was an empty hub nothing linked. An active
// domain never opens an empty leaf.
export const getStaticPaths = () => availableFacetPaths("reference");
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import HubLede from "~/components/HubLede.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import { type CatalogItem, catalogFreshness } from "@watermark/core/feeds";
import { newestRefresh, tally } from "@watermark/core/hubLede";
import { refBySlug, scopedReference } from "@watermark/core/reference";
import { withSite } from "@watermark/core/site";

const { slug } = Astro.props as { slug: string };

// Scoped to THIS site (catalog `site_scope`, resolved per-site in the bundle), and only datasets
// whose README is actually present in this checkout.
const present = new Set((await getCollection("reference")).map((e) => e.id));
const datasets = scopedReference(slug).filter((d) => present.has(d.slug) && refBySlug.has(d.slug));

// The lede (#1891). The page promised each dataset is "committed, regenerable, documented with
// its gaps" and showed no way to tell whether any of that currently holds. The catalog already
// knows: it reconciles each entry against the file on disk, and `catalogFreshness` reduces that
// snapshot to one state. So the lede is the set's condition — which of these are current, which
// have drifted from their cadence, and which are LFS pointers in this checkout.
//
// Read from the catalog rows behind the datasets ON SCREEN — the same already-site-scoped feed
// `scopedReference` resolves against (#1260) — so the tally can't count another site's sets.
const shown = new Set(datasets.flatMap((d) => d.catalogIds));
const rows = (hasFeed("catalog", slug) ? loadFeed<CatalogItem[]>("catalog", slug) : []).filter((c) =>
  shown.has(c.id),
);
const FRESHNESS_LABEL: Record<string, string> = {
  fresh: "current",
  stale: "past its cadence",
  // `unpulled` is NOT `missing` (#2066): the site has no copy of a per-site dataset, which is a
  // connector not yet run here — not a file gone from the checkout. Before the per-site
  // observation landed, a site published the network's aggregate and could never report either.
  unpulled: "not pulled for this site",
  missing: "not in this checkout",
  unmaterialized: "LFS pointer",
  unknown: "unreconciled",
};
const states = tally(
  rows.map((c) => FRESHNESS_LABEL[catalogFreshness(c.observed, c.site_scope)] ?? "unreconciled"),
);
const refreshed = newestRefresh(rows);
---

<Base title="Reference data" section="site" rail={false}>
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">The record · reference</div>
        <h1>Reference data</h1>
        <p class="hub-lead">
          The authoritative datasets from <strong>outside</strong> sources that the analysis
          draws on — EPA, USGS, BLS/Census, county and city GIS, GLEIF. Each is committed,
          regenerable from its source, and documented here with its provenance and known gaps.
        </p>
      </div>
      <span class="hub-count">{datasets.length} datasets</span>
    </div>

    <HubLede
      label="The state of this site's outside data"
      absent={states.length === 0
        ? "This site's catalog carries no reference datasets yet, so there is no condition to report. They arrive with the connector pulls — each one committed, regenerable, and documented with its gaps."
        : null}
      cite={`Reconciled against the files in this checkout by the catalog, not asserted here.${refreshed ? ` The most recent pull in this set landed ${refreshed}.` : ""}`}
    >
      <p class="hublede-say">
        <span class="num">{datasets.length}</span> documented datasets over{" "}
        <span class="num">{rows.length}</span> catalog entries — one README can document several,
        so the states below count entries. Each is regenerable from its source and none is
        hand-edited; here is how each stands against the file on disk today:
      </p>
      <div class="hublede-chips">
        {
          states.map((s) => (
            <span class="hublede-chip">
              {s.label} <span class="hublede-chip-n">{s.count}</span>
            </span>
          ))
        }
      </div>
    </HubLede>

    <div class="hub-grid">
      {
        datasets.map((d) => (
          <a class="hub-door" href={`${withSite("/site/reference/")}${d.slug}`}>
            <div class="hub-door-top">
              <span class="hub-door-kind">Dataset</span>
            </div>
            <div class="hub-door-title">{d.title}</div>
            <div class="hub-door-desc">{d.blurb}</div>
            <div class="hub-door-foot">
              <span class="hub-door-browse">Open</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
