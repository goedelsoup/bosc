---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
import Base from "~/layouts/Base.astro";
import HubLede from "~/components/HubLede.astro";
import SectionLocked from "~/components/SectionLocked.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { PersonItem } from "@watermark/core/feeds";
import { roleTally } from "@watermark/core/hubLede";
import { RECORD_FACETS, facetAvailable } from "@watermark/core/readiness";
import { withSite } from "@watermark/core/site";

// The declared facet gate (#1886) — the page no longer relies on merely reading a per-site feed
// to stay honest; a site with no people of its own renders the lock and the ask.
const { slug } = Astro.props as { slug: string };
const facet = RECORD_FACETS.people;
const locked = !facetAvailable(slug, "people");

const people = hasFeed("people") ? loadFeed<PersonItem[]>("people") : [];
// The lede (#1891): a wall of name cards says who is profiled but not what this bench IS. The
// roles are already on every profile — tallied, they answer "whose record is this?" before the
// reader has to read 40 names. Curated profiles only; the tally never exceeds what's on screen.
const roles = roleTally(people);
const expanded = people.filter((p) => p.expanded).length;
const rolesAbsent =
  roles.length === 0
    ? "No profile here carries a documented role yet, so this page can't say what the bench is — only who is in it. A role comes from the record, not from an assumption about a name."
    : null;
---

<Base title="People" section="site" rail={false}>
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">The record · people</div>
        <h1>People</h1>
        {!locked && (
          <p class="hub-lead">
            Curated individual profiles — the people behind the entity graph.
            For sites and parcels, see <a href={withSite("/site/places/")}>Places &amp; parcels</a>.
          </p>
        )}
      </div>
      {!locked && <span class="hub-count">{people.length} people</span>}
    </div>

    {locked && <SectionLocked section={facet.section} label={facet.label} />}

    {
      !locked && (
        <HubLede
          label="Whose record this is"
          absent={rolesAbsent}
          cite="Roles as written on each profile, tallied — one count per profile that names the role, never inferred from an affiliation."
        >
          <p class="hublede-say">
            <span class="num">{people.length}</span> curated profiles{expanded > 0 && (
              <Fragment>, <span class="num">{expanded}</span> of them written up in full</Fragment>
            )}. The roles the record puts them in:
          </p>
          <div class="hublede-chips">
            {roles.map((r) => (
              <span class="hublede-chip">
                {r.label} <span class="hublede-chip-n">{r.count}</span>
              </span>
            ))}
          </div>
        </HubLede>
      )
    }

    <div class="hub-grid">
      {
        people.map((p) => (
          <a class="hub-door" href={`${withSite("/site/people/")}${p.slug}/`}>
            <div class="hub-door-top">
              <span class="hub-door-kind">Person</span>
            </div>
            <div class="hub-door-title">{p.name}</div>
            {(p.roles.length > 0 || p.affiliations.length > 0) && (
              <div class="hub-door-desc">{p.roles.slice(0, 2).join(" · ") || p.affiliations[0]}</div>
            )}
            <div class="hub-door-foot">
              <span class="hub-door-browse">Open profile</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
