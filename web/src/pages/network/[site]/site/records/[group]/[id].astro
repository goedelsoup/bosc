---
import { withSitePaths } from "@watermark/core/sites";
/**
 * The Record Screen (design "Record Screen", #193): the per-record leaf at
 * /site/records/<group>/<id>. It opens with the reference Record Block (the
 * library's packed unit) and, when the record is a curated walk anchor, runs the
 * Record Teardown on the same id below it (the walk's teaching flow) — one feed,
 * never a fork. A `verify` link, a group-index row, or a walk chip all land here,
 * on the block, with the teardown one scroll down. The per-page TOC rail is #195.
 */
import type { GetStaticPaths } from "astro";
import Base from "~/layouts/Base.astro";
import RecordBlock from "~/components/RecordBlock.astro";
import RecordTeardown from "~/components/RecordTeardown.astro";
import SiblingNav from "~/components/SiblingNav.astro";
import { activeSite, hasFeed, loadFeed } from "@watermark/core/bundle";
import { slugify, type RecordItem } from "@watermark/core/feeds";
import { groupLabel } from "@watermark/core/records";
import { recordToBlock } from "@watermark/core/recordBlock";
import { siteBase } from "@watermark/core/routes";
import { teardownForRel } from "@watermark/core/teardowns";

export const getStaticPaths: GetStaticPaths = () =>
  withSitePaths(() => {
    const records = hasFeed("records") ? loadFeed<RecordItem[]>("records") : [];
    return records.map((r) => {
      // Siblings are the record's neighbours WITHIN ITS GROUP, in the order the group index
      // lists them (that index renders `records.filter(group)` in feed order, so this is the
      // same sequence — "next" here is the row below there). Resolved once per record here
      // rather than re-scanning the feed at render.
      const siblings = records.filter((s) => s.group === r.group);
      const at = siblings.findIndex((s) => s.rel === r.rel);
      return {
        params: { group: r.group, id: slugify(r.rel) },
        props: { record: r, prev: siblings[at - 1] ?? null, next: siblings[at + 1] ?? null },
      };
    });
  });

interface Props {
  record: RecordItem;
  prev: RecordItem | null;
  next: RecordItem | null;
}
const { record, prev, next } = Astro.props as Props;
// Trail + sibling hrefs are pre-deploy-base — the components apply it.
const sitePath = (path: string): string => `${siteBase(activeSite())}${path}`;
const recordPath = (r: RecordItem): string => sitePath(`/site/records/${r.group}/${slugify(r.rel)}/`);
const prevSib = prev ? { label: prev.title, href: recordPath(prev) } : undefined;
const nextSib = next ? { label: next.title, href: recordPath(next) } : undefined;
const block = recordToBlock(record);
const teardown = teardownForRel(record.rel);
const hasAnnotated = Boolean(teardown?.pins?.length);
// The group crumb carries the FULL label, not the head of it: three groups share the head
// "Permits", so "Permits — NPDES" and "Permits — Ohio EPA / USACE" would climb to the same
// word and the trail would stop saying which index it lands on.
const groupName = groupLabel(record.group);

// The rail is this record's own anchors (#195, design "Record Screen"): the block,
// then the teardown's five beats. The beat ids live on the DEFAULT (split) teardown
// instance only — see RecordTeardown `anchors`. A record with no teardown is just the
// block, so it needs no rail.
const toc = teardown
  ? [
      { anchor: "the-record", label: "The record", num: "·" },
      { anchor: "beat-source", label: "The source", num: "①" },
      { anchor: "beat-read", label: "What we read", num: "②" },
      { anchor: "beat-reveal", label: "What it reveals", num: "③" },
      { anchor: "beat-check", label: "How to check it", num: "④" },
      { anchor: "beat-connect", label: "Where it connects", num: "⑤" },
    ]
  : [];
---

<Base
  title={record.title}
  section="site"
  toc={toc}
  tocTitle="On this record"
  description={`${record.title} — the record, read in the open with provenance on every figure.`}
  trailLabels={{ [record.group]: groupName }}
  prevHref={prevSib?.href}
  nextHref={nextSib?.href}
>
  <div class="rec">
    <div class="rec-part" id="the-record">The record</div>
    <div class="rb-list"><RecordBlock record={block} density="full" /></div>

    {
      teardown && (
        <Fragment>
          <div class="rec-handoff">
            <span class="rec-handoff-mark" aria-hidden="true">↓</span>
            <p class="rec-handoff-text">
              <strong>How we read it.</strong> The block above is the answer; the teardown
              below is the working — the same record, slowed down so the figure can be checked.
            </p>
          </div>

          <div class="rec-flow" id="the-teardown">
            <input class="rec-flow-radio" type="radio" id="flow-split" name="rec-flow" checked />
            <input class="rec-flow-radio" type="radio" id="flow-scroll" name="rec-flow" />
            {hasAnnotated && (
              <input class="rec-flow-radio" type="radio" id="flow-annotated" name="rec-flow" />
            )}
            <div class="rec-flow-head">
              <span class="rec-part is-forest">The teardown · run on this id</span>
              <div class="rec-flow-seg" role="group" aria-label="Teardown layout">
                <span class="rec-flow-flow">flow</span>
                <label for="flow-split">Split</label>
                <label for="flow-scroll">Scroll</label>
                {hasAnnotated && <label for="flow-annotated">Annotated</label>}
              </div>
            </div>
            <div class="rec-flow-panel rec-flow-panel--split">
              <RecordTeardown record={teardown} layout="split" anchors />
            </div>
            <div class="rec-flow-panel rec-flow-panel--scroll">
              <RecordTeardown record={teardown} layout="scroll" />
            </div>
            {hasAnnotated && (
              <div class="rec-flow-panel rec-flow-panel--annotated">
                <RecordTeardown record={teardown} layout="annotated" />
              </div>
            )}
          </div>
          <p class="rec-flow-note">
            Same five beats, {hasAnnotated ? "three" : "two"} shapes: <b>split</b> for a clean
            two-column source, <b>scroll</b> for the vertical reflow
            {hasAnnotated ? ", and " : ". "}
            {hasAnnotated && (
              <Fragment>
                <b>annotated</b> for the redaction-heavy artifact.{" "}
              </Fragment>
            )}
            The flow is a choice on the screen — the record data never changes.
          </p>
        </Fragment>
      )
    }

    <SiblingNav
      prev={prevSib}
      next={nextSib}
      within={{ label: groupName, href: sitePath(`/site/records/${record.group}/`) }}
    />
  </div>
</Base>
