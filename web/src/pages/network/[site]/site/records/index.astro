---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
import EvidenceLegend from "~/components/EvidenceLegend.astro";
import DonutChart from "~/components/charts/DonutChart.astro";
import SectionLocked from "~/components/SectionLocked.astro";
import Base from "~/layouts/Base.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { RecordItem } from "@watermark/core/feeds";
import { RECORD_FACETS, facetAvailable } from "@watermark/core/readiness";
import { groupLabel, groupsOf } from "@watermark/core/records";
import { siteHref, withSite } from "@watermark/core/site";
import { LIMA_SLUG } from "@watermark/core/routes";

// The facet gate (#1886), declared in `RECORD_FACETS` rather than left to emerge from the fact
// that this page happens to read a per-site feed: an empty `records` feed reads as a lock + an
// ask for the source, never as a working section with nothing in it.
const { slug } = Astro.props as { slug: string };
const facet = RECORD_FACETS.records;
const locked = !facetAvailable(slug, "records");

const records = hasFeed("records") ? loadFeed<RecordItem[]>("records") : [];
const groups = groupsOf(records);
const countOf = (g: string): number => records.filter((r) => r.group === g).length;
const byGroup = groups.map((g) => ({ label: groupLabel(g), value: countOf(g) }));
---

<Base title="Records" section="site" rail={false}>
  {locked ? (
    <div class="hub">
      <div class="hub-head">
        <div>
          <div class="hub-eyebrow">The record · records</div>
          <h1>Records</h1>
        </div>
      </div>
      <SectionLocked
        section={facet.section}
        label={facet.label}
        holds="structured extractions of its own — the deeds, permits, filings, and estimates read from its corpus"
      />
    </div>
  ) : (
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">The record · records</div>
        <h1>Records</h1>
        <p class="hub-lead">
          {records.length} committed extractions, grouped by document kind. Each is
          read from the image and validated against a typed schema; dollar totals are
          high-confidence, quantities marked <span class="approx">~</span> are
          approximate transcriptions.
        </p>
      </div>
      <span class="hub-count">{records.length} records · {groups.length} groups</span>
    </div>
    {byGroup.length > 1 && <DonutChart title="Records by document kind" centerLabel="records" slices={byGroup} />}
    <p class="hub-lead">
      {/* how-to-read is Lima-only (its example teardowns use Lima records), so this stays
          Lima-pinned — but via `siteHref` so it carries the deploy base, not the base-free
          `SITE_BASE` it used before (#1217). */}
      New to the record? <a href={siteHref(LIMA_SLUG, "/site/records/how-to-read")}>How to read any record</a> —
      the five-beat grammar behind every figure here, shown across a cost estimate, an air permit, and a
      water screen.
    </p>
    <div class="hub-grid">
      {
        groups.map((g) => (
          <a class="hub-door" href={`${withSite("/site/records/")}${g}/`}>
            <div class="hub-door-top">
              <span class="hub-door-kind">Record group</span>
              <span class="hub-door-count">{countOf(g)}</span>
            </div>
            <div class="hub-door-title">{groupLabel(g)}</div>
            <div class="hub-door-foot">
              <span class="hub-door-browse">Open group</span>
              <span class="hub-door-note">{countOf(g)} record(s)</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
    <p class="hub-lead">
      Every record, profile, and figure is tagged with its evidence class — read it as
      a confidence signal, not decoration:
    </p>
    <EvidenceLegend />
  </div>
  )}
</Base>
