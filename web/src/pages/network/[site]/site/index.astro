---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
import Base from "~/layouts/Base.astro";
import HubLede from "~/components/HubLede.astro";
import { hasFeed, loadFeed, loadManifest } from "@watermark/core/bundle";
import type { DocumentCollectionItem, MeetingItem, RecordItem, TimelineEntry } from "@watermark/core/feeds";
import { flaggedRecords, isoDate, recentEvents, recordSpan } from "@watermark/core/hubLede";
import { type RecordFacet, facetAvailable } from "@watermark/core/readiness";
import { scopedReference } from "@watermark/core/reference";
import { withBase, withSite } from "@watermark/core/site";

const { slug } = Astro.props as { slug: string };
// Every door is a record FACET, and each is dropped when this site has nothing of its own behind
// it (#1886) — the reference door already worked this way (#1260); the rest advertised a page that
// either stood empty or, in legal's case, served the reference build's filings. `RECORD_FACETS`
// is the SSOT for whether a facet opens; a door with no `facet` (the environment cross-link) is
// gated by its own section elsewhere.
const refCount = facetAvailable(slug, "reference") ? scopedReference(slug).length : 0;

const manifest = loadManifest();
const byName = new Map(manifest.feeds.map((f) => [f.name, f]));
const count = (n: string): number => byName.get(n)?.count ?? 0;
const num = (n: number): string => n.toLocaleString("en-US");

const documents = hasFeed("documents") ? loadFeed<DocumentCollectionItem[]>("documents") : [];
const nFiles = documents.reduce((a, c) => a + c.entries.length, 0);
const timeline = hasFeed("timeline") ? loadFeed<TimelineEntry[]>("timeline") : [];
const meetings = hasFeed("meetings") ? loadFeed<MeetingItem[]>("meetings") : [];

// The lede (#1891). The record hub knew all of this — it was loading the feeds to print the
// counts on the door cards — and showed a reader nothing but the counts. So it leads with the
// record itself: what it spans, the newest dated things in it, and where its own extraction
// flagged a figure. Every line is this site's feeds; a site with nothing extracted yet reads
// the absence instead (the doors below are already facet-gated, #1886).
const records = hasFeed("records") ? loadFeed<RecordItem[]>("records") : [];
const flagged = flaggedRecords(records);
const span = recordSpan(timeline);
const latest = facetAvailable(slug, "timeline") ? recentEvents(timeline, 3) : [];
// The lede's CTA and its event rows both land on `/timeline`, which a site with no dated events no
// longer builds (#1894) — so the deep link is offered on exactly the terms the page is. Same for
// the transcription-warning link into `/site/records/`: the count comes from the feed, the page
// comes from the facet, and a site can carry the one without opening the other.
const timelineHref = facetAvailable(slug, "timeline") ? withSite("/timeline") : null;
const recordsHref = facetAvailable(slug, "records") ? withSite("/site/records/") : null;
const exported = isoDate(manifest.generated_at);
const year = (iso: string): string => iso.slice(0, 4);
const empty = nFiles === 0 && records.length === 0 && timeline.length === 0;

// Door ids match the section's nav anchors so the rail (shown on leaf pages) resolves.
interface Door {
  id: string;
  /** The record facet this door opens — dropped when the facet is locked for this site. A door
   *  with no facet is not a facet (the environment cross-link) and is always shown. */
  facet?: RecordFacet;
  kind: string;
  href: string;
  count: string;
  title: string;
  desc: string;
  note: string;
}
const allDoors: Door[] = [
  {
    id: "documents",
    facet: "documents",
    kind: "Catalog",
    href: withSite("/site/documents/"),
    count: num(nFiles),
    title: "Documents",
    desc: "Source-document catalog, grouped by collection — names, types, sizes, LFS status.",
    note: `${documents.length} collections`,
  },
  {
    id: "records",
    facet: "records",
    kind: "Structured records",
    href: withSite("/site/records/"),
    count: num(count("records")),
    title: "Records",
    desc: "Structured record groups read from the corpus — deeds, permits, filings, plans, cost estimates.",
    note: "the per-record unit",
  },
  {
    id: "timeline",
    facet: "timeline",
    kind: "Chronology",
    href: withSite("/timeline"),
    count: num(timeline.length),
    title: "Timeline",
    desc: "Events in sequence — the spine the story pays off into.",
    note: "cause → consequence",
  },
  {
    id: "exhibits",
    facet: "exhibits",
    kind: "Curated excerpts",
    href: withSite("/site/exhibits"),
    count: num(count("exhibits")),
    title: "Exhibits",
    desc: "Curated, citable slices of the source record.",
    note: "downloadable",
  },
  {
    id: "people",
    facet: "people",
    kind: "Profiles",
    href: withSite("/site/people/"),
    count: num(count("people")),
    title: "People",
    desc: "Individual profiles — roles, affiliations, aliases, sources.",
    note: "the human detail",
  },
  {
    id: "places",
    facet: "places",
    kind: "Geography",
    href: withSite("/site/places/"),
    count: num(count("places")),
    title: "Places & parcels",
    desc: "The campus, the corridor sites, and the parcels the record turns on.",
    note: "geographic detail",
  },
  {
    id: "legal",
    facet: "legal",
    kind: "Filings & analysis",
    href: withSite("/site/legal"),
    count: num(meetings.length),
    title: "Legal history",
    desc: "Meeting summaries, PRR & mandamus, and Select-Committee testimony.",
    note: "filings & analysis",
  },
  {
    // Not a facet: the glossary is the network's shared vocabulary and builds ONCE, on the wiki
    // (#1892 — one taxonomy per noun). This door is the record's cross-reference to that one
    // canonical build; the record's own `[[wiki links]]` resolve there too.
    id: "concepts",
    kind: "Glossary",
    href: withBase("/wiki/concepts/"),
    count: num(count("concepts")),
    title: "Glossary",
    desc: "Term and method definitions — the network's shared vocabulary, kept once on the wiki. The terms this site's record uses link straight into it.",
    note: "network-global · wiki",
  },
  {
    id: "reference",
    facet: "reference",
    kind: "External data",
    href: withSite("/site/reference/"),
    count: num(refCount),
    title: "Reference datasets",
    desc: "Authoritative external datasets, each documented with its provenance and gaps.",
    note: "EPA · USGS · BLS …",
  },
  {
    id: "environment",
    kind: "Hydrology, air & toxics",
    href: withSite("/lens/environment"),
    count: "live",
    title: "The environment",
    desc: "Hydrology dashboards, the watershed map, before/during/after imagery, air dispersion, and RSEI toxics — the environment the campus sits in.",
    note: "USGS · NOAA · EPA",
  },
];
const doors = allDoors.filter((d) => d.facet === undefined || facetAvailable(slug, d.facet));
---

<Base title="The record" section="site" rail={false}>
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">Section · the record</div>
        <h1>The source record</h1>
        <p class="hub-lead">
          Everything the project is built from — documents, the structured records
          read from them, the timeline, people &amp; places, the legal history,
          external reference datasets, and the environmental data.
        </p>
      </div>
      <span class="hub-count">{num(nFiles)} source files indexed</span>
    </div>

    <HubLede
      label="What the record holds"
      absent={empty
        ? "Nothing has been ingested for this site yet — no source documents, no extractions, no dated events. That's the honest state, not a placeholder: the doors below open as each facet lands, and a document you hold is the fastest way to open the first one."
        : null}
      cite={`Counted from this site's own documents / records / timeline feeds${exported ? `, exported ${exported}` : ""}. Nothing here is carried over from another site.`}
      href={timelineHref}
      cta={timelineHref ? "Open the timeline" : null}
    >
      <p class="hublede-say">
        <span class="num">{num(nFiles)}</span> source files across{" "}
        <span class="num">{documents.length}</span> {documents.length === 1 ? "collection" : "collections"},
        read into <span class="num">{num(records.length)}</span> structured records{
          span ? (
            <Fragment>
              {" "}and <span class="num">{num(timeline.length)}</span> dated events spanning{" "}
              <span class="num">{year(span.first)}–{year(span.last)}</span>.
            </Fragment>
          ) : (
            "."
          )
        }
        {flagged.length > 0 && recordsHref && (
          <Fragment>
            {" "}
            <a href={recordsHref}>
              {num(flagged.length)} of those records carry a transcription warning
            </a>{" "}
            — read them against the page they came off.
          </Fragment>
        )}
      </p>
      {
        latest.length > 0 && timelineHref && (
          <ul class="hublede-list">
            {latest.map((e) => (
              <li class="hublede-item">
                <span class="hublede-item-k">{e.date}</span>
                <span class="hublede-item-b">
                  <a class="hublede-item-t" href={timelineHref}>
                    {e.title}
                  </a>
                  <span class="hublede-item-m">
                    {e.category.replace(/_/g, " ")} · {e.source}
                  </span>
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </HubLede>

    <div class="hub-grid">
      {
        doors.map((d) => (
          <a class="hub-door" id={d.id} href={d.href}>
            <div class="hub-door-top">
              <span class="hub-door-kind">{d.kind}</span>
              <span class="hub-door-count">{d.count}</span>
            </div>
            <div class="hub-door-title">{d.title}</div>
            <div class="hub-door-desc">{d.desc}</div>
            <div class="hub-door-foot">
              <span class="hub-door-browse">Browse</span>
              <span class="hub-door-note">{d.note}</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
