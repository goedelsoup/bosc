---
import { selectableSitePaths } from "@watermark/core/sites";
export const getStaticPaths = selectableSitePaths;
import Base from "~/layouts/Base.astro";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { ConceptItem } from "@watermark/core/feeds";
import { withSite } from "@watermark/core/site";

// Rendered under the middleware's active site, so this reads THIS site's scoped
// `concepts` feed — the network-global glossary plus only the terms tagged for
// this site (#1567). A peer never shows Lima's `sites:[lima]` concepts.
const concepts = hasFeed("concepts") ? loadFeed<ConceptItem[]>("concepts") : [];
---

<Base title="Glossary" section="site" rail={false}>
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">The record · glossary</div>
        <h1>Glossary</h1>
        <p class="hub-lead">
          Term and method definitions for this site — the shared network vocabulary
          plus the terms specific to this watershed point, cross-linked through the
          record with <code>[[wiki links]]</code>.
        </p>
      </div>
      <span class="hub-count">{concepts.length} concept(s)</span>
    </div>

    {concepts.length === 0 && <p class="stub-note">No concepts have been published for this site yet.</p>}

    <div class="hub-grid">
      {
        concepts.map((c) => (
          <a class="hub-door" href={`${withSite("/site/concepts/")}${c.slug}/`}>
            <div class="hub-door-top">
              <span class="hub-door-kind">
                {c.kind && c.kind !== "concept" ? c.kind : "Concept"}
              </span>
            </div>
            <div class="hub-door-title">{c.title}</div>
            {c.summary && <div class="hub-door-desc">{c.summary}</div>}
            <div class="hub-door-foot">
              <span class="hub-door-browse">Open</span>
              <span class="hub-door-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
