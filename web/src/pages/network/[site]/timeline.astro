---
import Base from "~/layouts/Base.astro";
import Timeline from "~/components/Timeline.astro";
import type { TimelineItem } from "@watermark/core/viz";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import { evidenceKind, type TimelineEntry } from "@watermark/core/feeds";
import { availableFacetPaths } from "@watermark/core/readiness";
import { activeWalkAnchorFor } from "@watermark/core/walk";
import { withStory } from "@watermark/core/site";

// The declared facet gate (#1886) — the `timeline` section already locked in the nav and the needs
// board, but the page itself rendered a headline claiming an argument over zero events. At the ROUTE
// since #1894: a site with no dated events builds no page, rather than one whose lock no door links
// and no search row names.
export function getStaticPaths() {
  return availableFacetPaths("timeline");
}

const { slug } = Astro.props as { slug: string };
const entries = hasFeed("timeline", slug) ? loadFeed<TimelineEntry[]>("timeline", slug) : [];
const isDated = (e: TimelineEntry): boolean => /^\d{4}/.test(e.date);
const dated = entries.filter(isDated).sort((a, b) => a.date.localeCompare(b.date));
const ordered = [...dated, ...entries.filter((e) => !isDated(e))];

const items: TimelineItem[] = ordered.map((e) => {
  const anchor =
    activeWalkAnchorFor(e.source) ?? (e.also_sources ?? []).map(activeWalkAnchorFor).find(Boolean);
  return {
    date: e.date || "",
    kind: e.category.replace(/_/g, " "),
    title: e.title,
    summary: e.detail ?? undefined,
    evidence: evidenceKind(e.citation),
    seenInCh: anchor?.ch,
    seenInHref: anchor ? withStory(`/${anchor.slug}`) : undefined,
  };
});
---

<Base
  title="Timeline"
  section="timeline"
  description="Every dated event in the record, ordered — confidentiality first, the public reveal last."
>
  <article class="prose">
    <h1>How the record was assembled — and withheld</h1>
    <p class="section-lead">
      {entries.length} events, cause → consequence — each traceable to the
      extraction that supplied it, the evidence node colored by its citation.
      Every beat carries its standing: verified events are sourced; open events
      mark where the record is still being fought for. The <strong>order is the
      argument</strong>: the confidentiality went on before the public ever heard
      the name.
    </p>
  </article>
  <div class="rb-list">
    <Timeline events={items} />
  </div>
</Base>
