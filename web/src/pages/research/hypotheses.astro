---
/**
 * The network directory (#304; route /research/hypotheses) — reimagined as a three-hypothesis
 * index (#308 "Directory" dictate): one network, read three ways. Every registered site
 * reorganizes around one of three hypotheses — H1 Water & Coercion (the live reference thesis),
 * H2 Defense & Federal Enclave, H3 Consumer Surveillance. The hypothesis switch is no-JS
 * (radio + :checked), so the page reads with JavaScript off, like every Watermark page.
 *
 * Discipline (see `lib/directory.ts`): H2/H3 are hypotheses under test. A site carries a
 * defense/surveillance entry only with a real, on-the-record fact; inference is labeled; the
 * rest are "Not yet assessed". H1's tier + doc/record counts are rolled up per row
 * from each site's OWN exported bundle (#1861) — real, or a dash where no bundle is committed.
 */
import Base from "~/layouts/Base.astro";
import { getHypotheses, hasFeed, loadFeed } from "@watermark/core/bundle";
import {
  buildHypothesisView,
  HYPOTHESIS_ORDER,
  hypothesisConfig,
  hypothesisCount,
  indexAssessments,
} from "@watermark/core/directory";
import type { HypothesisAssessmentItem } from "@watermark/core/feeds";
import { withBase } from "@watermark/core/site";
import { facilityStatus, siteRollup } from "@watermark/core/sites";
import { hypothesisHref } from "@watermark/core/wiki";

// The boom-origin hypotheses + their (site x hypothesis) evidence cells (#308) — now read from
// the bundle, no longer hardcoded in directory.ts. Each cell carries a Citation (provenance).
const hypItems = getHypotheses();
const hypByKey = new Map(hypItems.map((h) => [h.id, h]));
const cells = hasFeed("hypothesis-assessments")
  ? loadFeed<HypothesisAssessmentItem[]>("hypothesis-assessments")
  : [];
const assessments = indexAssessments(cells);

const hyps = HYPOTHESIS_ORDER.map((key) => ({
  cfg: hypothesisConfig(key, hypByKey.get(key)),
  view: buildHypothesisView(key, siteRollup, assessments, facilityStatus),
  count: hypothesisCount(key, assessments),
}));

const statusSwatch = (kind: "live" | "new") =>
  kind === "live"
    ? { color: "#1f6f4a", bg: "#e4ece4", dot: "#1f6f4a" }
    : { color: "#8c9389", bg: "#e8e4d8", dot: "#8c9389" };
---

<Base
  title="The three hypotheses"
  section="research"
  rail={false}
  description="The Watermark directory, read three ways: where compute meets water and power, where it meets the defense base, and who owns it. The same network of data-center watershed points across Ohio, scored under each hypothesis. Lima is the live reference build."
>
  <div class="dir">
    <div class="dir-head">
      <div class="dir-eyebrow">Watermark · directory · the three hypotheses</div>
      <h1>One network, three open questions</h1>
      <p class="dir-lead">
        The platform-level index now holds <b>{hyps[0].count}</b>. Each hypothesis asks one question
        about <i>why</i> the build-out is happening where it is, and carries a candidate answer that is
        under test — never a finding. The watershed thesis, where compute meets water and power, is the
        live reference build (Lima / BOSC); <b>defense &amp; federal-enclave</b> and <b>consumer
        surveillance</b> are opening alongside it. For what a build-out <i>does</i> to a place rather
        than why it is there, the five <a href={withBase("/lens/")}>lenses</a> read the same network
        descriptively — and reach no verdict at all.
      </p>
    </div>

    <div class="dir-hypwrap">
      {
        hyps.map((h) => (
          <input
            type="radio"
            name="dir-hyp"
            id={`hyp-${h.cfg.key}`}
            class="dir-hyp-input"
            checked={h.cfg.key === HYPOTHESIS_ORDER[0]}
            aria-label={`${h.cfg.n} — ${h.cfg.name}`}
          />
        ))
      }

      {/*
        Progressive enhancement (#1302): honor `?h=<id>` deep links. The no-JS
        radio + :checked switch above still drives selection on its own — here we
        only tick the matching radio on load, before the panes are parsed, so
        /research/hypotheses?h=defense opens on that hypothesis. An unknown/absent
        value leaves the default (water) checked. The `id`s already equal the
        hypothesis keys, so no mapping is needed.

        `?lens=<id>` is the pre-#1912 spelling of the same param. It is a public,
        shared deep link and keeps working indefinitely — `h` is only the canonical
        form we emit. Read with `||`, not `??`, so an empty `?h=` still falls back.
      */}
      <script is:inline>
        (() => {
          const params = new URLSearchParams(location.search);
          const id = params.get("h") || params.get("lens");
          if (!id) return;
          const radio = document.getElementById("hyp-" + id);
          if (radio instanceof HTMLInputElement && radio.name === "dir-hyp") {
            radio.checked = true;
          }
        })();
      </script>

      <div class="dir-hyp-cards">
        {
          hyps.map((h) => {
            const sw = statusSwatch(h.cfg.statusKind);
            return (
              <label
                for={`hyp-${h.cfg.key}`}
                class:list={["dir-hcard", `hc-${h.cfg.key}`]}
                style={`--acc:${h.cfg.accent};--accbg:${h.cfg.accentBg}`}
              >
                <span class="dir-hcard-top">
                  <span class="dir-hcard-n" style={`background:${h.cfg.accent}`}>{h.cfg.n}</span>
                  <span class="dir-hcard-status" style={`color:${sw.color};background:${sw.bg}`}>
                    <span class="dot" style={`background:${sw.dot}`} />
                    {h.cfg.status}
                  </span>
                  <span class="dir-hcard-check" style={`color:${h.cfg.accent}`}>✓</span>
                </span>
                <span class="dir-hcard-name">{h.cfg.name}</span>
                {/* The QUESTION heads the card (#1917); the claim is the candidate answer. */}
                <span class="dir-hcard-q">{h.cfg.question}</span>
                <span class="dir-hcard-claim">{h.cfg.claim}</span>
                <span class="dir-hcard-count">{h.count}</span>
              </label>
            );
          })
        }
      </div>

      <p class="dir-hyp-note">
        Not mutually exclusive — a single site can sit in all three. <b>Lima (BOSC)</b> is the worked example under each.
      </p>

      {
        hyps.map((h) => {
          const acc = h.cfg.accent;
          const sw = statusSwatch(h.cfg.statusKind);
          return (
            <div class:list={["dir-pane", `pane-${h.cfg.key}`]}>
              {/* Hypothesis framing */}
              <div class="dir-frame" style={`background:${h.cfg.accentBg};border-color:${h.cfg.accentBd}`}>
                <div class="dir-frame-l">
                  <div class="dir-frame-tags">
                    <span class="dir-frame-name" style={`color:${acc}`}>
                      {h.cfg.n} · {h.cfg.name}
                    </span>
                    <span class="dir-frame-status" style={`color:${sw.color};background:${sw.bg}`}>
                      <span class="dot" style={`background:${sw.dot}`} />
                      {h.cfg.status}
                    </span>
                  </div>
                  <div class="dir-frame-q">{h.cfg.question}</div>
                  <div class="dir-frame-claim">
                    <span class="dir-frame-claim-l">Candidate answer under test</span>
                    {h.cfg.claim}
                  </div>
                  <p class="dir-frame-blurb">{h.cfg.blurb}</p>
                  {h.cfg.key === "water" && (
                    <a class="dir-frame-link" href={withBase("/basin")}>
                      Open the basin view — every site against the drainage ›
                    </a>
                  )}
                  {/* This scorecard is a PROJECTION of the hypothesis (#1892): the canonical
                      record of the reading is its wiki node — definition, evidence matrix, and
                      the concepts, entities, and open questions it bears on. */}
                  <a class="dir-frame-link" href={hypothesisHref(h.cfg.key)}>
                    Read {h.cfg.n} as a wiki node — definition, related concepts, open questions ›
                  </a>
                </div>
                <div class="dir-frame-r">
                  <div class="dir-axis-title">{h.view.axisTitle}</div>
                  {h.view.axisGroups.map((ag) => (
                    <div class="dir-axis-group">
                      {ag.label && <div class="dir-axis-label">{ag.label}</div>}
                      <div class="dir-axis-chips">
                        {ag.chips.map((ch) => (
                          <span class="dir-achip">
                            {ch.name}
                            <span class="dir-achip-n">{ch.count}</span>
                          </span>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Cross-site scorecard */}
              <div class="dir-score">
                <div class="dir-score-head">
                  <div>
                    <div class="dir-score-eyebrow" style={`color:${acc}`}>Cross-site scorecard</div>
                    <h2 class="dir-score-title">{h.cfg.scoreTitle}</h2>
                  </div>
                  <span class="dir-score-note">{h.cfg.scoreNote}</span>
                </div>

                <div class="dir-table">
                  <div class="dir-trow dir-thead" style={`grid-template-columns:${h.view.gridCols}`}>
                    {h.view.cols.map((c) => (
                      <span class:list={["dir-th", { "is-right": c.align === "right" }]}>{c.label}</span>
                    ))}
                  </div>

                  {h.view.groups.map((g) => (
                    <div class="dir-group">
                      {g.banner && (
                        <div class="dir-divide" style={`color:${acc}`}>
                          <span class="dir-divide-l">{g.banner.label}</span>
                          <span class="dir-divide-n">{g.banner.note}</span>
                        </div>
                      )}
                      <div class="dir-grouphead">
                        <span class="dir-group-abbr" style={`color:${acc}`}>{g.abbr}</span>
                        <span class="dir-group-label">{g.label}</span>
                        <span class="dir-group-count">{g.count}</span>
                      </div>
                      {g.kind === "rows" ? (
                        g.rows.map((r) => (
                          <a
                            class:list={["dir-trow", "dir-drow", { "is-live": r.live }]}
                            href={withBase(r.href)}
                            style={`grid-template-columns:${h.view.gridCols}`}
                          >
                            {r.cells.map((c) =>
                              c.kind === "site" ? (
                                <span class="dir-cell-site">
                                  <span class="dir-badge" style={`background:${c.badgeBg};color:${c.badgeColor}`}>
                                    {c.badge}
                                  </span>
                                  <span class="dir-place">{c.place}</span>
                                </span>
                              ) : c.kind === "num" ? (
                                <span class:list={["dir-cell-num", { "is-muted": c.muted }]}>{c.text}</span>
                              ) : c.kind === "pill" && c.pill ? (
                                <span>
                                  <span class="dir-pill" style={`color:${c.pill.color};background:${c.pill.bg}`}>
                                    <span class="dot" style={`background:${c.pill.dot}`} />
                                    {c.pill.label}
                                  </span>
                                </span>
                              ) : (
                                <span class:list={["dir-cell-text", { "is-muted": c.muted }]}>{c.text}</span>
                              ),
                            )}
                          </a>
                        ))
                      ) : (
                        <div class="dir-chips">
                          {g.chips.map((ch) => (
                            <a class="dir-chip" href={withBase(ch.href)}>
                              <span class="dot" style={`background:${ch.dot}`} />
                              {ch.place}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}

                  <div class="dir-foot">{h.cfg.footNote}</div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Base>

<style>
  .dir {
    max-width: 1240px;
    margin: 0 auto;
  }
  .dir-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bosc-forest);
    font-weight: 700;
  }
  .dir-head h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0.3rem 0 0.4rem;
  }
  .dir-lead {
    max-width: 60rem;
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--bosc-muted);
    margin: 0;
  }

  /* The no-JS hypothesis switch: radios drive the active card + the visible pane. */
  .dir-hyp-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .dir-hyp-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    margin-top: 1.6rem;
  }
  .dir-hcard {
    display: flex;
    flex-direction: column;
    cursor: pointer;
    background: #f5f2ea;
    border: 1.5px solid #dcd8cc;
    border-radius: 14px;
    padding: 1rem 1.05rem;
    box-shadow: 0 1px 3px rgba(20, 24, 40, 0.05);
    transition:
      border-color 0.12s ease,
      box-shadow 0.12s ease;
  }
  .dir-hcard:hover {
    border-color: #8c9389;
  }
  .dir-hcard-top {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .dir-hcard-n {
    font-size: 0.68rem;
    font-weight: 800;
    font-family: var(--bosc-mono);
    color: #f5f2ea;
    border-radius: 6px;
    padding: 2px 8px;
  }
  .dir-hcard-status,
  .dir-frame-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.64rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 2px 9px;
  }
  .dir-hcard-status .dot,
  .dir-frame-status .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }
  .dir-hcard-check {
    margin-left: auto;
    font-weight: 800;
    font-size: 0.88rem;
    display: none;
  }
  .dir-hcard-name {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-top: 0.7rem;
  }
  .dir-hcard-q {
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.4;
    margin-top: 0.5rem;
  }
  .dir-hcard-claim {
    font-size: 0.82rem;
    color: var(--bosc-muted);
    line-height: 1.45;
    margin-top: 0.25rem;
  }
  .dir-hcard-count {
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    border-top: 1px solid #ece8dc;
    font-size: 0.72rem;
    color: #8c9389;
    font-family: var(--bosc-mono);
  }
  .dir-hyp-note {
    font-size: 0.79rem;
    color: #8c9389;
    line-height: 1.5;
    margin: 0.7rem 0 0;
  }

  /* Active card + visible pane, driven by the matching radio. */
  #hyp-water:checked ~ .dir-hyp-cards .hc-water,
  #hyp-defense:checked ~ .dir-hyp-cards .hc-defense,
  #hyp-surveillance:checked ~ .dir-hyp-cards .hc-surveillance {
    border-color: var(--acc);
    background: var(--accbg);
    box-shadow: 0 8px 22px rgba(20, 24, 40, 0.12);
  }
  #hyp-water:checked ~ .dir-hyp-cards .hc-water .dir-hcard-check,
  #hyp-defense:checked ~ .dir-hyp-cards .hc-defense .dir-hcard-check,
  #hyp-surveillance:checked ~ .dir-hyp-cards .hc-surveillance .dir-hcard-check {
    display: inline;
  }
  #hyp-water:focus-visible ~ .dir-hyp-cards .hc-water,
  #hyp-defense:focus-visible ~ .dir-hyp-cards .hc-defense,
  #hyp-surveillance:focus-visible ~ .dir-hyp-cards .hc-surveillance {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }

  .dir-pane {
    display: none;
  }
  #hyp-water:checked ~ .pane-water,
  #hyp-defense:checked ~ .pane-defense,
  #hyp-surveillance:checked ~ .pane-surveillance {
    display: block;
  }

  /* Hypothesis framing */
  .dir-frame {
    margin-top: 1.3rem;
    border: 1px solid #dcd8cc;
    border-radius: 14px;
    padding: 1.25rem 1.35rem;
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
  }
  .dir-frame-l {
    flex: 1 1 380px;
    min-width: 300px;
  }
  .dir-frame-r {
    flex: 1 1 300px;
    min-width: 280px;
  }
  .dir-frame-tags {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .dir-frame-name {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 800;
  }
  .dir-frame-q {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin-top: 0.55rem;
    max-width: 32rem;
  }
  .dir-frame-claim {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--bosc-muted);
    margin-top: 0.6rem;
  }
  .dir-frame-claim-l {
    display: block;
    font-family: var(--bosc-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--bosc-faint);
    margin-bottom: 0.15rem;
  }
  .dir-frame-blurb {
    font-size: 0.84rem;
    line-height: 1.55;
    color: #3a4036;
    margin: 0.6rem 0 0;
    max-width: 36rem;
  }
  .dir-frame-link {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--bosc-forest);
    text-decoration: none;
  }
  .dir-frame-link:hover {
    text-decoration: underline;
  }
  .dir-axis-title {
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c9389;
    font-weight: 700;
    margin-bottom: 0.7rem;
  }
  .dir-axis-group {
    margin-bottom: 0.65rem;
  }
  .dir-axis-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: #566159;
    margin-bottom: 0.4rem;
  }
  .dir-axis-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .dir-achip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #3a4036;
    background: #f5f2ea;
    border: 1px solid #dcd8cc;
    border-radius: 999px;
    padding: 3px 11px;
  }
  .dir-achip-n {
    font-size: 0.66rem;
    color: #8c9389;
    font-family: var(--bosc-mono);
  }

  /* Cross-site scorecard */
  .dir-score {
    margin-top: 1.9rem;
  }
  .dir-score-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .dir-score-eyebrow {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .dir-score-title {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0.3rem 0 0;
  }
  .dir-score-note {
    font-size: 0.78rem;
    color: #8c9389;
    max-width: 24rem;
    text-align: right;
  }
  .dir-table {
    border: 1px solid #dcd8cc;
    border-radius: 14px;
    overflow: hidden;
  }
  .dir-trow {
    display: grid;
    column-gap: 1rem;
    align-items: center;
  }
  .dir-thead {
    background: var(--bosc-surface);
    border-bottom: 1px solid #dcd8cc;
    padding: 0.7rem 1.1rem;
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8c9389;
    font-weight: 700;
  }
  .dir-th.is-right {
    text-align: right;
  }
  .dir-divide {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.8rem 1.1rem 0.55rem;
    background: #ece8dc;
  }
  .dir-divide-l {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .dir-divide-n {
    font-size: 0.72rem;
    color: #8c9389;
  }
  .dir-grouphead {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1.1rem;
    background: var(--bosc-surface);
    border-bottom: 1px solid #ece8dc;
  }
  .dir-group-abbr {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    background: #ece8dc;
    border: 1px solid #cdc8b8;
    border-radius: 5px;
    padding: 2px 7px;
    font-family: var(--bosc-mono);
  }
  .dir-group-label {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #566159;
  }
  .dir-group-count {
    margin-left: auto;
    font-size: 0.68rem;
    color: #8c9389;
    font-family: var(--bosc-mono);
  }
  /* Each row is a link to the site it names (#1862) — the row IS the click target, so the
     anchor carries no underline and inherits the ink; hover is the only affordance. */
  .dir-drow {
    padding: 0.65rem 1.1rem;
    border-bottom: 1px solid #ece8dc;
    background: #f5f2ea;
    color: inherit;
    text-decoration: none;
    transition: background 0.12s ease;
  }
  .dir-drow.is-live {
    background: #eef1e8;
  }
  .dir-drow:hover,
  .dir-drow:focus-visible {
    background: #e4ece4;
  }
  .dir-drow:hover .dir-place {
    text-decoration: underline;
  }
  .dir-cell-site {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }
  .dir-badge {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.58rem;
    font-weight: 800;
    font-family: var(--bosc-mono);
  }
  .dir-place {
    font-size: 0.86rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dir-cell-text {
    font-size: 0.78rem;
    line-height: 1.35;
    color: #566159;
  }
  .dir-cell-text.is-muted {
    color: #8c9389;
  }
  .dir-cell-num {
    text-align: right;
