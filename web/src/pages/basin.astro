---
/**
 * The basin view (#308/#323; design "Basin — Maumee", branch design/basin-view) — every
 * watershed point in the basin read against the one drainage it draws from: a hero ledger,
 * the schematic HUC map, the on-record aggregates, the site table, and the receiving outfalls.
 *
 * Discipline (see `lib/basin.ts`): figures are computed from the registry + the `network`
 * feed or they are a dash. The design mock's placeholder projections (cumulative draw vs. a
 * modeled cap, per-site draw bars) have no backing feed, so the honest on-record equivalents
 * render instead — the receiving WWTPs' NPDES design flows, the assembled dilution screens,
 * and the one estimated IT load. The gaps section says exactly what's missing.
 *
 * Sits under the Research tab (design "Chrome": Research ▾ → Basin views → Maumee).
 */
import EvidenceTag from "../components/EvidenceTag.astro";
import LineChart from "../components/charts/LineChart.astro";
import RankedBarChart from "../components/charts/RankedBarChart.astro";
import Base from "../layouts/Base.astro";
import {
  basinSiteRows,
  cumulativeFlowSeries,
  designFlowBars,
  dischargeRows,
  estimatedItLoad,
  hucRange,
  nodeIndex,
  outletHydrographSeries,
  PHASE_INK,
  phaseSplit,
  reachAttenuationRows,
  totalDesignFlow,
} from "../lib/basin";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import type { EvidenceKind } from "@watermark/core/evidence";
import type { BasinNetwork, RoutedHydrographNetwork } from "@watermark/core/feeds";
import { withBase } from "@watermark/core/site";
import { groupSites, siteState } from "@watermark/core/sites";

const group = groupSites("basin").find((g) => g.label === "Maumee");
const sites = group?.sites ?? [];

const net = hasFeed("network") ? loadFeed<BasinNetwork>("network") : null;
const nodes = net?.nodes ?? [];
const byNode = nodeIndex(nodes);

// The loop's design-storm hydrograph routed down the cited confluence graph (#1184) — present
// only for the reference build (the routed feed is Lima-loop-specific). Absent → the section hides.
const routed = hasFeed("routed-hydrograph") ? loadFeed<RoutedHydrographNetwork>("routed-hydrograph") : null;

// --- hero ledger — registry counts + what the feed actually carries ------------------------
const states = [...new Set(sites.map((s) => siteState(s.slug)).filter(Boolean))];
const liveBuilding = sites.filter((s) => s.status === "live" || s.status === "building");
const load = estimatedItLoad(nodes);
const flowTot = totalDesignFlow(nodes);

interface Tile {
  label: string;
  value: string;
  unit?: string;
  sub?: string;
  evidence: EvidenceKind;
  basis?: "grounded" | "modeled";
  source?: string;
}
const tiles: Tile[] = [
  {
    label: "Sites",
    value: String(sites.length),
    sub: states.join(" · ") || undefined,
    evidence: "verified",
    source: "The network registry (data/sites.yaml)",
  },
  {
    label: "Live + building",
    value: String(liveBuilding.length),
    sub: liveBuilding.map((s) => s.place).join(" · ") || undefined,
    evidence: "verified",
    source: "Site build phase — the registry's first clock",
  },
  load.count > 0
    ? {
        label: "Estimated IT load",
        value: String(Math.round(load.mw)),
        unit: "MW",
        sub: `est. across ${load.count} of ${sites.length} sites with a facility on file`,
        evidence: "inference",
        basis: "modeled",
        source: "Read from filed permits — a labelled derivation, not a meter",
      }
    : { label: "Estimated IT load", value: "—", sub: "no facility load on file", evidence: "open" },
  flowTot.count > 0
    ? {
        label: "Receiving design flow",
        value: flowTot.mgd.toLocaleString("en-US"),
        unit: "MGD",
        sub: `${flowTot.count} receiving WWTPs · NPDES`,
        evidence: "verified",
        source: "EPA ECHO ICIS-NPDES design flows",
      }
    : { label: "Receiving design flow", value: "—", sub: "no design flows on file", evidence: "open" },
];

// --- aggregates + drill-downs ---------------------------------------------------------------
const cumFlow = cumulativeFlowSeries(nodes, sites);
const flowBars = designFlowBars(nodes);
const phases = phaseSplit(sites);
const phaseTotal = phases.reduce((a, p) => a + p.count, 0);
const rows = basinSiteRows(sites, byNode);
const outfalls = dischargeRows(nodes, sites);
const outletSeries = routed ? outletHydrographSeries(routed) : [];
const reachRows = routed ? reachAttenuationRows(routed.reaches) : [];
const screenedCount = outfalls.filter((o) => o.evidence === "verified").length;
const openCount = rows.filter((r) => r.evidence === "open").length;
const verifiedCount = rows.filter((r) => r.evidence === "verified").length;
const subbasins = [...new Set(nodes.map((n) => n.subtree))];
const huc = hucRange(nodes);

// --- the schematic map (presentational geography — simplified from USGS WBD, not to scale) --
// Marker positions are design coordinates from the "Basin — Maumee" mock, keyed by slug so
// the markers themselves (presence, phase ink, badge) stay registry-driven.
const MAP_XY: Record<string, { x: number; y: number }> = {
  lima: { x: 372, y: 470 },
  "fort-wayne": { x: 96, y: 330 },
  defiance: { x: 322, y: 300 },
  findlay: { x: 486, y: 410 },
  toledo: { x: 686, y: 138 },
  "van-wert": { x: 158, y: 420 },
  bryan: { x: 148, y: 208 },
  ottawa: { x: 558, y: 352 },
};
const markers = sites
  .filter((s) => MAP_XY[s.slug])
  .map((s) => ({ ...MAP_XY[s.slug], code: s.codename ?? s.mono, ink: PHASE_INK[s.status] }));
// A diamond marks an outfall whose dilution screen is assembled — the map's only evidence mark.
const diamonds = outfalls
  .filter((o) => o.evidence === "verified" && MAP_XY[o.slug])
  .map((o) => ({ x: MAP_XY[o.slug].x, y: MAP_XY[o.slug].y + 30 }));

const EV_INK: Record<string, string> = {
  verified: "var(--ev-verified-fg)",
  inference: "var(--ev-inference-fg)",
  open: "var(--ev-open-fg)",
};
---

<Base
  title="The Maumee basin"
  section="research"
  rail={false}
  description="Every watershed-point site in the Maumee basin, read against one drainage: the schematic HUC map, the receiving WWTPs' NPDES design flows, the assembled dilution screens, and the gaps in the record. A lead, not a verdict."
>
  <div class="basin">
    <!-- ===================== HERO ===================== -->
    <header class="basin-hero">
      <div class="basin-hero-l">
        <div class="basin-eyebrow">Research · basin view</div>
        <div class="basin-title-row">
          <h1>Maumee basin</h1>
          {huc && <span class="basin-huc">HUC-8 · {huc}</span>}
        </div>
        <p class="basin-dek">
          {sites.length} sites, one watershed. Fort Wayne's headwaters, the Auglaize and Blanchard
          confluences, the Ottawa River draw at Lima — every intake and outfall in the basin, read
          against one drainage. This is a lead, not a verdict: most of the basin has no filed water
          record yet, and a gap below is an open question, never a zero.
        </p>
      </div>
      <div class="basin-tiles">
        {
          tiles.map((t) => (
            <div class="basin-tile">
              <div class="basin-tile-head">
                <span class="basin-tile-label">{t.label}</span>
                {t.basis && <span class="basin-basis">{t.basis}</span>}
              </div>
              <div class="basin-tile-value">
                <span class="v">{t.value}</span>
                {t.unit && <span class="u">{t.unit}</span>}
              </div>
              {t.sub && <div class="basin-tile-sub">{t.sub}</div>}
              <div class="basin-tile-foot">
                <EvidenceTag kind={t.evidence} title={t.source} />
              </div>
            </div>
          ))
        }
      </div>
    </header>

    <!-- ===================== THE MAP ===================== -->
    <section class="basin-sec" aria-label="The watershed, mapped">
      <div class="basin-sec-head">
        <span class="basin-kicker">The watershed, mapped</span>
        <h2>Every site, against the drainage it draws from</h2>
        <span class="basin-sec-note">Schematic basin diagram — simplified from USGS HUC boundaries, not to scale</span>
      </div>
      <div class="basin-map-grid">
        <div class="basin-map-canvas">
          <svg viewBox="0 0 760 560" role="img" aria-label="Schematic map of the Maumee basin with every site marked">
            <path
              d="M60,320 C40,230 90,150 170,130 C230,90 320,70 420,90 C520,70 620,60 680,110 C740,150 730,220 700,260 C740,300 720,360 660,380 C680,430 640,480 570,470 C540,520 470,540 410,520 C340,560 260,545 220,500 C150,510 90,470 80,410 C40,390 40,350 60,320 Z"
              fill="var(--bone-band)"
              stroke="var(--rule-ink)"
              stroke-width="2"></path>
            <path d="M60,320 C40,230 90,150 170,130 C210,160 230,230 200,290 C210,340 180,380 130,390 C90,380 60,350 60,320 Z" fill="rgba(31,111,74,0.07)"></path>
            <path d="M200,290 C230,230 210,160 170,130 C230,90 320,70 420,90 C400,150 380,210 340,250 C300,280 240,290 200,290 Z" fill="rgba(31,111,74,0.045)"></path>
            <path d="M420,90 C520,70 620,60 680,110 C700,150 690,190 650,210 C580,200 500,180 450,150 C430,130 420,110 420,90 Z" fill="rgba(31,111,74,0.07)"></path>
            <path d="M340,380 C400,360 460,380 490,430 C470,480 400,510 340,500 C300,470 300,420 340,380 Z" fill="rgba(31,111,74,0.06)"></path>
            <path d="M660,380 C700,360 730,300 700,260 C740,300 720,360 660,380 Z" fill="rgba(31,111,74,0.09)"></path>

            <path d="M700,110 C740,120 760,150 750,190 C730,180 700,160 680,140 Z" fill="var(--bone-sunk)" stroke="var(--line-hair)" stroke-width="1.5"></path>
            <text x="755" y="95" text-anchor="end" class="basin-map-mono">LAKE ERIE</text>

            <path d="M96,330 C150,300 220,290 260,270 C300,250 320,240 322,300" fill="none" stroke="var(--ink-muted)" stroke-width="2"></path>
            <path d="M158,420 C210,390 250,340 260,290" fill="none" stroke="var(--ink-muted)" stroke-width="1.6"></path>
            <path d="M148,208 C200,220 260,250 300,270" fill="none" stroke="var(--ink-muted)" stroke-width="1.6"></path>
            <path d="M322,300 C400,280 470,240 520,190 C560,160 620,150 686,138" fill="none" stroke="var(--ink)" stroke-width="3.5"></path>
            <path d="M486,410 C520,360 540,300 520,190" fill="none" stroke="var(--ink-muted)" stroke-width="1.8"></path>
            <path d="M558,352 C540,330 525,260 520,190" fill="none" stroke="var(--ink-muted)" stroke-width="1.5"></path>
            <path d="M372,470 C400,420 400,350 400,300 C420,260 470,230 520,190" fill="none" stroke="var(--ink-muted)" stroke-width="1.8"></path>

            <ellipse cx="372" cy="470" rx="70" ry="46" fill="none" stroke="var(--forest)" stroke-width="1.5" stroke-dasharray="5,4"></ellipse>
            <text x="372" y="528" text-anchor="middle" class="basin-map-mono is-forest">buried-valley aquifer draw</text>

            <text x="150" y="150" class="basin-map-label">St. Joseph / St. Marys hd.</text>
            <text x="330" y="230" class="basin-map-label">Auglaize River</text>
            <text x="500" y="330" class="basin-map-label">Blanchard River</text>
            <text x="410" y="550" class="basin-map-label">Ottawa River</text>

            {diamonds.map((d) => (
              <rect x={d.x - 6} y={d.y - 6} width="12" height="12" transform={`rotate(45 ${d.x} ${d.y})`} fill="var(--forest)" stroke="var(--bone-surface)" stroke-width="1.2" />
            ))}
            {markers.map((m) => (
              <g transform={`translate(${m.x},${m.y})`}>
                <rect x="-9" y="-9" width="18" height="18" fill={m.ink} stroke="var(--bone-surface)" stroke-width="1.5" />
                <text x="0" y="-15" text-anchor="middle" class="basin-map-code">{m.code}</text>
              </g>
            ))}
          </svg>
        </div>
        <aside class="basin-map-panel">
          <div class="basin-map-block">
            <div class="basin-kicker">Layer key</div>
            <div class="basin-legend">
              {phases.map((p) => (
                <span class="basin-legend-row"><span class="basin-legend-sq" style={`background:${p.ink};border-color:${p.ink}`}></span>{p.label}</span>
              ))}
              <span class="basin-legend-rule"></span>
              <span class="basin-legend-row"><span class="basin-legend-dm" style="background:var(--ev-verified-fg)"></span>Outfall · dilution screen on record</span>
              <span class="basin-legend-rule"></span>
              <span class="basin-legend-row"><span class="basin-legend-aq"></span>Aquifer draw zone</span>
              <span class="basin-legend-row"><span class="basin-legend-rv"></span>River / tributary</span>
            </div>
          </div>
          {
            subbasins.length > 0 && (
              <div class="basin-map-block grows">
                <div class="basin-kicker">Sub-basins on the record</div>
                <div class="basin-map-subs">
                  {subbasins.map((sb) => (
                    <span>{sb}</span>
                  ))}
                </div>
              </div>
            )
          }
          <div class="basin-map-src">Boundary source: USGS WBD, simplified for legibility. Not for engineering use.</div>
        </aside>
      </div>
    </section>

    <!-- ===================== AGGREGATE (on the record) ===================== -->
    <section class="basin-sec" aria-label="Aggregate across the basin">
      <div class="basin-sec-head">
        <span class="basin-kicker">Aggregate across the basin</span>
        <h2>The receiving system — one site at a time, stacked</h2>
      </div>
      {
        flowTot.count > 0 ? (
          <div class="basin-agg-grid">
            <div class="basin-panel">
              <div class="basin-panel-t">Cumulative receiving design flow, upstream → downstream</div>
              <div class="basin-panel-s">
                Running total of the WWTPs' NPDES design flows — the treatment capacity any new load in this basin lands on
              </div>
              <LineChart
                kicker="Line · cumulative"
                title="Receiving design flow, stacked across the basin"
                data={cumFlow.points}
                endLabel={`${cumFlow.totalMgd.toLocaleString("en-US")} MGD`}
                evidence="verified"
                source="EPA ECHO ICIS-NPDES design flows"
                caption={cumFlow.skipped > 0 ? `${cumFlow.skipped} node(s) carry no design flow on file and are not stacked.` : undefined}
              />
            </div>
            <div class="basin-panel">
              <div class="basin-panel-t">Site count by build phase</div>
              <div class="basin-panel-s">{phases.map((p) => `${p.count} ${p.label.toLowerCase()}`).join(" · ")}</div>
              <div class="basin-phasebar" role="img" aria-label={`Build phase split across ${phaseTotal} sites`}>
                {phases.map((p) => (
                  <span style={`flex:${p.count};background:${p.ink}`} />
                ))}
              </div>
              <div class="basin-phasebar-legend">
                {phases.map((p) => (
                  <span class="basin-legend-row"><span class="basin-legend-sq" style={`background:${p.ink};border-color:${p.ink}`}></span><b>{p.count}</b>&nbsp;{p.label}</span>
                ))}
              </div>
              <div class="basin-panel-rule"></div>
              <div class="basin-panel-t">Receiving WWTP design flow by site</div>
              <RankedBarChart kicker="Bar · ranked" title="NPDES design flow (MGD)" data={flowBars} unit="MGD" evidence="verified" source="EPA ECHO ICIS-NPDES" />
            </div>
          </div>
        ) : (
          <p class="basin-stub">No receiving design flows are on file yet — the aggregates render once the network feed carries them.</p>
        )
      }
      <p class="basin-agg-note">
        {
          load.count > 0
            ? `${load.count} of ${sites.length} sites carries an estimated facility load${verifiedCount > 0 ? ` and ${verifiedCount} a screened facility record` : ""}; none carries a filed draw volume — the water figure behind any projection is still open.`
            : "No site in this basin carries an estimated facility load or a filed draw volume."
        }
        The design flows above are the receiving plants' permitted capacity — the denominator any projected draw must be read
        against, not a measure of the draw itself. A projected basin total would be an open range, not a claim.
      </p>
    </section>

    <!-- ===================== SITES IN THIS BASIN ===================== -->
    <section class="basin-sec" aria-label="The sites in this basin">
      <div class="basin-sec-head">
        <span class="basin-kicker">Drill down</span>
        <h2>The {sites.length} sites in this basin</h2>
      </div>
      <div class="basin-table">
        <div class="basin-tr basin-th">
          <span></span><span>Code</span><span>Place</span><span>Sub-basin</span><span>Phase</span><span class="ta-r">Draw record</span>
        </div>
        {
          rows.map((r) => (
            <a class="basin-tr basin-row" href={withBase(r.href)}>
              <span class="basin-row-mark" style={`background:${r.phaseInk}`} />
              <span class="basin-row-code">{r.code}</span>
              <span class="basin-row-place">{r.place}</span>
              <span class="basin-row-sub">{r.subbasin}</span>
              <span class="basin-row-phase" style={`color:${r.phaseInk}`}>
                <span class="basin-row-dot" style={`background:${r.phaseInk}`} />
                {r.phaseLabel}
              </span>
              <span class="ta-r">
                <EvidenceTag kind={r.evidence} />
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ===================== ROUTED STORM HYDROGRAPH (#1184) ===================== -->
    {
      routed && (
        <section class="basin-sec" aria-label="Routed storm hydrograph">
          <div class="basin-sec-head">
            <span class="basin-kicker">Routed downstream · Tier-0 Muskingum–Cunge</span>
            <h2>The design-storm peak, routed — attenuated and lagged, not summed</h2>
          </div>
          <p class="basin-sec-dek">
            The {routed.return_period_yr}-yr, 24-hr design storm ({routed.storm_depth_in.toFixed(2)} in) generated at each
            contributing subcatchment and routed down the cited confluence graph. A downstream reach sees a peak that is
            attenuated and delayed — not the arithmetic sum of the tributary peaks a naive stack would give.
          </p>
          <div class="basin-agg-grid">
            <div class="basin-panel">
              <div class="basin-panel-t">Routed outlet hydrograph (cfs)</div>
              <div class="basin-panel-s">
                Ottawa River at the outlet; the dashed line marks the naive summed peak the outlet would see with no channel
                routing — the routed line peaks below it, and later.
              </div>
              <LineChart
                kicker="Line · outlet hydrograph"
                title={`Routed discharge at the outlet · ${routed.return_period_yr}-yr storm`}
                data={outletSeries}
                max={Math.ceil((routed.summed_peak_cfs * 1.08) / 100) * 100}
                endLabel={`${Math.round(routed.routed_peak_cfs).toLocaleString("en-US")} cfs`}
                refs={[
                  {
                    value: routed.summed_peak_cfs,
                    label: `naive sum ${Math.round(routed.summed_peak_cfs).toLocaleString("en-US")} cfs`,
                    color: "var(--td-amber-text)",
                  },
                ]}
                evidence="inference"
                source="Tier-0 Muskingum–Cunge routing of the SCS design-storm hydrographs (watermark basin-route)"
              />
            </div>
            <div class="basin-panel">
              <div class="basin-panel-t">What routing buys over the naive sum</div>
              <div class="basin-hydro-stats">
                <div class="basin-hydro-stat">
                  <b>{routed.peak_attenuation_pct.toFixed(1)}%</b>
                  <span>peak attenuation</span>
                </div>
                <div class="basin-hydro-stat">
                  <b>{routed.lag_hr.toFixed(1)} h</b>
                  <span>peak lag</span>
                </div>
                <div class="basin-hydro-stat">
                  <b>
                    {Math.round(routed.summed_peak_cfs).toLocaleString("en-US")} →{" "}
                    {Math.round(routed.routed_peak_cfs).toLocaleString("en-US")}
                  </b>
                  <span>summed → routed peak (cfs)</span>
                </div>
              </div>
              <div class="basin-panel-rule" />
              <div class="basin-panel-t">Per-reach attenuation + lag</div>
              <div class="basin-table basin-hydro-table">
                <div class="basin-tr basin-th">
                  <span>Reach</span>
                  <span class="ta-r">Length (ft)</span>
                  <span class="ta-r">In peak</span>
                  <span class="ta-r">Out peak</span>
                  <span class="ta-r">Atten.</span>
                  <span class="ta-r">Lag</span>
                </div>
                {reachRows.map((r) => (
                  <div class="basin-tr">
                    <span class="basin-row-place">{r.reach}</span>
                    <span class="ta-r">{r.lengthFt.toLocaleString("en-US")}</span>
                    <span class="ta-r">{Math.round(r.inflowPeakCfs).toLocaleString("en-US")}</span>
                    <span class="ta-r">{Math.round(r.outflowPeakCfs).toLocaleString("en-US")}</span>
                    <span class="ta-r">{r.attenuationPct.toFixed(1)}%</span>
                    <span class="ta-r">{r.lagHr.toFixed(1)} h</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <p class="basin-agg-note">
            Tier-0 screening — constant-parameter Muskingum–Cunge over reach geometry + subcatchments that are cited where
            derivable (WBD watershed areas, Hack's-law channel lengths) and stated assumptions otherwise (slopes, curve
            numbers), not a calibrated HEC-RAS model. The attenuation + lag are robust to the absolute areas; the finding is
            that the routed peak is smaller and later than the sum, so a downstream reach is not sized by stacking tributary peaks.
          </p>
        </section>
      )
    }

    <!-- ===================== DISCHARGE POINTS ===================== -->
    <section class="basin-sec" aria-label="Discharge points">
      <div class="basin-sec-head">
        <span class="basin-kicker">Drill down · discharge points</span>
        <h2>Where the basin's outfalls actually are</h2>
      </div>
      <p class="basin-sec-dek">
        The NPDES-permitted municipal outfalls that would receive any new load.
        {
          outfalls.length > 0
            ? ` ${screenedCount} of ${outfalls.length} carry an assembled dilution screen; the rest discharge to ungaged tributaries or carry no ECHO receiving water — the gap is itself a finding. Each opens its site's record.`
            : " The outfall inventory renders once the network feed is assembled."
        }
      </p>
      {
        outfalls.length > 0 ? (
          <div class="basin-outfalls">
            {outfalls.map((o) => (
              <a class="basin-outfall" href={withBase(o.href)} style={`border-left-color:${EV_INK[o.evidence] ?? "var(--ink-muted)"}`}>
                <span class="basin-outfall-dm" style={`background:${EV_INK[o.evidence] ?? "var(--ink-muted)"}`} />
                <span class="basin-outfall-body">
                  <span class="basin-outfall-t">{o.title}</span>
                  <span class="basin-outfall-m">{o.meta}</span>
                </span>
                {o.flag && <span class:list={["basin-flag", `is-${o.flag}`]}>{o.flag}</span>}
                <span class="basin-outfall-flow">{o.flow}</span>
                <EvidenceTag kind={o.evidence} />
                <span class="basin-outfall-ch">›</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="basin-stub">No outfall inventory is available yet — the rows render once the `network` feed is assembled.</p>
        )
      }
    </section>

    <!-- ===================== FOOTER / GAPS ===================== -->
    <div class="basin-foot">
      <div class="basin-foot-gaps">
        ⚠ <b>Gaps in the record:</b> {openCount} of {sites.length} sites in this basin have no filed water or facility
        record. The aggregate figures above count only what's on the record — read the record column before citing a
        basin total.
      </div>
      <div class="basin-foot-actions">
