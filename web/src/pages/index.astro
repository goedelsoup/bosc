---
/**
 * The network directory — the "Directory" tab (network tier). The lighter overview
 * (design "Directory - Home"): a hero, the network-at-a-glance ledger, the five LENSES,
 * the open questions, the "start here" doors, and a featured slice of the network.
 *
 * ## Why the lenses lead (#1916, epic #1911 phase 4)
 *
 * The front door used to be the three hypotheses — three cards, all linking to the same
 * scorecard, under a hero whose primary CTA was "Explore the hypotheses". That asks a
 * first-time reader to adjudicate a causal thesis about a national build-out before they
 * have seen a single figure. Somebody who arrived because a data center is going up in
 * their county wants to know what it takes, what it costs, and who decided.
 *
 * So the lens band is the first section below the hero, in the buildout's own causal order,
 * and the hypotheses sit below it reframed as what they are: **the open questions**. The
 * demotion is POSITIONAL, not a downgrade — they keep their H1/H2/H3 numbering and their
 * reference/emerging status, every one is still one click from here, and the scorecard is
 * still linked from the band head. A question asked second is not a question retracted.
 *
 * ## The map IS the ledger (#2044, epic #2033)
 *
 * The hero's right column used to be "Network at a glance": a six-cell stat grid over two stacked
 * distribution bars. #2036 then added the locator map as its own band underneath. That gave the
 * front door **two** summaries of one network — one numeric, one geographic — stacked.
 *
 * They are now one. The map occupies the ledger's slot and four headline numbers sit under it:
 * **sites, basins, documents, open to read**. `Open to read` is the registry's `selectable` count,
 * which is exactly the set the map's forest rings mark — the number and the glyph reinforce each
 * other rather than introducing a fourth vocabulary, and it is the only one of the four that
 * answers "what can I do next".
 *
 * The build-phase and readiness-tier bars come off entirely. Nothing is lost from the build: both
 * are already filter facets AND per-row pill columns on `/network`, one click away, and the map's
 * own key encodes build phase. The home stops asserting two distributions above the fold to a
 * reader who has not yet been handed the vocabulary to read them — `/network`'s three-clock
 * footnote is where that vocabulary lives.
 *
 * ⚠️ Note for anyone reading #2036's history: it had to justify putting a band ABOVE the lens
 * band, on the grounds that a locator is navigation rather than argument. That band no longer
 * exists. With the map folded into the hero, **the lens band is once again the first section
 * below the hero** — #1916's arrangement, restored rather than argued with.
 *
 * Real data only — sites from `bosc.sites` (mirrored in lib/sites), the hypothesis config
 * from lib/directory + the bundle feeds, the lens counts measured across every registered
 * site's own manifest. Figures are counts or a dash, never invented.
 */
import Base from "../layouts/Base.astro";
import NetworkMap from "../components/NetworkMap.astro";
import { networkMapModel } from "../lib/networkMap";
import { hasFeed, loadFeed } from "@watermark/core/bundle";
import { featuredSites, HYPOTHESIS_ORDER, hypothesisConfig } from "@watermark/core/directory";
import type { HypothesisItem } from "@watermark/core/feeds";
import { LENS_ORDER, LENSES } from "@watermark/core/lenses";
import { lensNetworkCounts, type LensResolvers } from "@watermark/core/lensView";
import { lensStatus } from "@watermark/core/readiness";
import { withBase, withSite, siteUrl } from "@watermark/core/site";
import {
  groupSites,
  networkRollup,
  SITE_STATUS_META,
  SITES,
  siteFeedCount,
  siteRollup,
  type SiteStatus,
} from "@watermark/core/sites";

const totalSites = SITES.length;
const basins = groupSites("basin").length;
// The sites a reader can actually enter today — `selectable`, which is what the map rings.
const openCount = SITES.filter((s) => s.selectable).length;

// Build-phase ink for the featured table's phase dot. The two distribution BARS this used to also
// drive came off with the ledger (#2044) — `/network` carries phase as a filter facet and a pill
// column, and the map's key encodes it — but a row still names its phase, so the ramp stays.
const PHASE_COLOR: Record<SiteStatus, string> = {
  live: "var(--bosc-forest)",
  building: "var(--bosc-ink)",
  queued: "var(--bosc-muted)",
  tracking: "var(--bosc-faint)",
};

// What the network has actually ASSEMBLED, summed over every site's exported bundle (#1861) —
// the registry figures above only count sites we've registered. Both move on their own: the
// ledger rises when a site lands records and falls when a source dries up, at every export.
const net = networkRollup();
const num = (n: number): string => n.toLocaleString("en-US");

/**
 * The four headline figures under the map (#2044) — what the ledger's six cells and two bars
 * reduce to.
 *
 * Two register the network's SHAPE (sites, basins) and two what it has ASSEMBLED (documents) or
 * OPENED (open to read). `Open to read` is `selectable`, the same set the map rings in forest, so
 * the figure and the glyph say one thing. Dropped: `states` (02, and 02 for a while yet), `live
 * reference` (which `open` subsumes), and `records`, whose axis `documents` now carries alone.
 *
 * Every one is a count off the registry or the export rollup. Never an estimate, never a target.
 */
const stats = [
  { n: String(totalSites), l: "Sites" },
  { n: String(basins).padStart(2, "0"), l: "Basins" },
  { n: num(net.documents), l: "Documents" },
  { n: String(openCount).padStart(2, "0"), l: "Open to read" },
];

// The three open questions, in brief — config + status only (the scorecard does the scoring).
// Headed by the hypothesis's own `question` once the feed carries one (#1917); until then the
// `claim` stands in, which is the same sentence in the indicative. Read off the feed rather than
// version-gated, so the copy sharpens the moment the contract does and not a release later.
const hypItems = hasFeed("hypotheses") ? loadFeed<HypothesisItem[]>("hypotheses") : [];
const hypByKey = new Map(hypItems.map((h) => [h.id, h]));
const hyps = HYPOTHESIS_ORDER.map((key) => {
  const cfg = hypothesisConfig(key, hypByKey.get(key));
  const asked = (hypByKey.get(key) as { question?: string } | undefined)?.question;
  return { ...cfg, asked: asked ?? cfg.claim };
});

// The five lenses, with how much of the network each one actually reaches (#1914's measurement,
// read here for the card line). Every figure is a count of sites whose OWN export carries the
// lens — never a score, and a lens nothing has been measured for shows a dash rather than a zero.
const lensResolvers = (id: (typeof LENS_ORDER)[number]): LensResolvers => ({
  tierOf: (slug) => siteRollup(slug).tier,
  statusOf: (slug) => lensStatus(slug, id),
  countOf: siteFeedCount,
});
const lenses = LENS_ORDER.map((id) => {
  const n = lensNetworkCounts(SITES, lensResolvers(id));
  return {
    ...LENSES[id],
    onRecord: n["on-record"],
    // A dash, not "0 sites": the number is only meaningful against sites that have been exported
    // at all, and every site unexported would mean nothing was measured, not that nothing is there.
    count: n["on-record"] + n.unrecorded === 0 ? "—" : `${n["on-record"]} of ${SITES.length} sites`,
  };
});

// The "start here" doors.
const doors = [
  {
    nn: "01",
    title: "The reference build",
    meta: "LIMA (BOSC) · LIVE",
    desc: "The one fully-assembled site — and the best place to start. New here? Its story teaches you to read the record.",
    href: siteUrl(),
    cta: "Enter the site",
  },
  {
    nn: "02",
    title: "How the record is built",
    meta: "PROVENANCE-FIRST",
    desc: "Sources, labeled inference, and the two-clock model — what Watermark is, and how to read it.",
    href: "/about",
    cta: "Read the method",
  },
  {
    nn: "03",
    title: "Contribute a lead",
    meta: "NO ACCOUNT NEEDED",
    desc: "A document, a name, a correction — every confirmed figure started as a lead.",
    href: "/submit",
    cta: "Submit a lead",
  },
];

// A featured slice across the network for the home table (the scorecard holds every site). Ranked
// by the record each site's own export has assembled — deepest tier, then its records/documents
// (#1864); it used to be `SITES.slice(0, 8)`, the first eight in registry order, ranked by nothing.
// The heading says so, so the reader knows what the eight are. Each row goes to the site it names
// (#1862) — the registry href, the same destination the switcher and the scorecard use.
// The locator map (#2036). Built from the registry, so a newly-registered site places itself
// and a site without a coordinate is named off-map rather than dropped or guessed.
// A narrower viewBox than `/network`'s, on purpose. The SVG scales to its container, so legibility
// depends on the ratio of glyph to frame — building the hero's instance at 420 rather than 640 is
// what makes its type readable once it is scaled into a ~30rem column.
const mapModel = networkMapModel(420);

const featured = featuredSites(siteRollup, 8).map((s, i) => ({
  idx: String(i + 1).padStart(2, "0"),
  code: s.codename ?? s.mono,
  place: s.place,
  basin: s.basin,
  href: s.href,
  phaseLabel: SITE_STATUS_META[s.status].label,
  phaseColor: PHASE_COLOR[s.status],
  rowBg: i % 2 ? "#ece8dc" : "transparent",
}));
---

<Base
  title="The directory"
  section="directory"
  rail={false}
  description={`The Watermark network — the public record behind the hyperscale data-center build-out, watershed point by point. ${totalSites} sites across ${basins} basins; Lima is the live reference build. Read the network three ways.`}
>
  <div class="dirh">
    <!-- hero -->
    <section class="dirh-hero">
      <div class="dirh-hero-l">
        <div class="dirh-eyebrow">The Watermark network</div>
        <h1 class="dirh-h1">The build-out, on the public record.</h1>
        <p class="dirh-lead">
          Watermark assembles the public record behind the hyperscale data-center build-out —
          <b>{totalSites} sites across {basins} basins</b>, each a point where compute meets ground,
          water, and power. Provenance-first, and built in the open.
        </p>
        <div class="dirh-cta">
          <a class="dirh-btn dirh-btn--solid" href={withBase("/lens/")}>Read a buildout five ways →</a>
          <a class="dirh-btn dirh-btn--ghost" href={withSite()}>See the reference build →</a>
        </div>
      </div>

      <!-- the map IS the ledger (#2044): the locator, with the four headline figures under it -->
      <div class="dirh-locator">
        <div class="dirh-locator-head">
          <span>Where the network is</span>
          <a href={withBase("/network")}>All {totalSites} →</a>
        </div>
        <NetworkMap model={mapModel} compact label="The Watermark network, mapped">
          <div class="dirh-stats" slot="stats">
            {
              stats.map((st) => (
                <div class="dirh-stat">
                  <div class="dirh-stat-n">{st.n}</div>
                  <div class="dirh-stat-l">{st.l}</div>
                </div>
              ))
            }
          </div>
        </NetworkMap>
      </div>
    </section>

    <!-- the five lenses — the front door (#1916) -->
    <section class="dirh-sec">
      <div class="dirh-sec-head">
        <h2 class="dirh-sec-title">Five ways to read a buildout</h2>
        <span class="dirh-sec-sub">— what it takes, what it costs, and who decided.</span>
        <a class="dirh-sec-link" href={withBase("/lens/")}>All five lenses →</a>
      </div>
      <div class="dirh-lenses">
        {
          lenses.map((l) => (
            <a class="dirh-lens" href={withBase(`/lens/${l.id}`)} style={`--mark:${l.accent.mark}`}>
              <span class="dirh-lens-n">{l.number}</span>
              <span class="dirh-lens-name">{l.name}</span>
              <span class="dirh-lens-q">{l.question}</span>
              <span class="dirh-lens-count">{l.count}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- the open questions (the hypotheses, demoted positionally — not downgraded) -->
    <section class="dirh-sec">
      <div class="dirh-sec-head">
        <h2 class="dirh-sec-title">The open questions</h2>
        <span class="dirh-sec-sub">— why the build-out is happening here at all.</span>
        <a class="dirh-sec-link" href={withBase("/research/hypotheses")}>Open the scorecard →</a>
      </div>
      <div class="dirh-hyps">
        {
          hyps.map((h) => {
            const live = h.statusKind === "live";
            return (
              <a class="dirh-hyp" href={withBase(`/research/hypotheses?h=${h.key}`)}>
                <span class="dirh-hyp-top">
                  <span class="dirh-hyp-n" style={`color:${h.accent};border-color:${h.accent}`}>{h.n}</span>
                  <span class:list={["dirh-hyp-status", { "is-live": live }]}>{h.status}</span>
                </span>
                <span class="dirh-hyp-name">{h.name}</span>
                <span class="dirh-hyp-claim">{h.asked}</span>
              </a>
            );
          })
        }
      </div>
      <p class="dirh-hyps-note">
        Unlike a lens, a hypothesis has a verdict to reach — each is under test, scored against every
        site, and none is settled. A lens describes; these argue.
      </p>
    </section>

    <!-- start here -->
    <section class="dirh-sec">
      <div class="dirh-kicker">Start here</div>
      <div class="dirh-doors">
        {
          doors.map((d) => (
            <a class="dirh-door" href={withBase(d.href)}>
              <span class="dirh-door-n">{d.nn}</span>
              <span class="dirh-door-title">{d.title}</span>
              <span class="dirh-door-meta">{d.meta}</span>
              <span class="dirh-door-desc">{d.desc}</span>
              <span class="dirh-door-cta">{d.cta} →</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- across the network -->
    <section class="dirh-sec">
      <div class="dirh-sec-head">
        <div class="dirh-kicker">Across the network</div>
        <span class="dirh-sec-sub">— the {featured.length} deepest-assembled sites, by readiness tier.</span>
        {/* The canonical index, not the scorecard (#1888): "see all" asks *which sites are there*,
            and /research/hypotheses answers a different question — which boom-origin thesis each
            site bears on. That view keeps its own two entries above. */}
        <a class="dirh-sec-link" href={withBase("/network")}>See all {totalSites} →</a>
      </div>
      <div class="dirh-table">
        <div class="dirh-trow dirh-thead">
          <span>#</span><span>Code</span><span>Place</span><span>Basin</span><span class="is-right">Phase</span>
        </div>
        {
          featured.map((f) => (
            <a class="dirh-trow dirh-drow" href={withBase(f.href)} style={`background:${f.rowBg}`}>
              <span class="dirh-td-idx">{f.idx}</span>
              <span class="dirh-td-code">{f.code}</span>
              <span class="dirh-td-place">{f.place}</span>
              <span class="dirh-td-basin">{f.basin}</span>
              <span class="dirh-td-phase" style={`color:${f.phaseColor}`}>
                <span class="dirh-leg-dot" style={`background:${f.phaseColor}`} />{f.phaseLabel}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .dirh {
    max-width: 76rem;
    margin: 0 auto;
  }
  .dirh-eyebrow,
  .dirh-kicker {
    font-family: var(--bosc-mono);
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--bosc-muted);
    font-weight: 500;
  }
  .dirh-kicker {
    color: var(--bosc-faint);
  }

  /* hero */
  .dirh-hero {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding: 0.5rem 0 2rem;
    border-bottom: 1px solid var(--bosc-rule);
  }
  .dirh-hero-l {
    flex: 1 1 28rem;
    max-width: 34rem;
  }
  .dirh-h1 {
    font-size: clamp(2.4rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin: 0.8rem 0 0;
  }
  .dirh-lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--bosc-ink);
    margin: 1.1rem 0 0;
    max-width: 35rem;
    text-wrap: pretty;
  }
  .dirh-cta {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.6rem;
    flex-wrap: wrap;
  }
  .dirh-btn {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    padding: 0.8rem 1.3rem;
  }
  .dirh-btn--solid {
    background: var(--bosc-ink);
    color: var(--bosc-bg);
  }
  .dirh-btn--ghost {
    background: transparent;
    border: 1.5px solid var(--bosc-ink);
    color: var(--bosc-ink);
  }

  /* the locator — the map in the ledger's slot (#2044) */
  .dirh-locator {
    flex: 1 1 26rem;
    max-width: 30rem;
    border: 1px solid var(--bosc-ink);
    align-self: flex-start;
    padding: 0 0.9rem 0.9rem;
  }
  .dirh-locator-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    font-family: var(--bosc-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bosc-muted);
    padding: 0.7rem 0;
    margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--bosc-ink);
  }
  .dirh-locator-head a {
    color: var(--bosc-ink);
    text-decoration: none;
    font-weight: 600;
  }
  .dirh-locator-head a:hover {
    color: var(--bosc-forest);
  }

  /* the four headline figures, under the map */
  .dirh-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--bosc-ink);
  }
  .dirh-stat {
    border-left: 1px solid var(--bosc-rule);
    border-top: 1px solid var(--bosc-rule);
    padding: 0.75rem 0.85rem;
  }
  .dirh-stat:nth-child(odd) {
    border-left: 0;
  }
  .dirh-stat:nth-child(-n + 2) {
    border-top: 0;
  }
  .dirh-stat-n {
    font-family: var(--bosc-mono);
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .dirh-stat-l {
    font-family: var(--bosc-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bosc-faint);
    margin-top: 0.4rem;
  }

  /* sections */
  .dirh-sec {
    padding: 1.7rem 0;
    border-bottom: 1px solid var(--bosc-rule);
  }
  .dirh-sec:last-child {
    border-bottom: 0;
  }
  .dirh-sec-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }
  .dirh-sec-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .dirh-sec-sub {
    font-size: 0.85rem;
    color: var(--bosc-faint);
  }
  .dirh-sec-link {
    margin-left: auto;
    font-family: var(--bosc-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bosc-ink);
    text-decoration: none;
    font-weight: 600;
  }
  .dirh-sec-link:hover {
    color: var(--bosc-forest);
  }

  /* the five lenses — the front door. One accent each, taken from the forest DATA ramp
     (`--data-1` … `--data-5`): it encodes position in the causal chain and nothing else. No
     evidence fill, because a lens declares no evidentiary weight of its own (#1913). */
  .dirh-lenses {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .dirh-lens {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--bosc-rule);
    border-top: 3px solid var(--mark);
    padding: 0.9rem 1.2rem 0.25rem;
    text-decoration: none;
    color: var(--bosc-ink);
  }
  .dirh-lens:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .dirh-lens:hover .dirh-lens-name,
  .dirh-lens:focus-visible .dirh-lens-name {
    text-decoration: underline;
  }
  .dirh-lens-n {
    font-family: var(--bosc-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--bosc-faint);
  }
  .dirh-lens-name {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 0.35rem;
  }
  .dirh-lens-q {
    display: block;
    font-size: 0.8rem;
    color: var(--bosc-muted);
    line-height: 1.45;
    margin-top: 0.3rem;
  }
  .dirh-lens-count {
    display: block;
    margin-top: auto;
    padding-top: 0.8rem;
    font-family: var(--bosc-mono);
    font-size: 0.68rem;
    color: var(--bosc-faint);
  }

  /* the open questions (the hypotheses) */
  .dirh-hyps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .dirh-hyp {
    border-left: 1px solid var(--bosc-rule);
    padding: 0.25rem 1.4rem;
    text-decoration: none;
    color: var(--bosc-ink);
  }
  .dirh-hyp:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .dirh-hyp-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .dirh-hyp-n {
    font-family: var(--bosc-mono);
    font-size: 0.72rem;
    font-weight: 600;
    border: 1px solid currentColor;
    padding: 1px 7px;
  }
  .dirh-hyp-status {
    font-family: var(--bosc-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bosc-faint);
  }
  .dirh-hyp-status.is-live {
    color: var(--bosc-forest);
  }
  .dirh-hyp-name {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 0.8rem;
  }
  .dirh-hyp-claim {
    display: block;
    font-size: 0.82rem;
    color: var(--bosc-muted);
    line-height: 1.45;
    margin-top: 0.3rem;
  }
  .dirh-hyps-note {
    margin: 1.1rem 0 0;
    max-width: 46rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--bosc-faint);
  }

  /* doors */
  .dirh-doors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .dirh-door {
    border-left: 1px solid var(--bosc-rule);
    padding: 0.1rem 1.4rem;
    text-decoration: none;
    color: var(--bosc-ink);
    display: flex;
    flex-direction: column;
  }
  .dirh-door:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .dirh-door-n {
    font-family: var(--bosc-mono);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--bosc-faint);
  }
