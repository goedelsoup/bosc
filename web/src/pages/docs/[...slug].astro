---
/**
 * /docs/<slug> — a network-global long-form doc (#1304).
 *
 * The narrative collection is network-global-host content, so this builds once at the root
 * (not per selectable site). Cross-links inside the rendered markdown are rewritten by the
 * base-aware rehype plugin (`lib/rehype-doc-links.ts`), which keeps migrated-doc routes global.
 */
import { getCollection, render } from "astro:content";
import Base from "~/layouts/Base.astro";
import { bySlug } from "@watermark/core/narrative";
import { withBase } from "@watermark/core/site";

export async function getStaticPaths() {
  // Only the curated narrative set (lib/narrative.ts) is published; the glob may
  // load other docs/ markdown, which we drop here.
  const entries = await getCollection("narrative", (e) => bySlug.has(e.id));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const doc = bySlug.get(entry.id)!;
const { Content, headings } = await render(entry);
// The rail is this essay's own headings (Astro slugs each one as an `id`).
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ anchor: h.slug, label: h.text }));

const docsHref = withBase("/docs/");
const breadcrumbs = [
  { label: "Docs", href: docsHref },
  { label: doc.title, href: Astro.url.pathname },
];

const articleLd = Astro.site
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: doc.title,
      description: doc.blurb,
      author: { "@type": "Organization", "@id": `${Astro.site.href}#org`, name: "Watermark Directory" },
      publisher: { "@type": "Organization", "@id": `${Astro.site.href}#org`, name: "Watermark Directory" },
      isPartOf: { "@type": "WebSite", "@id": `${Astro.site.href}#website` },
    }
  : null;
---

<Base title={doc.title} section="docs" description={doc.blurb} toc={toc} ogType="article" breadcrumbs={breadcrumbs}>
  {articleLd && <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />}
  <article class="prose">
    <p><a href={docsHref}>← All docs</a></p>
    <Content />
  </article>
</Base>
