---
/**
 * /docs/ — the network-global docs hub (#1304).
 *
 * The long-form prose collection (`lib/narrative.ts`) is network-global-host content — the
 * investigation's method and analysis, not per-watershed-site data — so it builds once at the
 * root, not per selectable site. Essays group by the thematic section each belongs to.
 */
import Base from "~/layouts/Base.astro";
import { NARRATIVE } from "@watermark/core/narrative";
import { getSection, sections, type SectionId } from "@watermark/core/nav";
import { withBase } from "@watermark/core/site";

// Group the narrative by the thematic section each piece belongs to.
const groups = sections()
  .map((s) => ({
    section: s,
    docs: NARRATIVE.filter((d) => d.section === (s.id as SectionId)),
  }))
  .filter((g) => g.docs.length > 0);
---

<Base title="Docs" section="docs" rail={false} description="The project's narrative prose — the dossier, hydrology, economics, and legal analysis.">
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">Network · docs</div>
        <h1>Docs</h1>
        <p class="hub-lead">
          The investigation's long-form prose, migrated from <code>docs/</code> into the
          site (issue #69). It's network-global — the method and analysis behind the record,
          not per-site data — so it reads the same files as-is, rewriting their cross-links
          into the new sections.
        </p>
      </div>
      <span class="hub-count">{NARRATIVE.length} essays · {groups.length} sections</span>
    </div>

    {
      groups.map((g) => (
        <>
          <h2 class="hub-subhead" id={g.section.id}>{getSection(g.section.id).label}</h2>
          <div class="hub-grid">
            {g.docs.map((d) => (
              <a class="hub-door" href={withBase(`/docs/${d.slug}`)}>
                <div class="hub-door-top">
                  <span class="hub-door-kind">{getSection(g.section.id).tab}</span>
                </div>
                <div class="hub-door-title">{d.title}</div>
                {d.blurb && <div class="hub-door-desc">{d.blurb}</div>}
                <div class="hub-door-foot">
                  <span class="hub-door-browse">Read</span>
                  <span class="hub-door-arrow" aria-hidden="true">›</span>
                </div>
              </a>
            ))}
          </div>
        </>
      ))
    }
  </div>
</Base>
