---
/**
 * /docs/ — the network-global docs hub (#1304).
 *
 * The long-form prose collection (`lib/narrative.ts`) is network-global-host content — the
 * investigation's method and analysis, not per-watershed-site data — so it builds once at the
 * root, not per selectable site. Essays group by the thematic section each belongs to.
 */
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import HubLede from "~/components/HubLede.astro";
import { NARRATIVE, bySlug } from "@watermark/core/narrative";
import { getSection, sections, type SectionId } from "@watermark/core/nav";
import { withBase } from "@watermark/core/site";

// Group the narrative by the thematic section each piece belongs to.
const groups = sections()
  .map((s) => ({
    section: s,
    docs: NARRATIVE.filter((d) => d.section === (s.id as SectionId)),
  }))
  .filter((g) => g.docs.length > 0);

// The lede (#1891). The collection carries no publication date — `docs/` is read as-is and the
// git-freshness walk (`bosc.site.corpus_index`) covers `data/`, not this tree — so this does NOT
// claim a "most recent" piece it cannot source. What it can measure is the collection itself:
// the real word count of every published body, and the one essay that synthesizes the rest.
// `ENTRY` is a declared editorial choice, and the copy says "start here", not "newest".
const ENTRY = "dossier";
const bodies = (await getCollection("narrative", (e) => bySlug.has(e.id))).map((e) => ({
  slug: e.id,
  words: (e.body ?? "").split(/\s+/).filter(Boolean).length,
}));
const totalWords = bodies.reduce((a, b) => a + b.words, 0);
// 220 wpm — the conventional silent-reading rate, and the same divisor the story chapters quote.
const minutes = (words: number): number => Math.max(1, Math.round(words / 220));
const entry = bySlug.get(ENTRY) ?? null;
const entryWords = bodies.find((b) => b.slug === ENTRY)?.words ?? 0;
---

<Base title="Docs" section="docs" rail={false} description="The project's narrative prose — the dossier, hydrology, economics, and legal analysis.">
  <div class="hub">
    <div class="hub-head">
      <div>
        <div class="hub-eyebrow">Network · docs</div>
        <h1>Docs</h1>
        <p class="hub-lead">
          The investigation's long-form prose, migrated from <code>docs/</code> into the
          site (issue #69). It's network-global — the method and analysis behind the record,
          not per-site data — so it reads the same files as-is, rewriting their cross-links
          into the new sections.
        </p>
      </div>
      <span class="hub-count">{NARRATIVE.length} essays · {groups.length} sections</span>
    </div>

    <HubLede
      label="Start here"
      absent={entry ? null : "No essay in this collection is published yet."}
      cite={`${NARRATIVE.length} published essays, ${totalWords.toLocaleString("en-US")} words — counted from the bodies this build renders. The collection carries no publication dates, so nothing here is ordered by recency.`}
      href={entry ? withBase(`/docs/${entry.slug}`) : null}
      cta="Read the dossier"
    >
      {
        entry && (
          <>
            <p class="hublede-say">
              <strong>{entry.title}</strong> — {entry.blurb}
            </p>
            <div class="hublede-chips">
              <span class="hublede-chip">
                <span class="hublede-chip-n">{minutes(entryWords)}</span> min read
              </span>
              <span class="hublede-chip">
                <span class="hublede-chip-n">{NARRATIVE.length}</span> essays
              </span>
              <span class="hublede-chip">
                <span class="hublede-chip-n">{minutes(totalWords)}</span> min end to end
              </span>
            </div>
          </>
        )
      }
    </HubLede>

    {
      groups.map((g) => (
        <>
          <h2 class="hub-subhead" id={g.section.id}>{getSection(g.section.id).label}</h2>
          <div class="hub-grid">
            {g.docs.map((d) => (
              <a class="hub-door" href={withBase(`/docs/${d.slug}`)}>
                <div class="hub-door-top">
                  <span class="hub-door-kind">{getSection(g.section.id).tab}</span>
                </div>
                <div class="hub-door-title">{d.title}</div>
                {d.blurb && <div class="hub-door-desc">{d.blurb}</div>}
                <div class="hub-door-foot">
                  <span class="hub-door-browse">Read</span>
                  <span class="hub-door-arrow" aria-hidden="true">›</span>
                </div>
              </a>
            ))}
          </div>
        </>
      ))
    }
  </div>
</Base>
