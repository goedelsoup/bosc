---
/**
 * The shared shell for an interactive report page (#584). The seven `reports/*`
 * companion pages all opened with the identical chrome — the `Base` wrapper, the
 * `walk-chapter-page` frame, a "← Reports" back-link, an eyebrow, and the h1 — before
 * their page-specific lead and body. That skeleton lives here now; each page supplies
 * its `eyebrow` / `h1` / description as props, its lead via the `lead` slot, and the
 * body (island, fallback table, callouts) as the default slot.
 *
 * The standard "read the full report" closing block is also factored here: a page that
 * sets `fullReportHref` gets the shared "This is the short, interactive version…" frame
 * and the "Read the full report →" button, supplying only its report-specific list of
 * claims via the `full-report` slot.
 */
import Base from "./Base.astro";
import StudyAnnexBanner from "../components/study/StudyAnnexBanner.astro";
import { withBase } from "@watermark/core/site";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  /** When set, render the shared closing block linking to the full essay — a network-global
   *  `/docs/<slug>` path (#1304), deploy-based but NOT site-prefixed. */
  fullReportHref?: string;
  /** Study chapter id(s) this report is the data annex for (the missing-impact-study epic) —
   *  renders the annex banner under the h1, only when the report itself renders. */
  annexChapters?: string[];
}
const { title, description, eyebrow, h1, fullReportHref, annexChapters } = Astro.props;

// This shell used to hold the section gate itself: on a thinner peer all seven companions rendered
// the lock, with their Lima-authored title / eyebrow / h1 / description swapped for generic
// "Reports" copy so the analysis didn't leak through the chrome and the <head> meta. The gate moved
// UP to the route (#1894, `openSectionPaths("reports")`) — a locked peer no longer builds these
// pages at all, so a shell branch for the locked case is unreachable by construction. The lock
// itself is unchanged and still shown, once, on the `/reports/` index that the site bar links.
---

<Base title={title} section="reports" description={description}>
  <div class="walk-chapter-page">
    <article class="prose">
      <div class="walk-chapter-eyebrow">{eyebrow}</div>
      <h1 class="walk-chapter-h1">{h1}</h1>
      {annexChapters && annexChapters.length > 0 && <StudyAnnexBanner chapters={annexChapters} />}
      <slot name="lead" />
    </article>
    <slot />
    {fullReportHref && (
      <article class="prose">
        <p>
          This is the short, interactive version. The full report walks every claim to its
          source — <slot name="full-report" />.
        </p>
        <p>
          <a class="btn btn--icon" href={withBase(fullReportHref)}>Read the full report →</a>
        </p>
      </article>
    )}
  </div>
</Base>
