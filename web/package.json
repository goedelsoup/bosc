{
  "name": "bosc-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The redesigned BOSC site — an Astro + MDX frontend over the committed content bundle (Epic #54).",
  "scripts": {
    "dev": "astro dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "seed:r2": "node scripts/seed-r2.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && npm run check:functions && npm run check:core && npm run check:charts && npm run check:viz",
    "check:functions": "tsc -p functions/tsconfig.json",
    "check:core": "tsc -p packages/core/tsconfig.json",
    "check:charts": "tsc -p packages/charts/tsconfig.json",
    "check:viz": "tsc -p packages/viz/tsconfig.json",
    "check:links": "node scripts/check-links.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "lint": "biome ci src functions/api scripts packages",
    "format": "biome check --write src functions/api scripts packages",
    "astro": "astro"
  },
  "dependencies": {
    "@watermark/core": "workspace:*",
    "@watermark/functions": "workspace:*",
    "@watermark/charts": "workspace:*",
    "@watermark/viz": "workspace:*",
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-directive": "^4.0.0",
    "web-vitals": "^4.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "2.5.0",
    "@electric-sql/pglite": "^0.2.17",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.20",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.7.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.9",
    "yaml": "2.9.0"
  }
}
