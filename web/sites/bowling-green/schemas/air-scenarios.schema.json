{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "air-scenarios feed",
  "type": "array",
  "items": {
    "additionalProperties": false,
    "description": "An evaluated scenario: per-pollutant tonnage, cap check, and the breach summary.",
    "properties": {
      "scenario": {
        "$ref": "#/$defs/AirScenario"
      },
      "engine_mw": {
        "$ref": "#/$defs/ProvenancedValue"
      },
      "fleet_size": {
        "title": "Fleet Size",
        "type": "integer"
      },
      "fuel": {
        "title": "Fuel",
        "type": "string"
      },
      "emissions": {
        "items": {
          "$ref": "#/$defs/PollutantTonnage"
        },
        "title": "Emissions",
        "type": "array"
      },
      "any_cap_exceeded": {
        "title": "Any Cap Exceeded",
        "type": "boolean"
      },
      "breached_pollutants": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Breached Pollutants",
        "type": "array"
      },
      "note": {
        "default": "",
        "title": "Note",
        "type": "string"
      }
    },
    "required": [
      "scenario",
      "engine_mw",
      "fleet_size",
      "fuel",
      "emissions",
      "any_cap_exceeded"
    ],
    "title": "AirScenarioResult",
    "type": "object"
  },
  "$defs": {
    "AirScenario": {
      "additionalProperties": false,
      "description": "Inputs for one emissions scenario: how long the fleet runs, and on which factors.\n\nDefaults to the ``permit`` basis: it carries both engine-load points (idle testing vs\na dispatch carrying load) and is the source the synthetic-minor cap is actually tracked\nagainst, so the cap-exceedance check is most faithful on it. AP-42 (``factors_basis=\n\"ap42\"``) is available as the conservative cross-check, at load only.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "runtime_hours": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "factors_basis": {
          "default": "permit",
          "enum": [
            "ap42",
            "permit"
          ],
          "title": "Factors Basis",
          "type": "string"
        },
        "load_regime": {
          "default": "load",
          "enum": [
            "idle",
            "load"
          ],
          "title": "Load Regime",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "runtime_hours"
      ],
      "title": "AirScenario",
      "type": "object"
    },
    "PollutantTonnage": {
      "additionalProperties": false,
      "description": "One pollutant's annual fleet emissions and its standing against the NSR cap.",
      "properties": {
        "pollutant": {
          "title": "Pollutant",
          "type": "string"
        },
        "tpy": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "cap_tpy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cap Tpy"
        },
        "pct_of_cap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pct Of Cap"
        },
        "exceeds_cap": {
          "default": false,
          "title": "Exceeds Cap",
          "type": "boolean"
        }
      },
      "required": [
        "pollutant",
        "tpy"
      ],
      "title": "PollutantTonnage",
      "type": "object"
    },
    "ProvenancedValue": {
      "additionalProperties": false,
      "description": "A single numeric quantity tagged with its provenance.\n\nConstruct via the classmethods (:meth:`from_document`, :meth:`from_connector`,\n:meth:`assume`, :meth:`derived`) so the ``source`` tag is never forgotten.\n\nA **measured or derived estimate** may also carry a quantitative uncertainty range\n(#760): optional absolute ``low``/``high`` bounds around the central ``value``,\n*orthogonal* to the qualitative ``confidence`` enum. The convention: a document- or\nconnector-verbatim figure is a single value (no band); an estimate whose honest\nrepresentation is \"226 ± ~35 ac\" carries ``low``/``high`` so downstream consumers\n(the bundle, the frontend, the Monte-Carlo engine #271) see the spread as data, not\nprose buried in the citation. The estimate constructors (:meth:`derived`,\n:meth:`assume`, :meth:`from_reference`) take the range inline; :meth:`with_range`\nattaches one to any value (e.g. a document-anchored central with a derived band).",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "enum": [
            "document",
            "connector",
            "reference",
            "assumption",
            "derived"
          ],
          "title": "Source",
          "type": "string"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "asof": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asof"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        }
      },
      "required": [
        "value",
        "unit",
        "source"
      ],
      "title": "ProvenancedValue",
      "type": "object"
    }
  }
}
