    "EnclavePower": {
      "additionalProperties": false,
      "description": "The enclave's electrical load — ``[open]`` unless an instrument discloses it.\n\nModeled explicitly rather than omitted, because the absence is the finding: a ~27,000-person\ninstallation is unmistakably a large load, and the honest representation of that is a named\ngap with the backdrop that does apply, not a plausible number.",
      "properties": {
        "load_mw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Mw"
        },
        "load_citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Citation"
        },
        "note": {
          "default": "No instrument in the corpus discloses it, and none may be inferred from acreage or population. The site's grid backdrop (serving utility, balancing authority, state denominators) still applies and is carried with load_share null — the enclave is a real load the grid layer refuses to size.",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "EnclavePower",
      "type": "object"
    },
