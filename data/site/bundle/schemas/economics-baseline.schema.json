{
  "$defs": {
    "IndustryEmployment": {
      "additionalProperties": false,
      "description": "A county's employment for one year (BLS QCEW): private NAICS sectors + government ownership.\n\n``sectors`` is the **private-ownership** (own 5) NAICS mix; ``total_employment`` is **all\nownerships** (own 0). The unexplained total-minus-sectors gap is the federal / state / local\ngovernment employment, now surfaced in ``government`` (own 1/2/3) so the two reconcile (#1661).\nQCEW excludes uniformed active-duty military entirely — see :data:`QCEW_COVERAGE_NOTE`.",
      "properties": {
        "fips": {
          "title": "Fips",
          "type": "string"
        },
        "area_name": {
          "title": "Area Name",
          "type": "string"
        },
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "total_employment": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "establishments": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avg_annual_pay": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avg_weekly_wage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sectors": {
          "items": {
            "$ref": "#/$defs/SectorEmployment"
          },
          "title": "Sectors",
          "type": "array"
        },
        "government": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OwnershipEmployment"
          },
          "title": "Government",
          "type": "array"
        },
        "source": {
          "default": "BLS QCEW (annual averages): private-ownership NAICS sectors + federal/state/local government ownership; excludes uniformed active-duty military",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "fips",
        "area_name",
        "year",
        "total_employment",
        "sectors"
      ],
      "title": "IndustryEmployment",
      "type": "object"
    },
    "OwnershipEmployment": {
      "additionalProperties": false,
      "description": "One government-ownership slice of county employment (QCEW own 1/2/3, agglvl 71).\n\nThe federal / state / local government jobs the private-ownership ``sectors`` mix (own 5)\nstructurally cannot show (#1661). ``total_employment`` (all ownerships) reconciles as the\nprivate sectors plus these government slices, so surfacing them closes the total-vs-sectors\ngap. The federal row matters most: at a federal enclave it is the county's single largest\nemployer yet carries no NAICS sector of its own. Same connector-provenanced shape as\n:class:`SectorEmployment`; a slice QCEW reports with no covered wages omits pay (never $0).",
      "properties": {
        "ownership": {
          "title": "Ownership",
          "type": "string"
        },
        "ownership_name": {
          "title": "Ownership Name",
          "type": "string"
        },
        "annual_avg_employment": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "establishments": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avg_annual_pay": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avg_weekly_wage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location_quotient": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ownership",
        "ownership_name",
        "annual_avg_employment"
      ],
      "title": "OwnershipEmployment",
      "type": "object"
    },
    "PopulationPoint": {
      "additionalProperties": false,
      "description": "County population in one year (Census).",
      "properties": {
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "population": {
          "$ref": "#/$defs/ProvenancedValue"
        }
      },
      "required": [
        "year",
        "population"
      ],
      "title": "PopulationPoint",
      "type": "object"
    },
    "PopulationSeries": {
      "additionalProperties": false,
      "description": "County population over time — present only when a Census source is available.",
      "properties": {
        "fips": {
          "title": "Fips",
          "type": "string"
        },
        "area_name": {
          "title": "Area Name",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/PopulationPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "source": {
          "default": "US Census ACS 5-year (B01003)",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "fips",
        "area_name",
        "points"
      ],
      "title": "PopulationSeries",
      "type": "object"
    },
    "ProvenancedValue": {
      "additionalProperties": false,
      "description": "A single numeric quantity tagged with its provenance.\n\nConstruct via the classmethods (:meth:`from_document`, :meth:`from_connector`,\n:meth:`assume`, :meth:`derived`) so the ``source`` tag is never forgotten.\n\nA **measured or derived estimate** may also carry a quantitative uncertainty range\n(#760): optional absolute ``low``/``high`` bounds around the central ``value``,\n*orthogonal* to the qualitative ``confidence`` enum. The convention: a document- or\nconnector-verbatim figure is a single value (no band); an estimate whose honest\nrepresentation is \"226 ± ~35 ac\" carries ``low``/``high`` so downstream consumers\n(the bundle, the frontend, the Monte-Carlo engine #271) see the spread as data, not\nprose buried in the citation. The estimate constructors (:meth:`derived`,\n:meth:`assume`, :meth:`from_reference`) take the range inline; :meth:`with_range`\nattaches one to any value (e.g. a document-anchored central with a derived band).",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "enum": [
            "document",
            "connector",
            "reference",
            "assumption",
            "derived"
          ],
          "title": "Source",
          "type": "string"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "asof": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asof"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        }
      },
      "required": [
        "value",
        "unit",
        "source"
      ],
      "title": "ProvenancedValue",
      "type": "object"
    },
    "SectorEmployment": {
      "additionalProperties": false,
      "description": "One NAICS sector's county employment, with its export-orientation location quotient.",
      "properties": {
        "naics": {
          "title": "Naics",
          "type": "string"
        },
        "sector_name": {
          "title": "Sector Name",
          "type": "string"
        },
        "annual_avg_employment": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "establishments": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avg_annual_pay": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avg_weekly_wage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location_quotient": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "naics",
        "sector_name",
        "annual_avg_employment"
      ],
      "title": "SectorEmployment",
      "type": "object"
    },
    "YearTotal": {
      "additionalProperties": false,
      "description": "Total covered employment (and establishments) in one year — a point on the trend.",
      "properties": {
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "total_employment": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "establishments": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenancedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "year",
        "total_employment"
      ],
      "title": "YearTotal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The assembled localized baseline: latest industry mix + employment trend (+ population).",
  "properties": {
    "fips": {
      "title": "Fips",
      "type": "string"
    },
    "area_name": {
      "title": "Area Name",
      "type": "string"
    },
    "latest": {
      "$ref": "#/$defs/IndustryEmployment"
    },
    "trend": {
      "default": [],
      "items": {
        "$ref": "#/$defs/YearTotal"
      },
      "title": "Trend",
      "type": "array"
    },
    "population": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopulationSeries"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "median_household_income": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProvenancedValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unit_caveat": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Caveat"
    },
    "coverage_note": {
      "default": "BLS QCEW counts UI-covered (private, state, local) plus federal-civilian (UCFE) employment. Uniformed active-duty military is excluded — it appears in neither the county total nor any ownership row — so at a federal enclave the covered total understates the base's real employment footprint beyond even the federal-civilian jobs shown here.",
      "title": "Coverage Note",
      "type": "string"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "fips",
    "area_name",
    "latest"
  ],
  "title": "EconomicBaseline",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
