    "well_count",
    "active_count",
    "total_capacity_mgd",
    "operating_window",
    "as_of",
    "centroid_lat",
    "centroid_lon",
    "cones",
    "impacted_wells"
  ],
  "title": "DewateringImpact",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
