        },
        "baseflow_gain_median_cfs": {
          "title": "Baseflow Gain Median Cfs",
          "type": "number"
        },
        "baseflow_resid_median_cfs": {
          "title": "Baseflow Resid Median Cfs",
          "type": "number"
