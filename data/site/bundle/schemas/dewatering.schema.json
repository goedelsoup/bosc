{
  "$defs": {
    "ImpactedWell": {
      "additionalProperties": false,
      "description": "A census well inside the composite cone, with its superimposed drawdown.",
      "properties": {
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "well_use": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Well Use"
        },
        "aquifer_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aquifer Type"
        },
        "distance_ft": {
          "title": "Distance Ft",
          "type": "number"
        },
        "composite_drawdown_ft": {
          "$ref": "#/$defs/ProvenancedValue"
        }
      },
      "required": [
        "object_id",
        "well_use",
        "aquifer_type",
        "distance_ft",
        "composite_drawdown_ft"
      ],
      "title": "ImpactedWell",
      "type": "object"
    },
    "ProvenancedValue": {
      "additionalProperties": false,
      "description": "A single numeric quantity tagged with its provenance.\n\nConstruct via the classmethods (:meth:`from_document`, :meth:`from_connector`,\n:meth:`assume`, :meth:`derived`) so the ``source`` tag is never forgotten.\n\nA **measured or derived estimate** may also carry a quantitative uncertainty range\n(#760): optional absolute ``low``/``high`` bounds around the central ``value``,\n*orthogonal* to the qualitative ``confidence`` enum. The convention: a document- or\nconnector-verbatim figure is a single value (no band); an estimate whose honest\nrepresentation is \"226 ± ~35 ac\" carries ``low``/``high`` so downstream consumers\n(the bundle, the frontend, the Monte-Carlo engine #271) see the spread as data, not\nprose buried in the citation. The estimate constructors (:meth:`derived`,\n:meth:`assume`, :meth:`from_reference`) take the range inline; :meth:`with_range`\nattaches one to any value (e.g. a document-anchored central with a derived band).",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "enum": [
            "document",
            "connector",
            "reference",
            "assumption",
            "derived"
          ],
          "title": "Source",
          "type": "string"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "asof": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asof"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        }
      },
      "required": [
        "value",
        "unit",
        "source"
      ],
      "title": "ProvenancedValue",
      "type": "object"
    },
    "WellCone": {
      "additionalProperties": false,
      "description": "One dewatering well's cone of impact (all ``[inference]``).",
      "properties": {
        "record_no": {
          "title": "Record No",
          "type": "string"
        },
        "aquifer_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aquifer Type"
        },
        "q_gpm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Q Gpm"
        },
        "saturated_thickness_ft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Saturated Thickness Ft"
        },
        "operating_days": {
          "title": "Operating Days",
          "type": "integer"
        },
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "transmissivity_ft2_day": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "radius_of_influence_ft": {
          "$ref": "#/$defs/ProvenancedValue"
        }
      },
      "required": [
        "record_no",
        "aquifer_type",
        "q_gpm",
        "saturated_thickness_ft",
        "operating_days",
        "active",
        "transmissivity_ft2_day",
        "radius_of_influence_ft"
      ],
      "title": "WellCone",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The wellfield's cone of impact: per-well cones + superimposed drawdown on neighbors.",
  "properties": {
    "county": {
      "title": "County",
      "type": "string"
    },
    "well_count": {
      "title": "Well Count",
      "type": "integer"
    },
    "active_count": {
      "title": "Active Count",
