      ],
      "title": "ReachRouting",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A design-storm runoff hydrograph routed down the cited confluence graph.\n\nThe time-varying counterpart to :class:`RoutedNetwork` (which routes steady-state low\nflow): each contributing subcatchment's SCS design-storm hydrograph is routed downstream\nthrough Muskingum-Cunge and superposed at confluences, so the outlet peak is **attenuated\nand lagged**, not the arithmetic sum of the tributary peaks. The headline is the routed\noutlet hydrograph vs. the naive ``summed`` hydrograph (the local inflows superposed with no\nrouting): ``peak_attenuation_pct`` and ``lag_hr`` quantify what routing buys over the sum.\nTier-0 screening — not a calibrated HEC-HMS/HEC-RAS model.",
  "properties": {
    "tier": {
      "const": "tier0",
      "default": "tier0",
      "title": "Tier",
      "type": "string"
    },
    "scenario": {
      "default": "design-storm",
      "title": "Scenario",
      "type": "string"
    },
    "return_period_yr": {
      "title": "Return Period Yr",
      "type": "integer"
    },
    "storm_depth_in": {
      "title": "Storm Depth In",
      "type": "number"
    },
    "dt_hr": {
      "title": "Dt Hr",
      "type": "number"
    },
    "times_hr": {
      "items": {
        "type": "number"
      },
      "title": "Times Hr",
      "type": "array"
    },
    "outlet_hydrograph_cfs": {
      "items": {
        "type": "number"
      },
      "title": "Outlet Hydrograph Cfs",
      "type": "array"
    },
    "summed_hydrograph_cfs": {
      "items": {
        "type": "number"
      },
      "title": "Summed Hydrograph Cfs",
      "type": "array"
    },
    "routed_peak_cfs": {
      "title": "Routed Peak Cfs",
      "type": "number"
    },
    "summed_peak_cfs": {
      "title": "Summed Peak Cfs",
      "type": "number"
    },
    "peak_attenuation_pct": {
      "title": "Peak Attenuation Pct",
      "type": "number"
    },
    "routed_time_to_peak_hr": {
      "title": "Routed Time To Peak Hr",
      "type": "number"
    },
    "summed_time_to_peak_hr": {
      "title": "Summed Time To Peak Hr",
      "type": "number"
    },
    "lag_hr": {
      "title": "Lag Hr",
      "type": "number"
    },
    "reaches": {
      "items": {
        "$ref": "#/$defs/ReachRouting"
      },
      "title": "Reaches",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
