{
  "$defs": {
    "SeasonalMonthCell": {
      "additionalProperties": false,
      "description": "One month of the seasonal climograph: the climate drivers + the low-flow screen.\n\n``net_atmospheric_mm_day`` (ET0 - precip) is the field scalar the FieldLayer ramps; a positive\nvalue is a growing-season deficit (ET exceeds precipitation, so no rainfall buffer).\n``multiple`` is the draw read against ``low_flow_cfs`` (the cited seasonal floor — 30Q10 summer\nin the growing season, else the annual 7Q10); it rests on the *modeled* buildout draw, so the\nfrontend renders it ``[inference]``, never a measured withdrawal.",
      "properties": {
        "month": {
          "title": "Month",
          "type": "string"
        },
        "growing_season": {
          "title": "Growing Season",
          "type": "boolean"
        },
        "et0_mm_day": {
          "title": "Et0 Mm Day",
          "type": "number"
        },
        "precip_mm_day": {
          "title": "Precip Mm Day",
          "type": "number"
        },
        "net_atmospheric_mm_day": {
          "title": "Net Atmospheric Mm Day",
          "type": "number"
        },
        "low_flow_cfs": {
          "title": "Low Flow Cfs",
          "type": "number"
        },
        "low_flow_basis": {
          "title": "Low Flow Basis",
          "type": "string"
        },
        "consumptive_cfs": {
          "title": "Consumptive Cfs",
          "type": "number"
        },
        "multiple": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Multiple"
        }
      },
      "required": [
        "month",
        "growing_season",
        "et0_mm_day",
        "precip_mm_day",
        "net_atmospheric_mm_day",
        "low_flow_cfs",
        "low_flow_basis",
        "consumptive_cfs",
        "multiple"
      ],
      "title": "SeasonalMonthCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The seasonal evaporation / net-atmospheric-withdrawal climograph — the #1236 deliverable.\n\nA month-axis climograph the deck.gl FieldLayer renders as a cartesian strip (epic #1237, Phase\n2). The field scalar is net atmospheric withdrawal (reference ET0 - precip, mm/day): a one-hue\nbone->forest->ink ramp, with the deficit boundary (net=0) as the threshold isopleth — the\ngrowing-season edge, where ET starts to exceed precipitation. ``provenance`` is fixed to\n``reference``: the climograph is the cited NASA POWER normals + FAO-56 ET0. The per-month\n``multiple`` overlays the *modeled* buildout consumptive draw against the cited seasonal low\nflow, so that read is ``[inference]`` — surfaced in the SSR table/probe, never baked into the\nmm/day raster scalar. ``available`` is False (empty ``months``) when the climate/ET inputs or\nthe buildout scenario are absent — the thresholds still resolve, nothing is fabricated.",
  "properties": {
    "site": {
      "title": "Site",
      "type": "string"
    },
    "scenario": {
      "title": "Scenario",
      "type": "string"
    },
    "cooling_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cooling Model"
    },
    "unit": {
      "default": "mm/day",
      "title": "Unit",
      "type": "string"
    },
    "provenance": {
      "const": "reference",
      "default": "reference",
      "title": "Provenance",
      "type": "string"
    },
    "available": {
      "default": false,
      "title": "Available",
      "type": "boolean"
    },
    "consumptive_cfs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumptive Cfs"
    },
    "annual_7q10_cfs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annual 7Q10 Cfs"
    },
    "summer_30q10_cfs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summer 30Q10 Cfs"
    },
    "one_q10_cfs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "One Q10 Cfs"
    },
    "annual_multiple": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annual Multiple"
    },
    "summer_multiple": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summer Multiple"
    },
    "growing_season_months": {
      "items": {
        "type": "string"
      },
      "title": "Growing Season Months",
      "type": "array"
    },
    "months": {
      "items": {
        "$ref": "#/$defs/SeasonalMonthCell"
      },
      "title": "Months",
      "type": "array"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "site",
    "scenario"
  ],
  "title": "SeasonalField",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
