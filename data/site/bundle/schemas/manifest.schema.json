{
  "$defs": {
    "DomainReadiness": {
      "additionalProperties": false,
      "description": "Per-domain activation state (#1220): each of the five domains is ``absent|seeded|live``.\n\nComputed at export from feed counts + the ``SiteProfile`` by :mod:`watermark.site.readiness`\n(the SSOT for the predicates); this is only the wire shape. The ``State``/``Domain``\nvocabulary lives there so the schema and the computation can never drift.",
      "properties": {
        "backdrop": {
          "enum": [
            "absent",
            "seeded",
            "live"
          ],
          "title": "Backdrop",
          "type": "string"
        },
        "facility": {
          "enum": [
            "absent",
            "seeded",
            "live"
          ],
          "title": "Facility",
          "type": "string"
        },
        "places": {
          "enum": [
            "absent",
            "seeded",
            "live"
          ],
          "title": "Places",
          "type": "string"
        },
        "record": {
          "enum": [
            "absent",
            "seeded",
            "live"
          ],
          "title": "Record",
          "type": "string"
        },
        "story": {
          "enum": [
            "absent",
            "seeded",
            "live"
          ],
          "title": "Story",
          "type": "string"
        }
      },
      "required": [
        "backdrop",
        "facility",
        "places",
        "record",
        "story"
      ],
      "title": "DomainReadiness",
      "type": "object"
    },
    "FeedRef": {
      "additionalProperties": false,
      "description": "One entry in the manifest's feed index — what it is and how to read it.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "schema": {
          "title": "Schema",
          "type": "string"
        },
        "kind": {
          "enum": [
            "collection",
            "object",
            "geojson"
          ],
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "path",
        "media_type",
        "schema",
        "kind",
        "count"
      ],
      "title": "FeedRef",
      "type": "object"
    },
    "SiteReadiness": {
      "additionalProperties": false,
      "description": "The manifest's standing **readiness** block (#1220 / #1222): the per-domain states plus\nthe tier :func:`watermark.site.readiness.site_tier` derives from them.\n\nRecomputed at every ``watermark export``, so it rises when a source lands and falls when one\ndries up — a standing property, not an onboard-time snapshot. The frontend\n(``web/src/lib/readiness.ts``) reads this instead of re-deriving section gating from raw\nfeed counts (#1223).",
      "properties": {
        "tier": {
          "enum": [
            "stub",
            "backdrop",
            "case",
            "reference"
          ],
          "title": "Tier",
          "type": "string"
        },
        "domains": {
          "$ref": "#/$defs/DomainReadiness"
        }
      },
      "required": [
        "tier",
        "domains"
      ],
      "title": "SiteReadiness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The bundle index: version, provenance of the generation, and the feed list.",
  "properties": {
    "site": {
      "title": "Site",
      "type": "string"
    },
    "bundle_version": {
      "title": "Bundle Version",
      "type": "string"
    },
    "contract_version": {
      "title": "Contract Version",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "feed_count": {
      "title": "Feed Count",
      "type": "integer"
    },
    "row_total": {
      "title": "Row Total",
      "type": "integer"
    },
    "readiness": {
      "$ref": "#/$defs/SiteReadiness"
    },
    "feeds": {
      "items": {
        "$ref": "#/$defs/FeedRef"
      },
      "title": "Feeds",
      "type": "array"
    }
  },
  "required": [
    "site",
    "bundle_version",
    "contract_version",
    "generated_at",
    "feed_count",
    "row_total",
    "readiness"
  ],
  "title": "Manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
