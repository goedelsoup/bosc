        "life_stage",
        "metric",
        "limit_c",
        "exceeded"
      ],
      "title": "RisThresholdCheck",
      "type": "object"
    },
    "ThermalCalibration": {
      "additionalProperties": false,
      "description": "The derived-vs-observed cross-check the phase exists to produce (#1718).\n\nReads a modelled facility's derived effluent temperature against the corridor's own observed\nindustrial effluent (the nearest available analog — the campus holds no discharge permit, so\nthere is nothing of its own to read against) and records the design ambient against the\nreach's observed in-stream temperature. ``verdict`` is about the MODEL, not the facility:\n``conservative`` means the screen runs hotter than the record, which is the defensible\ndirection; ``understated`` would mean the record is hotter than the screen and the screen\nneeds revisiting.",
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "modeled_effluent_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modeled Effluent C"
        },
        "observed_effluent_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Effluent C"
        },
        "observed_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Source"
        },
        "delta_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta C"
        },
        "verdict": {
          "default": "unvalidated",
          "title": "Verdict",
          "type": "string"
        },
        "design_ambient_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Design Ambient C"
        },
        "observed_instream_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Instream C"
        },
        "ambient_delta_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambient Delta C"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "basis"
      ],
      "title": "ThermalCalibration",
      "type": "object"
    },
