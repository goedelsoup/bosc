{
  "$defs": {
    "AiByTask": {
      "additionalProperties": false,
      "description": "AI inference volume split by task type (the donut panel), in calls.",
      "properties": {
        "unit": {
          "default": "calls",
          "title": "Unit",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/NamedQuantity"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "tasks"
      ],
      "title": "AiByTask",
      "type": "object"
    },
    "ComputeByFunction": {
      "additionalProperties": false,
      "description": "Compute split by platform function (the ranked-bar panel), in vCPU-hours.",
      "properties": {
        "unit": {
          "default": "vCPU-hrs",
          "title": "Unit",
          "type": "string"
        },
        "functions": {
          "items": {
            "$ref": "#/$defs/NamedQuantity"
          },
          "title": "Functions",
          "type": "array"
        }
      },
      "required": [
        "functions"
      ],
      "title": "ComputeByFunction",
      "type": "object"
    },
    "ElectricitySeries": {
      "additionalProperties": false,
      "description": "Monthly electricity draw (the line panel) plus the grid/renewable source mix.",
      "properties": {
        "unit": {
          "default": "MWh",
          "title": "Unit",
          "type": "string"
        },
        "monthly": {
          "items": {
            "$ref": "#/$defs/NamedQuantity"
          },
          "title": "Monthly",
          "type": "array"
        },
        "grid": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "renewable": {
          "$ref": "#/$defs/ProvenancedValue"
        }
      },
      "required": [
        "monthly",
        "grid",
        "renewable"
      ],
      "title": "ElectricitySeries",
      "type": "object"
    },
    "GreenopsPeriod": {
      "additionalProperties": false,
      "description": "The reporting window a report covers (the usage report is trailing-12-months).",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        },
        "kind": {
          "default": "trailing_12_months",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "label",
        "start",
        "end"
      ],
      "title": "GreenopsPeriod",
      "type": "object"
    },
    "HeadlineFigure": {
      "additionalProperties": false,
      "description": "One of the four report headline stats (compute / AI inferences / electricity / water).\n\n``value`` carries the number, its native unit, and its provenance; ``sub`` and\n``source_label`` are the display strings the FigureStat card renders (the split of\nwhat makes up the figure, and the human name of where it came from).",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "sub": {
          "title": "Sub",
          "type": "string"
        },
        "source_label": {
          "title": "Source Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "sub",
        "source_label"
      ],
      "title": "HeadlineFigure",
      "type": "object"
    },
    "MethodologyItem": {
      "additionalProperties": false,
      "description": "One derivation note (title + prose) under the methodology block.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "title": "MethodologyItem",
      "type": "object"
    },
    "NamedQuantity": {
      "additionalProperties": false,
      "description": "A labeled provenanced quantity — one bar / slice / month in a breakdown series.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ProvenancedValue"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "NamedQuantity",
      "type": "object"
    },
    "ProvenancedValue": {
      "additionalProperties": false,
      "description": "A single numeric quantity tagged with its provenance.\n\nConstruct via the classmethods (:meth:`from_document`, :meth:`from_connector`,\n:meth:`assume`, :meth:`derived`) so the ``source`` tag is never forgotten.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "enum": [
            "document",
            "connector",
            "reference",
            "assumption",
            "derived"
          ],
          "title": "Source",
          "type": "string"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "asof": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asof"
        }
      },
      "required": [
        "value",
        "unit",
        "source"
      ],
      "title": "ProvenancedValue",
      "type": "object"
    },
    "WaterDraw": {
      "additionalProperties": false,
      "description": "Water draw split direct/indirect (the stacked bar) against the internal budget cap.",
      "properties": {
        "unit": {
          "default": "gal",
          "title": "Unit",
          "type": "string"
        },
        "direct": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "indirect": {
          "$ref": "#/$defs/ProvenancedValue"
        },
        "budget_cap": {
          "$ref": "#/$defs/ProvenancedValue"
        }
      },
      "required": [
        "direct",
        "indirect",
        "budget_cap"
      ],
      "title": "WaterDraw",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The assembled compute-footprint report the sustainability page reads.\n\nEvery numeric is a :class:`ProvenancedValue` carrying its ``source_kind``. A source\nthat is not yet wired ships a modeled ``assumption`` placeholder (see\n:func:`watermark.greenops.footprint.placeholder_report`) so the page degrades\ngracefully rather than 500-ing or faking a ``connector`` value.",
  "properties": {
    "period": {
      "$ref": "#/$defs/GreenopsPeriod"
    },
    "headline": {
      "items": {
        "$ref": "#/$defs/HeadlineFigure"
      },
      "title": "Headline",
      "type": "array"
    },
    "compute_by_function": {
      "$ref": "#/$defs/ComputeByFunction"
    },
    "ai_by_task": {
      "$ref": "#/$defs/AiByTask"
    },
    "electricity": {
      "$ref": "#/$defs/ElectricitySeries"
    },
    "water": {
      "$ref": "#/$defs/WaterDraw"
    },
    "methodology": {
      "items": {
        "$ref": "#/$defs/MethodologyItem"
      },
      "title": "Methodology",
      "type": "array"
    },
    "sources": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "period",
    "headline",
    "compute_by_function",
    "ai_by_task",
    "electricity",
    "water",
    "methodology"
  ],
  "title": "GreenopsReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
